{%- comment -%}
  Subscription Prompt — modal shown before adding a one-time purchase.
  Dynamic values (nights, savings) injected by assets/sub-prompt.js.
{%- endcomment -%}

<div id="ns-sub-prompt" class="ns-overlay" style="display:none" role="dialog" aria-label="Subscribe and save" aria-modal="true">
  <div class="ns-overlay-bg" data-sub-close></div>

  <div class="ns-sub-prompt__modal">
    {%- comment -%} Close button {%- endcomment -%}
    <button class="ns-sub-prompt__close" data-sub-close aria-label="Close" type="button">&times;</button>

    {%- comment -%} Content {%- endcomment -%}
    <div class="ns-sub-prompt__content">
      <p class="ns-sub-prompt__kicker">BEFORE YOU ADD</p>

      <h2 class="ns-sub-prompt__heading">
        Same tape. Same <span id="ns-sub-nights" class="ns-sub-prompt__val"></span> nights.
        <span class="ns-sub-prompt__savings-text"><span id="ns-sub-savings" class="ns-sub-prompt__savings-val"></span> less.</span>
      </h2>

      <p class="ns-sub-prompt__desc">Subscribe &amp; Save takes 20% off this order, and every refill after it:</p>

      <ul class="ns-sub-prompt__benefits">
        <li class="ns-sub-prompt__benefit">
          <span class="ns-sub-prompt__check">&#10003;</span>
          <span>20% off every order, automatically</span>
        </li>
        <li class="ns-sub-prompt__benefit">
          <span class="ns-sub-prompt__check">&#10003;</span>
          <span>Free shipping, always</span>
        </li>
        <li class="ns-sub-prompt__benefit">
          <span class="ns-sub-prompt__check">&#10003;</span>
          <span>Skip, pause, or cancel anytime</span>
        </li>
      </ul>

      <button class="ns-sub-prompt__subscribe-btn" id="ns-sub-subscribe-btn" type="button">Subscribe &amp; Save</button>

      <button class="ns-sub-prompt__onetime-btn" id="ns-sub-onetime-btn" type="button">Continue with one-time purchase</button>
    </div>
  </div>
</div>

<style>
  .ns-sub-prompt__modal {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(420px, calc(100% - 32px));
    background: #FFFFFF;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 40px 100px rgba(16,24,43,.4);
    animation: ns-fadeup .35s ease;
  }

  .ns-sub-prompt__close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: rgba(16,24,43,.06);
    color: var(--navy);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: background .15s;
  }
  .ns-sub-prompt__close:hover {
    background: rgba(16,24,43,.12);
  }

  .ns-sub-prompt__content {
    padding: clamp(28px,5vw,40px) clamp(24px,5vw,36px);
    text-align: center;
  }

  .ns-sub-prompt__kicker {
    font-size: 11.5px;
    letter-spacing: .24em;
    font-weight: 800;
    color: var(--amber);
    margin: 0 0 14px;
  }

  .ns-sub-prompt__heading {
    font-size: clamp(22px,4vw,28px);
    font-weight: 800;
    letter-spacing: -.01em;
    margin: 0 0 14px;
    line-height: 1.25;
    color: var(--navy);
  }

  .ns-sub-prompt__val {
    /* Populated by JS */
  }

  .ns-sub-prompt__savings-text {
    white-space: nowrap;
  }

  .ns-sub-prompt__savings-val {
    color: var(--amber);
    font-weight: 800;
  }

  .ns-sub-prompt__desc {
    font-size: 14px;
    color: var(--text-secondary);
    margin: 0 0 20px;
    line-height: 1.5;
  }

  .ns-sub-prompt__benefits {
    list-style: none;
    padding: 0;
    margin: 0 0 24px;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ns-sub-prompt__benefit {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    font-weight: 500;
    color: var(--navy);
  }

  .ns-sub-prompt__check {
    color: #22C55E;
    font-size: 15px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .ns-sub-prompt__subscribe-btn {
    display: block;
    width: 100%;
    background: var(--navy);
    color: #F7F8FA;
    padding: 15px;
    border: none;
    border-radius: 999px;
    font-size: 15.5px;
    font-weight: 700;
    cursor: pointer;
    font-family: var(--font-primary);
    margin-bottom: 12px;
    transition: background .15s;
  }
  .ns-sub-prompt__subscribe-btn:hover {
    background: #26314D;
  }

  .ns-sub-prompt__onetime-btn {
    background: none;
    border: none;
    font-size: 14px;
    color: var(--text-secondary);
    text-decoration: underline;
    cursor: pointer;
    font-family: var(--font-primary);
    padding: 4px 0;
    transition: color .15s;
  }
  .ns-sub-prompt__onetime-btn:hover {
    color: var(--navy);
  }
</style>
