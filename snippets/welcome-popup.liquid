{%- comment -%}
  Welcome Popup — full-page email capture with promo code reveal.
  Interaction logic handled by assets/welcome-popup.js (unchanged hooks:
  #ns-welcome-popup, #ns-welcome-form, #ns-welcome-success,
  #ns-welcome-code-box, #ns-welcome-copy-btn, [data-welcome-close]).
{%- endcomment -%}

<div id="ns-welcome-popup" class="ns-overlay" style="display:none" role="dialog" aria-label="Welcome offer" aria-modal="true">
  <div class="ns-welcome__page">
    <button class="ns-welcome__close" data-welcome-close aria-label="Close" type="button">&times;</button>

    <div class="ns-welcome__content">
      <p class="ns-welcome__kicker">WELCOME TO NIGHTSEALS</p>
      <h2 class="ns-welcome__heading">
        Unlock your <span class="ns-amber-highlight">welcome offer</span>
      </h2>
      <p class="ns-welcome__subtitle">Join thousands of better-rested sleepers.</p>

      {%- comment -%} Email form {%- endcomment -%}
      <form class="ns-welcome__form" id="ns-welcome-form">
        <div class="ns-welcome__form-row">
          <input
            type="email"
            class="ns-welcome__input"
            placeholder="Enter your email"
            required
            autocomplete="email"
            aria-label="Email address"
          >
          <button type="submit" class="ns-welcome__submit-btn">Claim</button>
        </div>
        <p class="ns-welcome__privacy">No spam. Unsubscribe anytime. By signing up you agree to our <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">privacy policy</a>.</p>
      </form>

      {%- comment -%} Success state {%- endcomment -%}
      <div id="ns-welcome-success" style="display:none" class="ns-welcome__success">
        <p class="ns-welcome__success-label">You're in! Here's your code:</p>
        <div class="ns-welcome__code-box" id="ns-welcome-code-box">
          <span class="ns-welcome__code">{{ settings.welcome_promo_code | default: 'SEAL10' }}</span>
        </div>
        <button class="ns-welcome__copy-btn" id="ns-welcome-copy-btn" type="button">Click to copy</button>
        <p class="ns-welcome__success-note">Already saved for you &mdash; 10% comes off at checkout.</p>
        <a href="{% render 'shop-url' %}" class="ns-welcome__shop-btn">Start shopping</a>
      </div>
    </div>
  </div>
</div>

<style>
  /* Full-page overlay panel (replaces the centered modal card). */
  .ns-welcome__page {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background: var(--navy);
    color: #F2F4F7;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(40px, 8vw, 72px) clamp(20px, 6vw, 32px);
    overflow-y: auto;
    animation: ns-welcome-in .3s ease;
  }

  @keyframes ns-welcome-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  .ns-welcome__close {
    position: fixed;
    top: clamp(16px, 3vw, 24px);
    right: clamp(16px, 3vw, 24px);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: none;
    background: rgba(242,244,247,.14);
    color: #F2F4F7;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: background .15s;
  }
  .ns-welcome__close:hover { background: rgba(242,244,247,.26); }

  .ns-welcome__content {
    width: min(520px, 100%);
    text-align: center;
  }

  .ns-welcome__kicker {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: .18em;
    color: var(--amber);
    margin: 0 0 14px;
  }

  .ns-welcome__heading {
    font-size: clamp(30px, 7vw, 46px);
    font-weight: 800;
    letter-spacing: -.02em;
    margin: 0 0 12px;
    line-height: 1.1;
  }

  .ns-welcome__subtitle {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(15px, 2.6vw, 18px);
    color: rgba(242,244,247,.6);
    max-width: 36ch;
    margin: 0 auto clamp(28px, 5vw, 38px);
    line-height: 1.5;
  }

  .ns-welcome__form-row {
    display: flex;
    gap: 10px;
    max-width: 440px;
    margin: 0 auto;
  }

  .ns-welcome__input {
    flex: 1;
    min-width: 0;
    background: #FFFFFF;
    border: 1px solid transparent;
    border-radius: 12px;
    padding: 16px 18px;
    font-size: 15px;
    font-family: var(--font-primary);
    color: var(--navy);
    outline: none;
    transition: box-shadow .15s;
  }
  .ns-welcome__input::placeholder { color: var(--text-muted); }
  .ns-welcome__input:focus { box-shadow: 0 0 0 3px rgba(217,160,75,.4); }

  .ns-welcome__submit-btn {
    background: var(--amber);
    color: var(--navy);
    border: none;
    border-radius: 12px;
    padding: 16px 26px;
    font-size: 15px;
    font-weight: 700;
    font-family: var(--font-primary);
    cursor: pointer;
    white-space: nowrap;
    transition: background .15s;
  }
  .ns-welcome__submit-btn:hover { background: var(--amber-hover); }

  .ns-welcome__privacy {
    font-size: 12.5px;
    color: rgba(242,244,247,.5);
    margin: 14px 0 0;
    text-align: center;
  }
  .ns-welcome__privacy a { color: rgba(242,244,247,.7); }

  /* Success state (on the navy full page) */
  .ns-welcome__success { text-align: center; }

  .ns-welcome__success-label {
    font-size: 16px;
    font-weight: 600;
    color: #F2F4F7;
    margin: 0 0 16px;
  }

  .ns-welcome__code-box {
    border: 2px dashed rgba(242,244,247,.3);
    border-radius: 14px;
    padding: 18px 24px;
    margin: 0 auto 8px;
    max-width: 320px;
    cursor: pointer;
  }

  .ns-welcome__code {
    font-size: 30px;
    font-weight: 800;
    letter-spacing: .14em;
    color: var(--amber);
  }

  .ns-welcome__copy-btn {
    background: none;
    border: none;
    font-size: 13px;
    color: var(--amber);
    font-weight: 600;
    cursor: pointer;
    font-family: var(--font-primary);
    padding: 4px 0;
    margin-bottom: 14px;
  }
  .ns-welcome__copy-btn:hover { color: var(--amber-hover); }

  .ns-welcome__success-note {
    font-size: 13.5px;
    color: rgba(242,244,247,.6);
    margin: 0 0 20px;
  }

  .ns-welcome__shop-btn {
    display: inline-block;
    background: var(--amber);
    color: var(--navy);
    padding: 15px 32px;
    border-radius: 999px;
    font-size: 15.5px;
    font-weight: 700;
    text-decoration: none;
    transition: background .15s;
  }
  .ns-welcome__shop-btn:hover { background: var(--amber-hover); }
</style>
