{%- comment -%}
  Cart Drawer — AJAX slide-out cart.
  Static HTML shell; dynamic content rendered by assets/cart-drawer.js.
{%- endcomment -%}

{%- comment -%} Supply tiers for the upsell (main product) — read by cart-drawer.js {%- endcomment -%}
{%- liquid
  assign up_product = settings.featured_product
  if up_product == blank
    assign up_product = collections.all.products.first
  endif
-%}
{%- if up_product and up_product.variants.size > 1 -%}
  <script type="application/json" id="ns-cart-tier-data">[
    {%- for variant in up_product.variants -%}
      {%- assign nights_count = variant.title | split: ' ' | first | plus: 0 -%}
      {%- assign per_night_cents = 0 -%}
      {%- if nights_count > 0 -%}{%- assign per_night_cents = variant.price | times: 1.0 | divided_by: nights_count | round -%}{%- endif -%}
      {"id":{{ variant.id }},"title":{{ variant.title | json }},"price":{{ variant.price }},"nights":{{ nights_count }},"perNight":{{ per_night_cents }}}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]</script>
{%- endif -%}

<div id="ns-cart-drawer" class="ns-overlay" style="display:none" role="dialog" aria-label="Shopping cart" aria-modal="true">
  {%- comment -%} Backdrop {%- endcomment -%}
  <div class="ns-overlay-bg" data-cart-close></div>

  {%- comment -%} Drawer panel {%- endcomment -%}
  <div class="ns-cart-drawer__panel">
    {%- comment -%} Header {%- endcomment -%}
    <div class="ns-cart-drawer__header">
      <div class="ns-cart-drawer__title-row">
        <h2 class="ns-cart-drawer__title">Your cart</h2>
        <span class="ns-cart-drawer__count" id="ns-cart-count"></span>
      </div>
      <button class="ns-cart-drawer__close" data-cart-close aria-label="Close cart" type="button">&times;</button>
    </div>

    {%- comment -%} Body — filled by JS {%- endcomment -%}
    <div class="ns-cart-drawer__body" id="ns-cart-body">
      {%- comment -%} Shipping progress bar {%- endcomment -%}
      <div class="ns-cart-drawer__shipping" id="ns-cart-shipping"></div>

      {%- comment -%} Line items {%- endcomment -%}
      <div class="ns-cart-drawer__items" id="ns-cart-items"></div>

      {%- comment -%} Upsell card {%- endcomment -%}
      <div class="ns-cart-drawer__upsell" id="ns-cart-upsell"></div>
    </div>

    {%- comment -%} Footer {%- endcomment -%}
    <div class="ns-cart-drawer__footer" id="ns-cart-footer">
      {%- comment -%} Promo code — sets Shopify's discount cookie for checkout {%- endcomment -%}
      <form class="ns-promo" data-promo-form>
        <button type="button" class="ns-promo__toggle" data-promo-toggle aria-expanded="false">Have a promo code?</button>
        <div class="ns-promo__fields" data-promo-fields hidden>
          <input type="text" class="ns-promo__input" name="discount" placeholder="Promo code" autocomplete="off" autocapitalize="characters" spellcheck="false" aria-label="Promo code">
          <button type="submit" class="ns-promo__apply">Apply</button>
        </div>
        <p class="ns-promo__msg" data-promo-msg hidden></p>
      </form>

      <div class="ns-cart-drawer__subtotal-row">
        <span class="ns-cart-drawer__subtotal-label">Subtotal</span>
        <span class="ns-cart-drawer__subtotal-value" id="ns-cart-subtotal"></span>
      </div>
      <a href="/checkout" class="ns-cart-drawer__checkout-btn" id="ns-cart-checkout-btn">Checkout</a>
      <p class="ns-cart-drawer__guarantee">30-day money-back guarantee</p>
    </div>

    {%- comment -%} Empty state {%- endcomment -%}
    <div class="ns-cart-drawer__empty" id="ns-cart-empty" style="display:none">
      <div class="ns-cart-drawer__empty-icon">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5.5 8h13l-1.2 12H6.7L5.5 8z"/>
          <path d="M9 8V6.5a3 3 0 0 1 6 0V8"/>
        </svg>
      </div>
      <h3 class="ns-cart-drawer__empty-title">Your cart is empty</h3>
      <p class="ns-cart-drawer__empty-subtitle">Better sleep is three seconds a night away.</p>
      <a href="{% render 'shop-url' %}" class="ns-cart-drawer__empty-btn ns-btn-primary">Shop mouth tape</a>
    </div>
  </div>
</div>

<style>
  .ns-cart-drawer__panel {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: min(460px, 100%);
    background: #F7F8FA;
    box-shadow: -24px 0 60px rgba(16,24,43,.25);
    animation: ns-slidein .3s ease;
    display: flex;
    flex-direction: column;
  }

  /* Header */
  .ns-cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid rgba(16,24,43,.08);
  }

  .ns-cart-drawer__title-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ns-cart-drawer__title {
    font-size: 17px;
    font-weight: 800;
    margin: 0;
  }

  .ns-cart-drawer__count {
    font-size: 12px;
    font-weight: 700;
    background: var(--amber);
    color: var(--navy);
    padding: 2px 8px;
    border-radius: 999px;
  }

  .ns-cart-drawer__close {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    border: none;
    background: rgba(16,24,43,.05);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    color: var(--navy);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background .15s;
  }
  .ns-cart-drawer__close:hover {
    background: rgba(16,24,43,.1);
  }

  /* Body */
  .ns-cart-drawer__body {
    flex: 1;
    overflow-y: auto;
    padding: 22px 20px;
  }

  /* Shipping progress */
  .ns-cart-drawer__shipping {
    margin-bottom: 20px;
  }

  .ns-cart-shipping__bar {
    height: 6px;
    background: rgba(16,24,43,.08);
    border-radius: 3px;
    overflow: hidden;
    margin-top: 8px;
  }

  .ns-cart-shipping__fill {
    height: 100%;
    background: var(--amber);
    border-radius: 3px;
    transition: width .3s ease;
  }

  .ns-cart-shipping__text {
    font-size: 13px;
    font-weight: 600;
    color: var(--navy);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .ns-cart-shipping__check {
    color: #22C55E;
    font-size: 16px;
  }

  /* Line items */
  .ns-cart-drawer__items {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ns-cart-item {
    display: flex;
    gap: 14px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(16,24,43,.06);
  }

  .ns-cart-item__img {
    width: 84px;
    height: 84px;
    border-radius: var(--radius-md);
    object-fit: cover;
    background: var(--light-gray);
  }

  .ns-cart-item__info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ns-cart-item__title {
    font-size: 14px;
    font-weight: 700;
  }

  .ns-cart-item__variant {
    font-size: 12px;
    color: var(--text-secondary);
  }

  .ns-cart-item__price-row {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 700;
  }

  .ns-cart-item__compare-price {
    text-decoration: line-through;
    color: var(--text-muted);
    font-weight: 400;
  }

  .ns-cart-item__savings {
    font-size: 11px;
    font-weight: 700;
    background: rgba(217,160,75,.15);
    color: var(--dark-amber);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .ns-cart-item__qty {
    display: flex;
    align-items: center;
    gap: 0;
    margin-top: 4px;
  }

  .ns-cart-item__qty-btn {
    width: 32px;
    height: 32px;
    border: 1px solid rgba(16,24,43,.12);
    background: #fff;
    font-size: 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--navy);
  }
  .ns-cart-item__qty-btn:first-child { border-radius: 8px 0 0 8px; }
  .ns-cart-item__qty-btn:last-child { border-radius: 0 8px 8px 0; }

  .ns-cart-item__qty-val {
    width: 36px;
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    border-top: 1px solid rgba(16,24,43,.12);
    border-bottom: 1px solid rgba(16,24,43,.12);
    height: 32px;
    line-height: 32px;
    background: #fff;
  }

  .ns-cart-item__remove {
    font-size: 12px;
    color: var(--text-muted);
    background: none;
    border: none;
    cursor: pointer;
    padding: 2px 0;
    margin-top: 2px;
    text-decoration: underline;
  }
  .ns-cart-item__remove:hover {
    color: var(--navy);
  }

  /* Upsell card (shared: drawer + cart page) */
  .ns-cart-drawer__upsell:not(:empty) {
    margin-top: 18px;
  }

  .ns-cart-upsell__card {
    background: linear-gradient(135deg, rgba(217,160,75,.14), rgba(217,160,75,.05));
    border: 1px solid rgba(217,160,75,.35);
    border-radius: var(--radius-md);
    padding: 13px 15px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .ns-cart-upsell__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .ns-cart-upsell__eyebrow {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--dark-amber);
  }

  .ns-cart-upsell__label {
    font-size: 14px;
    font-weight: 800;
    color: var(--navy);
  }

  .ns-cart-upsell__sub {
    font-size: 12px;
    color: var(--text-secondary);
  }

  .ns-cart-upsell__btn {
    background: var(--amber);
    color: var(--navy);
    border: none;
    border-radius: 999px;
    padding: 9px 18px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    font-family: var(--font-primary);
    transition: background .15s;
  }
  .ns-cart-upsell__btn:hover {
    background: var(--amber-hover);
  }
  .ns-cart-upsell__btn:disabled {
    opacity: .6;
    cursor: default;
  }

  /* Promo code field (shared: drawer + cart page) */
  .ns-promo {
    margin: 0 0 14px;
  }
  .ns-promo__toggle {
    background: none;
    border: none;
    padding: 2px 0;
    font-family: var(--font-primary);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ns-promo__toggle:hover { color: var(--navy); }
  .ns-promo__fields {
    display: flex;
    gap: 8px;
    margin-top: 10px;
  }
  .ns-promo__fields[hidden] { display: none; }
  .ns-promo__input {
    flex: 1;
    min-width: 0;
    border: 1px solid rgba(16,24,43,.15);
    border-radius: 10px;
    padding: 11px 14px;
    font-size: 14px;
    font-family: var(--font-primary);
    color: var(--navy);
    text-transform: uppercase;
    outline: none;
    transition: border-color .15s;
  }
  .ns-promo__input::placeholder { color: var(--text-muted); text-transform: none; }
  .ns-promo__input:focus { border-color: var(--navy); }
  .ns-promo__apply {
    background: var(--navy);
    color: #F7F8FA;
    border: none;
    border-radius: 10px;
    padding: 11px 18px;
    font-size: 13.5px;
    font-weight: 700;
    font-family: var(--font-primary);
    cursor: pointer;
    white-space: nowrap;
    transition: background .15s;
  }
  .ns-promo__apply:hover { background: #26314D; }
  .ns-promo__apply:disabled { opacity: .6; cursor: default; }
  .ns-promo__msg {
    font-size: 12.5px;
    margin: 8px 0 0;
    display: flex;
    align-items: center;
    gap: 6px;
    line-height: 1.4;
  }
  .ns-promo__msg[hidden] { display: none; }
  .ns-promo__msg.is-success { color: #1F9254; }
  .ns-promo__msg.is-error { color: #B4232A; }
  .ns-promo__check {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #1F9254;
    color: #fff;
    font-size: 10px;
    font-weight: 800;
  }

  /* Footer */
  .ns-cart-drawer__footer {
    border-top: 1px solid rgba(16,24,43,.08);
    padding: 16px 20px 20px;
  }

  .ns-cart-drawer__subtotal-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .ns-cart-drawer__subtotal-label {
    font-size: 15px;
    font-weight: 600;
  }

  .ns-cart-drawer__subtotal-value {
    font-size: 17px;
    font-weight: 800;
  }

  .ns-cart-drawer__checkout-btn {
    display: block;
    text-align: center;
    background: var(--navy);
    color: #F7F8FA;
    padding: 15px;
    border-radius: 999px;
    font-size: 15.5px;
    font-weight: 700;
    text-decoration: none;
    transition: background .15s;
  }
  .ns-cart-drawer__checkout-btn:hover {
    background: #26314D;
    color: #F7F8FA;
  }

  .ns-cart-drawer__guarantee {
    text-align: center;
    font-size: 12px;
    color: var(--text-muted);
    margin: 10px 0 8px;
  }

  .ns-cart-drawer__payment-icons {
    display: flex;
    justify-content: center;
    gap: 6px;
  }

  /* Empty state */
  .ns-cart-drawer__empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    text-align: center;
  }

  .ns-cart-drawer__empty-icon {
    width: 72px;
    height: 72px;
    background: rgba(16,24,43,.06);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    margin-bottom: 20px;
  }

  .ns-cart-drawer__empty-title {
    font-size: 18px;
    font-weight: 800;
    margin: 0 0 6px;
  }

  .ns-cart-drawer__empty-subtitle {
    font-size: 14px;
    color: var(--text-secondary);
    margin: 0 0 24px;
  }

  .ns-cart-drawer__empty-btn {
    text-decoration: none;
  }
</style>
