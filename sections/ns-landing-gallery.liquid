{%- comment -%}
  Landing page — 3-up image gallery row (product / on-face / lifestyle).
{%- endcomment -%}

<section class="ns-lgal">
  <div class="ns-lgal__grid">
    {%- assign ph = 'nightseals-pouch.png' -%}
    <div class="ns-lgal__cell">
      {%- if section.settings.image_1 != blank -%}
        {{ section.settings.image_1 | image_url: width: 700 | image_tag: loading: 'lazy', class: 'ns-lgal__img' }}
      {%- else -%}
        <img src="{{ ph | asset_url }}" alt="" class="ns-lgal__img" width="700" height="440" loading="lazy">
      {%- endif -%}
    </div>
    <div class="ns-lgal__cell">
      {%- if section.settings.image_2 != blank -%}
        {{ section.settings.image_2 | image_url: width: 700 | image_tag: loading: 'lazy', class: 'ns-lgal__img' }}
      {%- else -%}
        <div class="ns-lgal__ph">On-face: bearded man wearing tape</div>
      {%- endif -%}
    </div>
    <div class="ns-lgal__cell">
      {%- if section.settings.image_3 != blank -%}
        {{ section.settings.image_3 | image_url: width: 700 | image_tag: loading: 'lazy', class: 'ns-lgal__img' }}
      {%- else -%}
        <div class="ns-lgal__ph">Lifestyle: couple sleeping, peaceful</div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .ns-lgal { padding: 0 clamp(14px,4vw,32px) clamp(24px,4vw,36px); }
  .ns-lgal__grid {
    max-width: 1000px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%,280px),1fr));
    gap: clamp(8px,2vw,14px);
  }
  .ns-lgal__cell {
    height: min(220px,65vw);
    border-radius: 16px;
    overflow: hidden;
    background: #EAEDF2;
  }
  .ns-lgal__img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ns-lgal__ph {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center; text-align: center;
    padding: 12px; color: #8A93A3; font-size: 13px;
  }
</style>

{% schema %}
{
  "name": "Landing Gallery",
  "settings": [
    { "type": "image_picker", "id": "image_1", "label": "Image 1 (product)" },
    { "type": "image_picker", "id": "image_2", "label": "Image 2 (on-face)" },
    { "type": "image_picker", "id": "image_3", "label": "Image 3 (lifestyle)" }
  ],
  "presets": [
    { "name": "Landing Gallery" }
  ]
}
{% endschema %}
