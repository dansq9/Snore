{%- comment -%}
  ns-landing-materials — benefit-led "why it works" grid. (The #1 breathing
  objection that used to lead this section now lives in its own section,
  ns-landing-objection.) A problem->benefit grid (quieter nights / rested
  mornings / no dry mouth) with a single material-based card. Efficacy hedged
  for compliance.
{%- endcomment -%}
<style>
  .ns-lmat__mat-section {
    max-width: 860px;
    margin: 0 auto;
    padding: clamp(36px, 6vw, 64px) clamp(14px, 4vw, 32px) clamp(36px, 6vw, 64px);
  }

  .ns-lmat__mat-kicker {
    font-size: 11.5px;
    letter-spacing: .24em;
    font-weight: 800;
    color: #B27E33;
    margin-bottom: 14px;
  }

  .ns-lmat__mat-heading {
    font-size: clamp(24px, 4.5vw, 36px);
    letter-spacing: -.02em;
    font-weight: 800;
    margin: 0 0 8px;
    text-wrap: pretty;
  }

  .ns-lmat__mat-intro {
    font-size: 15px;
    line-height: 1.6;
    color: #566072;
    margin: 0 0 28px;
    max-width: 60ch;
    text-wrap: pretty;
  }

  .ns-lmat__mat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: clamp(14px, 3vw, 22px);
  }

  .ns-lmat__card {
    background: #FFFFFF;
    border: 1px solid rgba(16, 24, 43, .08);
    border-radius: 18px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 22px 44px -32px rgba(16, 24, 43, .4);
  }

  .ns-lmat__card-media {
    aspect-ratio: 4 / 3;
    background: #EAEDF2;
  }
  .ns-lmat__card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ns-lmat__card-ph {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 20px;
    color: #8A93A3;
    font-size: 13px;
    line-height: 1.5;
  }

  .ns-lmat__card-text {
    padding: clamp(18px, 3vw, 24px);
  }

  .ns-lmat__card-title {
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -.01em;
    color: #10182B;
    margin-bottom: 6px;
  }

  .ns-lmat__card-body {
    font-size: 14px;
    color: #566072;
    line-height: 1.55;
    text-wrap: pretty;
  }
</style>

<section class="ns-lmat__mat-section">
  <div class="ns-lmat__mat-kicker">{{ section.settings.mat_kicker | default: "WHY IT WORKS" }}</div>
  <h2 class="ns-lmat__mat-heading">{{ section.settings.mat_heading | default: "How one small strip changes the whole night" }}</h2>
  <p class="ns-lmat__mat-intro">{{ section.settings.mat_intro | default: "It isn't the tape doing the work. It's what happens the moment your mouth stays closed and every breath goes through your nose." }}</p>
  <div class="ns-lmat__mat-grid">
    <div class="ns-lmat__card">
      <div class="ns-lmat__card-media">
        {%- if section.settings.item_1_image != blank -%}
          {{ section.settings.item_1_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: section.settings.item_1_title }}
        {%- else -%}
          <div class="ns-lmat__card-ph">{{ section.settings.item_1_ph | default: 'Partner sleeping soundly, undisturbed' }}</div>
        {%- endif -%}
      </div>
      <div class="ns-lmat__card-text">
        <div class="ns-lmat__card-title">{{ section.settings.item_1_title | default: "Quieter nights" }}</div>
        <div class="ns-lmat__card-body">{{ section.settings.item_1_body | default: "Snoring is the sound of air fighting past an open mouth. Close it, breathe through your nose, and the racket settles, so the person beside you finally sleeps through." }}</div>
      </div>
    </div>
    <div class="ns-lmat__card">
      <div class="ns-lmat__card-media">
        {%- if section.settings.item_2_image != blank -%}
          {{ section.settings.item_2_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: section.settings.item_2_title }}
        {%- else -%}
          <div class="ns-lmat__card-ph">{{ section.settings.item_2_ph | default: 'Waking up rested and clear at sunrise' }}</div>
        {%- endif -%}
      </div>
      <div class="ns-lmat__card-text">
        <div class="ns-lmat__card-title">{{ section.settings.item_2_title | default: "Clear-headed mornings" }}</div>
        <div class="ns-lmat__card-body">{{ section.settings.item_2_body | default: "Nose breathing is slower, deeper and calmer than gasping through your mouth. Give your body a full night of it and you wake up sharp instead of foggy." }}</div>
      </div>
    </div>
    <div class="ns-lmat__card">
      <div class="ns-lmat__card-media">
        {%- if section.settings.item_3_image != blank -%}
          {{ section.settings.item_3_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: section.settings.item_3_title }}
        {%- else -%}
          <div class="ns-lmat__card-ph">{{ section.settings.item_3_ph | default: 'Untouched glass of water on the nightstand' }}</div>
        {%- endif -%}
      </div>
      <div class="ns-lmat__card-text">
        <div class="ns-lmat__card-title">{{ section.settings.item_3_title | default: "No more 3am dry mouth" }}</div>
        <div class="ns-lmat__card-body">{{ section.settings.item_3_body | default: "An open mouth dries out all night. Sealed and breathing through your nose, you skip the 2am water grab and the sandpaper throat, and wake up fresh." }}</div>
      </div>
    </div>
  </div>
</section>

