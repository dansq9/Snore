<style>
.ns-reset{max-width:460px;margin:0 auto;padding:clamp(40px,7vw,72px) clamp(16px,4vw,32px) clamp(64px,10vw,112px)}
.ns-reset__h1{font-size:clamp(28px,5vw,40px);font-weight:800;letter-spacing:-.02em;margin:0 0 8px;color:#10182B;text-align:center}
.ns-reset__sub{font-size:15px;color:#566072;text-align:center;margin:0 0 32px;line-height:1.6}
.ns-reset__field{margin-bottom:16px}
.ns-reset__label{display:block;font-size:13px;font-weight:700;color:#10182B;margin-bottom:8px}
.ns-reset__input{width:100%;padding:14px 18px;border:1px solid rgba(16,24,43,.15);border-radius:12px;font-size:15px;font-family:inherit;background:#fff;box-sizing:border-box}
.ns-reset__input:focus{outline:none;border-color:#B27E33}
.ns-reset__submit{width:100%;background:#10182B;color:#F7F8FA;padding:14px 28px;border-radius:999px;font-size:15px;font-weight:700;border:none;cursor:pointer;font-family:inherit;margin-top:8px}
.ns-reset__submit:hover{background:#26314D}
.ns-reset__errors{background:rgba(194,86,78,.08);border:1px solid rgba(194,86,78,.25);border-radius:12px;padding:12px 16px;margin-bottom:20px;font-size:14px;color:#C2564E}
.ns-reset__errors ul{margin:0;padding-left:18px}
</style>

<section class="ns-reset">
  <h1 class="ns-reset__h1">Reset your password</h1>
  <p class="ns-reset__sub">Enter a new password for your account.</p>

  {% form 'reset_customer_password' %}
    {% if form.errors %}
      <div class="ns-reset__errors">{{ form.errors | default_errors }}</div>
    {% endif %}
    <div class="ns-reset__field">
      <label class="ns-reset__label" for="ResetPassword">New password</label>
      <input type="password" name="customer[password]" id="ResetPassword" class="ns-reset__input" autocomplete="new-password">
    </div>
    <div class="ns-reset__field">
      <label class="ns-reset__label" for="ResetPasswordConfirm">Confirm password</label>
      <input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" class="ns-reset__input" autocomplete="new-password">
    </div>
    <button type="submit" class="ns-reset__submit">Reset password</button>
  {% endform %}
</section>

{% schema %}
{
  "name": "Customer Reset Password",
  "settings": []
}
{% endschema %}
