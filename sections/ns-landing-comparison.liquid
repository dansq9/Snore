<style>
  .ns-lcmp {
    background: #EAEDF2;
    padding: clamp(40px, 7vw, 88px) clamp(14px, 4vw, 32px);
  }

  .ns-lcmp__inner {
    max-width: 860px;
    margin: 0 auto;
  }

  .ns-lcmp__kicker {
    font-size: 11.5px;
    letter-spacing: .24em;
    font-weight: 800;
    color: #B27E33;
    margin-bottom: 14px;
  }

  .ns-lcmp__heading {
    font-size: clamp(24px, 4.5vw, 36px);
    letter-spacing: -.02em;
    font-weight: 800;
    margin: 0 0 28px;
  }

  .ns-lcmp__scroller {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }

  .ns-lcmp__table {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    font-size: clamp(12px, 1.8vw, 14px);
    background: #FFFFFF;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(16, 24, 43, .06);
    min-width: 300px;
  }

  .ns-lcmp__th-empty {
    padding: 16px 18px;
    font-weight: 700;
    color: #8A93A3;
  }

  .ns-lcmp__th-ns {
    padding: 16px 18px;
    text-align: center;
    font-weight: 800;
    background: #10182B;
    color: #F2F4F7;
    font-size: clamp(10px, 1.4vw, 12px);
    letter-spacing: .1em;
  }

  .ns-lcmp__th-generic {
    padding: 16px 18px;
    text-align: center;
    font-weight: 600;
    color: #8A93A3;
    font-size: clamp(10px, 1.4vw, 12px);
  }

  .ns-lcmp__feature {
    padding: 14px 18px;
    border-top: 1px solid rgba(16, 24, 43, .08);
    font-weight: 600;
    color: #10182B;
  }

  .ns-lcmp__yes {
    padding: 14px 18px;
    border-top: 1px solid rgba(16, 24, 43, .08);
    text-align: center;
    color: #B27E33;
    font-weight: 800;
  }

  .ns-lcmp__muted {
    padding: 14px 18px;
    border-top: 1px solid rgba(16, 24, 43, .08);
    text-align: center;
    color: #8A93A3;
  }

  .ns-lcmp__ns-cost {
    padding: 14px 18px;
    border-top: 1px solid rgba(16, 24, 43, .08);
    text-align: center;
    font-weight: 800;
    color: #10182B;
  }

  .ns-lcmp__cta-wrap {
    max-width: 860px;
    margin: 0 auto;
    padding: clamp(28px, 5vw, 56px) clamp(14px, 4vw, 32px);
    text-align: center;
  }

  .ns-lcmp__cta {
    display: inline-block;
    background: #10182B;
    color: #F2F4F7;
    padding: 15px 32px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 700;
  }

  .ns-lcmp__cta:hover {
    background: #26314D;
    color: #F2F4F7;
  }

  /* Mobile: tighten cell padding so all three columns (incl. the "Generic
     tape" column) fit the viewport instead of overflowing the scroller. */
  @media (max-width: 480px) {
    .ns-lcmp__th-empty,
    .ns-lcmp__th-ns,
    .ns-lcmp__th-generic { padding: 14px 8px; }

    .ns-lcmp__feature,
    .ns-lcmp__yes,
    .ns-lcmp__muted,
    .ns-lcmp__ns-cost { padding: 12px 8px; }
  }
</style>

<section class="ns-lcmp">
  <div class="ns-lcmp__inner">
    <div class="ns-lcmp__kicker">{{ section.settings.kicker | default: "WHY NIGHTSEALS" }}</div>
    <h2 class="ns-lcmp__heading">{{ section.settings.heading | default: "Not all mouth tape is built the same" }}</h2>
    <div class="ns-lcmp__scroller">
      <div class="ns-lcmp__table">
        <div class="ns-lcmp__th-empty"></div>
        <div class="ns-lcmp__th-ns">NIGHTSEALS</div>
        <div class="ns-lcmp__th-generic">Generic tape</div>

        <div class="ns-lcmp__feature">Stays on all night</div>
        <div class="ns-lcmp__yes">Yes</div>
        <div class="ns-lcmp__muted">Often peels off</div>

        <div class="ns-lcmp__feature">Beard-friendly</div>
        <div class="ns-lcmp__yes">Yes</div>
        <div class="ns-lcmp__muted">No</div>

        <div class="ns-lcmp__feature">No residue</div>
        <div class="ns-lcmp__yes">Yes</div>
        <div class="ns-lcmp__muted">Sticky residue</div>

        <div class="ns-lcmp__feature">Comfortable all night</div>
        <div class="ns-lcmp__yes">Yes</div>
        <div class="ns-lcmp__muted">Stiff plastic feel</div>

        <div class="ns-lcmp__feature">Hypoallergenic</div>
        <div class="ns-lcmp__yes">Yes</div>
        <div class="ns-lcmp__muted">Unknown materials</div>

        <div class="ns-lcmp__feature">Cost per night</div>
        <div class="ns-lcmp__ns-cost">from $0.56</div>
        <div class="ns-lcmp__muted">~$0.40</div>
      </div>
    </div>
  </div>
</section>

<div class="ns-lcmp__cta-wrap">
  <a href="#buy" class="ns-lcmp__cta">{{ section.settings.cta_label | default: "Try NightSeals risk-free" }}</a>
</div>

{% schema %}
{
  "name": "NS Landing Comparison",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "WHY NIGHTSEALS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Not all mouth tape is built the same"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Risk-free CTA label",
      "default": "Try NightSeals risk-free"
    }
  ],
  "presets": [
    {
      "name": "NS Landing Comparison"
    }
  ]
}
{% endschema %}
