<style>
  .ns-features {
    padding: clamp(52px, 9vw, 88px) 24px;
  }

  .ns-features__inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .ns-features__header {
    text-align: center;
    margin-bottom: clamp(28px, 5vw, 44px);
  }

  .ns-features__kicker {
    font-size: 11.5px;
    letter-spacing: 0.18em;
    font-weight: 800;
    text-transform: uppercase;
    color: #8A93A3;
    margin: 0 0 14px;
  }

  .ns-features__heading {
    font-size: clamp(28px, 5.5vw, 48px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: #10182B;
    margin: 0 0 14px;
  }

  .ns-features__media {
    width: 100%;
    height: clamp(220px, 56vw, 480px);
    background: #EAEDF2;
    border-radius: 20px;
    overflow: hidden;
    margin-bottom: clamp(28px, 5vw, 44px);
  }

  .ns-features__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ns-features__rail {
    display: flex;
    gap: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .ns-features__rail::-webkit-scrollbar {
    display: none;
  }

  .ns-features__card {
    flex: 0 0 auto;
    width: min(280px, 75vw);
    padding: 24px 24px 28px;
    border-top: 2px solid rgba(16, 24, 43, 0.12);
    scroll-snap-align: start;
  }

  .ns-features__icon {
    width: 40px;
    height: 40px;
    background: #EAEDF2;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .ns-features__card-title {
    font-size: 16px;
    font-weight: 700;
    color: #10182B;
    margin: 0 0 8px;
  }

  .ns-features__card-desc {
    font-size: 14px;
    line-height: 1.55;
    color: #566072;
    margin: 0;
  }
</style>

<section class="ns-features">
  <div class="ns-features__inner">
    <div class="ns-features__header">
      <p class="ns-features__kicker">WHY IT WORKS</p>
      <h2 class="ns-features__heading">What makes it different?</h2>
    </div>

    <div class="ns-features__media">
      {%- if section.settings.feature_image != blank -%}
        <img
          src="{{ section.settings.feature_image | image_url: width: 1100 }}"
          alt="{{ section.settings.feature_image.alt | escape }}"
          width="1100"
          height="{{ 1100 | divided_by: section.settings.feature_image.aspect_ratio | round }}"
          loading="lazy"
        >
      {%- endif -%}
    </div>

    <div class="ns-features__rail">
      {%- for block in section.blocks -%}
        <div class="ns-features__card" {{ block.shopify_attributes }}>
          <div class="ns-features__icon">
            {%- case block.settings.icon -%}
              {%- when 'grip' -%}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#10182B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 11V6a2 2 0 0 0-4 0v1"/><path d="M14 10V4a2 2 0 0 0-4 0v6"/><path d="M10 10V5a2 2 0 0 0-4 0v9a7 7 0 0 0 14 0v-4a2 2 0 0 0-4 0"/></svg>
              {%- when 'wind' -%}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#10182B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.7 7.7a2.5 2.5 0 1 1 1.8 4.3H2"/><path d="M9.6 4.6A2 2 0 1 1 11 8H2"/><path d="M12.6 19.4A2 2 0 1 0 14 16H2"/></svg>
              {%- when 'feather' -%}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#10182B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"/><line x1="16" y1="8" x2="2" y2="22"/><line x1="17.5" y1="15" x2="9" y2="15"/></svg>
              {%- when 'shield' -%}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#10182B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
            {%- endcase -%}
          </div>
          <p class="ns-features__card-title">{{ block.settings.title }}</p>
          <p class="ns-features__card-desc">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Features",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "feature_image",
      "label": "Feature image or video thumbnail"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "grip", "label": "Grip" },
            { "value": "wind", "label": "Wind" },
            { "value": "feather", "label": "Feather" },
            { "value": "shield", "label": "Shield" }
          ],
          "default": "grip"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "SteadyHold™ Adhesive",
            "description": "Grips through beards and side-sleeping, then peels off clean in the morning.",
            "icon": "grip"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "AirWeave™ Mesh",
            "description": "Breathable weave lets air pass through, so you never feel sealed in.",
            "icon": "wind"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Featherweight Feel",
            "description": "0.3 mm thin with rounded edges. By night three you’ll forget it’s on.",
            "icon": "feather"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Skin-Safe Materials",
            "description": "Hypoallergenic and latex-free. No residue, no red marks.",
            "icon": "shield"
          }
        }
      ]
    }
  ]
}
{% endschema %}
