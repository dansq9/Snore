{% comment %}
  Section: Trust Icons
  Prefix: ns-trust-icons
{% endcomment %}

{% style %}
  .ns-trust-icons {
    border-top: 1.5px solid rgba(16, 24, 43, 0.10);
    padding: 44px 24px;
  }

  .ns-trust-icons__inner {
    max-width: 900px;
    margin: 0 auto;
  }

  .ns-trust-icons__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 140px), 1fr));
    gap: 28px 16px;
  }

  .ns-trust-icons__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
  }

  .ns-trust-icons__circle {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    border: 2px solid #10182B;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
  }

  .ns-trust-icons__label {
    font-size: 11px;
    letter-spacing: 0.18em;
    font-weight: 800;
    text-transform: uppercase;
    color: #10182B;
    line-height: 1.4;
  }
{% endstyle %}

<section class="ns-trust-icons">
  <div class="ns-trust-icons__inner">
    <div class="ns-trust-icons__grid">

      <div class="ns-trust-icons__item">
        <div class="ns-trust-icons__circle">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#10182B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3v5zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3v5z"/></svg>
        </div>
        <span class="ns-trust-icons__label">24/7 Support</span>
      </div>

      <div class="ns-trust-icons__item">
        <div class="ns-trust-icons__circle">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#10182B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </div>
        <span class="ns-trust-icons__label">Fast U.S. Shipping</span>
      </div>

      <div class="ns-trust-icons__item">
        <div class="ns-trust-icons__circle">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#10182B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
        </div>
        <span class="ns-trust-icons__label">30-Day Returns</span>
      </div>

      <div class="ns-trust-icons__item">
        <div class="ns-trust-icons__circle">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#10182B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <span class="ns-trust-icons__label">Secure Checkout</span>
      </div>

    </div>
  </div>
</section>

