<style>
.ns-colls{max-width:1200px;margin:0 auto;padding:clamp(40px,7vw,72px) clamp(16px,4vw,32px) clamp(64px,10vw,112px)}
.ns-colls__h1{font-size:clamp(28px,5vw,40px);font-weight:800;letter-spacing:-.02em;margin:0 0 32px;color:#10182B}
.ns-colls__grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:24px}
.ns-colls__card{background:#fff;border:1px solid rgba(16,24,43,.08);border-radius:18px;overflow:hidden;text-decoration:none;color:#10182B}
.ns-colls__card:hover{box-shadow:0 10px 30px rgba(16,24,43,.08)}
.ns-colls__img{aspect-ratio:4/3;background:#EAEDF2;overflow:hidden}
.ns-colls__img img{width:100%;height:100%;object-fit:cover}
.ns-colls__info{padding:18px 20px}
.ns-colls__name{font-size:16px;font-weight:700;margin:0 0 4px}
.ns-colls__count{font-size:13.5px;color:#8A93A3}
.ns-colls__empty{font-size:16px;color:#566072}
</style>

<section class="ns-colls">
  <h1 class="ns-colls__h1">{{ section.settings.heading | default: 'Collections' }}</h1>

  {% if collections.size > 0 %}
    <div class="ns-colls__grid">
      {% for collection in collections %}
        <a href="{{ collection.url }}" class="ns-colls__card">
          <div class="ns-colls__img">
            {% if collection.featured_image %}
              {{ collection.featured_image | image_url: width: 600 | image_tag: loading: 'lazy' }}
            {% endif %}
          </div>
          <div class="ns-colls__info">
            <div class="ns-colls__name">{{ collection.title }}</div>
            <div class="ns-colls__count">{{ collection.all_products_count }} product{% if collection.all_products_count != 1 %}s{% endif %}</div>
          </div>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <p class="ns-colls__empty">No collections yet.</p>
  {% endif %}
</section>

{% schema %}
{
  "name": "List Collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" }
  ]
}
{% endschema %}
