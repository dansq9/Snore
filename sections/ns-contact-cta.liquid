{%- comment -%}
  "Still have questions?" contact card — navy rounded panel with an
  amber mailto button. Used at the bottom of the Help Center page.
{%- endcomment -%}

{%- assign contact_email = section.settings.email | default: 'help@nightseals.com' -%}

<section class="ns-contact-cta">
  <div class="ns-contact-cta__card">
    <h2 class="ns-contact-cta__heading">{{ section.settings.heading | default: 'Still have questions?' }}</h2>
    <p class="ns-contact-cta__body">{{ section.settings.body | default: "We're real people and we respond fast." }}</p>
    <a href="mailto:{{ contact_email }}" class="ns-contact-cta__btn">
      {{ section.settings.button_label | default: 'Email help@nightseals.com' }}
    </a>
  </div>
</section>

<style>
  .ns-contact-cta {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 clamp(16px,4vw,32px) clamp(48px,8vw,80px);
  }

  .ns-contact-cta__card {
    background: var(--navy, #10182B);
    border-radius: 22px;
    padding: clamp(28px,5vw,44px);
    text-align: center;
  }

  .ns-contact-cta__heading {
    font-size: clamp(20px,4vw,30px);
    font-weight: 800;
    color: #F2F4F7;
    margin: 0 0 8px;
    letter-spacing: -.01em;
  }

  .ns-contact-cta__body {
    font-size: 14px;
    line-height: 1.55;
    color: rgba(242,244,247,.6);
    margin: 0 0 22px;
  }

  .ns-contact-cta__btn {
    display: inline-block;
    background: var(--amber, #D9A04B);
    color: var(--navy, #10182B);
    padding: 13px 26px;
    border-radius: 999px;
    font-size: 14.5px;
    font-weight: 700;
    text-decoration: none;
    transition: background .15s;
  }
  .ns-contact-cta__btn:hover {
    background: var(--amber-hover, #E5B267);
    color: var(--navy, #10182B);
  }
</style>

{% schema %}
{
  "name": "Contact CTA",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Still have questions?"
    },
    {
      "type": "text",
      "id": "body",
      "label": "Body",
      "default": "We're real people and we respond fast."
    },
    {
      "type": "text",
      "id": "email",
      "label": "Support email",
      "default": "help@nightseals.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Email help@nightseals.com"
    }
  ],
  "presets": [
    {
      "name": "Contact CTA"
    }
  ]
}
{% endschema %}
