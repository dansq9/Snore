<style>
  .ns-quizcta {
    max-width: 860px;
    margin: 0 auto;
    padding: clamp(20px, 4vw, 40px) clamp(14px, 4vw, 32px);
  }

  .ns-quizcta__card {
    position: relative;
    overflow: hidden;
    background: #10182B;
    color: #F7F8FA;
    border-radius: 22px;
    padding: clamp(28px, 5vw, 44px) clamp(22px, 4vw, 44px);
    display: flex;
    align-items: center;
    gap: clamp(20px, 4vw, 40px);
  }
  @media (max-width: 620px) {
    .ns-quizcta__card { flex-direction: column; text-align: center; }
  }

  /* Soft amber glow, decorative */
  .ns-quizcta__card::before {
    content: "";
    position: absolute;
    top: -40%;
    right: -10%;
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, rgba(217,160,75,.22), transparent 70%);
    pointer-events: none;
  }

  .ns-quizcta__icon {
    flex: none;
    width: clamp(56px, 10vw, 72px);
    height: clamp(56px, 10vw, 72px);
    border-radius: 18px;
    background: rgba(217,160,75,.14);
    border: 1px solid rgba(217,160,75,.35);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #D9A04B;
    position: relative;
    z-index: 1;
  }

  .ns-quizcta__body { flex: 1; min-width: 0; position: relative; z-index: 1; }

  .ns-quizcta__kicker {
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: #D9A04B;
    margin: 0 0 8px;
  }

  .ns-quizcta__heading {
    font-size: clamp(20px, 3.4vw, 27px);
    font-weight: 800;
    letter-spacing: -.01em;
    line-height: 1.15;
    margin: 0 0 8px;
    text-wrap: balance;
  }

  .ns-quizcta__text {
    font-size: clamp(14px, 2.4vw, 15.5px);
    line-height: 1.55;
    color: rgba(242,244,247,.7);
    margin: 0 0 6px;
    max-width: 46ch;
  }
  @media (max-width: 620px) {
    .ns-quizcta__text { margin-left: auto; margin-right: auto; }
  }

  .ns-quizcta__meta {
    font-size: 12px;
    color: rgba(242,244,247,.5);
    margin: 10px 0 0;
  }

  .ns-quizcta__action {
    flex: none;
    position: relative;
    z-index: 1;
  }

  .ns-quizcta__btn {
    display: inline-block;
    background: #D9A04B;
    color: #10182B;
    font-size: 15.5px;
    font-weight: 700;
    padding: 15px 26px;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 8px 24px rgba(217,160,75,.25);
    transition: background .2s, box-shadow .2s;
  }
  .ns-quizcta__btn:hover {
    background: #E5B267;
    color: #10182B;
    box-shadow: 0 10px 28px rgba(217,160,75,.32);
  }
</style>

<section class="ns-quizcta">
  <div class="ns-quizcta__card">
    <div class="ns-quizcta__icon" aria-hidden="true">
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 11l3 3 8-8"/>
        <path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"/>
      </svg>
    </div>

    <div class="ns-quizcta__body">
      <p class="ns-quizcta__kicker">{{ section.settings.kicker | default: 'Not sure where to start?' }}</p>
      <h2 class="ns-quizcta__heading">{{ section.settings.heading | default: 'Take the 2-minute sleep assessment' }}</h2>
      <p class="ns-quizcta__text">{{ section.settings.body | default: 'Answer a few quick questions and get a personalized plan for quieter, more restful nights.' }}</p>
      <p class="ns-quizcta__meta">{{ section.settings.meta | default: 'Free · No email needed · Results in 2 minutes' }}</p>
    </div>

    <div class="ns-quizcta__action">
      <a href="{{ section.settings.quiz_url | default: '/pages/sleep-quiz' }}" class="ns-quizcta__btn">
        {{ section.settings.cta_text | default: 'Start the sleep quiz →' }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Quiz CTA Card",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Not sure where to start?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Take the 2-minute sleep assessment" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Answer a few quick questions and get a personalized plan for quieter, more restful nights." },
    { "type": "text", "id": "meta", "label": "Meta line", "default": "Free · No email needed · Results in 2 minutes" },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Start the sleep quiz →" },
    { "type": "url", "id": "quiz_url", "label": "Quiz page URL", "info": "Point at the Sleep Quiz page once created (/pages/sleep-quiz)." }
  ],
  "presets": [
    { "name": "Quiz CTA Card" }
  ]
}
{% endschema %}
