      "default": "If any of these describe your mornings, your mouth is probably open all night."
    },
    {
      "type": "text",
      "id": "item_1_title",
      "label": "Symptom 1 title",
      "default": "7-8 hours in bed, still exhausted."
    },
    {
      "type": "text",
      "id": "item_1_body",
      "label": "Symptom 1 body",
      "default": "The hours are there. The quality isn't."
    },
    {
      "type": "text",
      "id": "item_2_title",
      "label": "Symptom 2 title",
      "default": "Snoring loud enough to move rooms."
    },
    {
      "type": "text",
      "id": "item_2_body",
      "label": "Symptom 2 body",
      "default": "Your partner has mentioned it. More than once."
    },
    {
      "type": "text",
      "id": "item_3_title",
      "label": "Symptom 3 title",
      "default": "Dry mouth at 3am."
    },
    {
      "type": "text",
