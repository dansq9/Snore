{%- comment -%}
  Landing LEAD — editorial, story-first hero for cold paid traffic.
  Problem-framed headline + mechanism hook + benefit checklist + a SOFT CTA
  that scrolls to the offer module (#tiers) further down. No buy box here:
  the shoppable module (ns-landing-shop) is revealed after the education.
  This section owns the page's only top nav (store chrome is suppressed for
  the landing template in theme.liquid).
{%- endcomment -%}

<nav class="ns-lhero__nav">
  <a href="{{ routes.root_url }}" class="ns-lhero__wordmark">NIGHTSEALS</a>
</nav>

<header class="ns-lhero">
  <div class="ns-lhero__grid">
    <div class="ns-lhero__col">
      <h1 class="ns-lhero__heading">{{ section.settings.heading | default: "Your mouth falls open at night. That's the problem." }}</h1>
      <p class="ns-lhero__sub">{{ section.settings.subheading | default: "You can't feel it happen, but it's why you wake up tired and snoring. The fix takes 3 seconds." }}</p>

      <ul class="ns-lhero__checklist">
        <li class="ns-lhero__check"><span class="ns-lhero__check-icon">&#10003;</span>{{ section.settings.check_1 | default: 'Less snoring, quieter nights' }}</li>
        <li class="ns-lhero__check"><span class="ns-lhero__check-icon">&#10003;</span>{{ section.settings.check_2 | default: 'No more 3am dry mouth' }}</li>
        <li class="ns-lhero__check"><span class="ns-lhero__check-icon">&#10003;</span>{{ section.settings.check_3 | default: 'Stays put all night' }}</li>
      </ul>

      <a href="{{ section.settings.cta_url | default: '#tiers' }}" class="ns-lhero__cta">{{ section.settings.cta_text | default: 'Try NightSeals risk-free →' }}</a>
      <div class="ns-lhero__audience">{{ section.settings.audience_line | default: 'For those who snore, and the partners who put up with it.' }}</div>
      <div class="ns-lhero__trust">{{ section.settings.trust_line | default: '30-night money-back guarantee' }}</div>
    </div>
    <div class="ns-lhero__media">
      {%- if section.settings.hero_image != blank -%}
        {{ section.settings.hero_image | image_url: width: 1000 | image_tag: loading: 'eager', class: 'ns-lhero__img' }}
      {%- else -%}
        <img src="{{ 'nightseals-lifestyle.png' | asset_url }}" alt="" class="ns-lhero__img" width="1000" height="750" loading="eager">
      {%- endif -%}
    </div>
  </div>
</header>

<style>
  @keyframes ns-lhero-pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.04); } }

  .ns-lhero__nav {
    background: #10182B;
    padding: 14px clamp(14px,4vw,32px);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ns-lhero__wordmark {
    font-weight: 800;
    font-size: 16px;
    letter-spacing: .14em;
    color: #F2F4F7;
    text-decoration: none;
  }
  .ns-lhero__wordmark:hover { color: #F2F4F7; }

  .ns-lhero {
    background: #10182B;
    color: #F2F4F7;
    padding: clamp(32px,6vw,56px) clamp(14px,4vw,32px) clamp(48px,8vw,72px);
  }
  .ns-lhero__grid {
    max-width: 1000px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%,380px),1fr));
    gap: clamp(28px,5vw,48px);
    align-items: center;
  }

  .ns-lhero__heading {
    font-size: clamp(28px,5.5vw,48px);
    line-height: 1.08;
    letter-spacing: -.03em;
    font-weight: 800;
    margin: 0 0 14px;
    text-wrap: pretty;
  }
  .ns-lhero__sub {
    font-size: clamp(15px,3.2vw,17px);
    line-height: 1.55;
    color: rgba(242,244,247,.65);
    margin: 0 0 22px;
    max-width: 460px;
  }

  .ns-lhero__checklist {
    list-style: none;
    padding: 0;
    margin: 0 0 26px;
    display: grid;
    gap: 10px;
    max-width: 460px;
  }
  .ns-lhero__check {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: clamp(14px,2.6vw,15.5px);
    font-weight: 600;
    color: rgba(242,244,247,.9);
  }
  .ns-lhero__check-icon { color: #D9A04B; font-weight: 800; flex: none; margin-top: 1px; }

  .ns-lhero__cta {
    display: inline-block;
    background: #D9A04B;
    color: #10182B;
    padding: 16px 32px;
    border-radius: 999px;
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    animation: ns-lhero-pulse 3s ease-in-out infinite;
  }
  .ns-lhero__cta:hover { background: #E5B267; color: #10182B; }
  @media (prefers-reduced-motion: reduce) { .ns-lhero__cta { animation: none; } }

  .ns-lhero__audience {
    margin-top: 14px;
    font-size: 12.5px;
    color: rgba(242,244,247,.5);
    font-weight: 500;
  }
  .ns-lhero__trust {
    margin-top: 8px;
    font-size: 11.5px;
    color: rgba(242,244,247,.4);
    font-weight: 500;
  }

  .ns-lhero__media { height: min(420px,90vw); }
  .ns-lhero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 22px;
    display: block;
  }

  /* On mobile (single column) show the image FIRST, above the copy. */
  @media (max-width: 760px) {
    .ns-lhero__media { order: -1; }
  }
</style>

{% schema %}
{
  "name": "Landing Hero",
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Your mouth falls open at night. That's the problem." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "You can't feel it happen, but it's why you wake up tired and snoring. The fix takes 3 seconds." },
    { "type": "text", "id": "check_1", "label": "Checklist 1", "default": "Less snoring, quieter nights" },
    { "type": "text", "id": "check_2", "label": "Checklist 2", "default": "No more 3am dry mouth" },
    { "type": "text", "id": "check_3", "label": "Checklist 3", "default": "Stays put all night" },
    { "type": "text", "id": "cta_text", "label": "CTA label", "default": "Try NightSeals risk-free →" },
    { "type": "url", "id": "cta_url", "label": "CTA target", "info": "Defaults to the offer module (#tiers) further down the page." },
    { "type": "text", "id": "audience_line", "label": "Audience line", "default": "For those who snore, and the partners who put up with it." },
    { "type": "text", "id": "trust_line", "label": "Trust line", "default": "30-night money-back guarantee" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image", "info": "Falls back to the bundled lifestyle photo." }
  ],
  "presets": [
    { "name": "Landing Hero" }
  ]
}
{% endschema %}
