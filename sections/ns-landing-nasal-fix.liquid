{%- comment -%}
  ns-landing-nasal-fix — "Nasal breathing fixes all of it" education + CTA.
  Image + the why-nasal-breathing-matters explainer + the simple fix + a soft
  CTA to the offer (#tiers). Copy kept general-wellness (no disease/treatment
  claims). Owner supplies the photo/video-still via the image picker.
{%- endcomment -%}
<style>
  .ns-nasalfix {
    background: #EAEDF2;
    padding: clamp(40px, 7vw, 80px) clamp(14px, 4vw, 32px);
  }

  .ns-nasalfix__inner {
    max-width: 1000px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(24px, 5vw, 48px);
    align-items: center;
  }
  @media (max-width: 760px) {
    .ns-nasalfix__inner { grid-template-columns: 1fr; }
  }

  .ns-nasalfix__media {
    aspect-ratio: 1 / 1;
    border-radius: 20px;
    overflow: hidden;
    background: #DfE3EA;
  }
  .ns-nasalfix__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ns-nasalfix__ph {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    text-align: center; padding: 20px; color: #8A93A3; font-size: 13.5px; line-height: 1.5;
  }

  .ns-nasalfix__title {
    font-size: clamp(24px, 4.4vw, 36px);
    font-weight: 800;
    letter-spacing: -.02em;
    color: #10182B;
    margin: 0 0 14px;
    text-wrap: pretty;
  }

  .ns-nasalfix__body {
    font-size: clamp(15px, 2.4vw, 16.5px);
    line-height: 1.6;
    color: #566072;
    margin: 0 0 16px;
    text-wrap: pretty;
  }

  .ns-nasalfix__fix {
    font-size: clamp(15px, 2.4vw, 16.5px);
    line-height: 1.55;
    font-weight: 700;
    color: #10182B;
    margin: 0 0 24px;
    text-wrap: pretty;
  }

  .ns-nasalfix__cta {
    display: inline-block;
    background: #D9A04B;
    color: #10182B;
    padding: 15px 30px;
    border-radius: 999px;
    font-size: 15.5px;
    font-weight: 700;
    text-decoration: none;
    transition: background .2s;
  }
  .ns-nasalfix__cta:hover { background: #E5B267; color: #10182B; }
</style>

<section class="ns-nasalfix">
  <div class="ns-nasalfix__inner">
    <div class="ns-nasalfix__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: section.settings.heading }}
      {%- else -%}
        <div class="ns-nasalfix__ph">{{ section.settings.image_placeholder | default: 'Calm nasal breather, taped, sleeping soundly' }}</div>
      {%- endif -%}
    </div>
    <div class="ns-nasalfix__content">
      <h2 class="ns-nasalfix__title">{{ section.settings.heading | default: 'Nasal breathing fixes all of it' }}</h2>
      <p class="ns-nasalfix__body">{{ section.settings.body | default: "Your nose filters, warms and humidifies every breath before it reaches your lungs, and it slows your breathing into a calmer, deeper rhythm. It's how your body is built to sleep. The moment your mouth falls open, all of that stops, and the snoring, dry mouth and restless nights follow." }}</p>
      <p class="ns-nasalfix__fix">{{ section.settings.fix | default: 'The fix is simple: keep your mouth gently closed at night and breathe through your nose. NightSeals is the easiest way to make sure you do, while you sleep.' }}</p>
      <a href="{{ section.settings.cta_url | default: '#tiers' }}" class="ns-nasalfix__cta">{{ section.settings.cta_text | default: 'Become a nasal breather →' }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Nasal Breathing Fix",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_placeholder", "label": "Image placeholder text", "default": "Calm nasal breather, taped, sleeping soundly" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Nasal breathing fixes all of it" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Your nose filters, warms and humidifies every breath before it reaches your lungs, and it slows your breathing into a calmer, deeper rhythm. It's how your body is built to sleep. The moment your mouth falls open, all of that stops, and the snoring, dry mouth and restless nights follow." },
    { "type": "textarea", "id": "fix", "label": "The fix", "default": "The fix is simple: keep your mouth gently closed at night and breathe through your nose. NightSeals is the easiest way to make sure you do, while you sleep." },
    { "type": "text", "id": "cta_text", "label": "CTA label", "default": "Become a nasal breather →" },
    { "type": "url", "id": "cta_url", "label": "CTA target", "info": "Defaults to the offer module (#tiers)." }
  ],
  "presets": [
    { "name": "Nasal Breathing Fix" }
  ]
}
{% endschema %}
