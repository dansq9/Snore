<style>
  .ns-lproblem {
    background: #10182B;
    color: #F2F4F7;
    padding: clamp(36px, 6vw, 80px) clamp(14px, 4vw, 32px);
  }

  .ns-lproblem__inner {
    max-width: 860px;
    margin: 0 auto;
  }

  .ns-lproblem__kicker {
    font-size: 11.5px;
    letter-spacing: .24em;
    font-weight: 800;
    color: #D9A04B;
    margin-bottom: 14px;
  }

  .ns-lproblem__heading {
    font-size: clamp(24px, 4.5vw, 36px);
    letter-spacing: -.02em;
    font-weight: 800;
    margin: 0 0 28px;
    text-wrap: pretty;
  }

  .ns-lproblem__items {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .ns-lproblem__item {
    display: flex;
    gap: clamp(14px, 3vw, 24px);
    padding: clamp(18px, 3vw, 26px) 0;
    border-bottom: 1px solid rgba(242, 244, 247, .12);
  }

  .ns-lproblem__item--last {
    border-bottom: none;
  }

  .ns-lproblem__number {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 13px;
    color: #D9A04B;
    padding-top: 3px;
    flex: none;
  }

  .ns-lproblem__item-title {
    font-size: clamp(16px, 3vw, 18px);
    font-weight: 700;
    margin-bottom: 6px;
  }

  .ns-lproblem__item-body {
    font-size: clamp(13.5px, 2.6vw, 15px);
    line-height: 1.55;
    color: rgba(242, 244, 247, .6);
  }

  .ns-lproblem__fix {
    margin-top: clamp(28px, 5vw, 40px);
    padding: clamp(20px, 4vw, 28px);
    background: rgba(217, 160, 75, .12);
    border: 1px solid rgba(217, 160, 75, .25);
    border-radius: 18px;
  }

  .ns-lproblem__fix-text {
    font-size: clamp(15px, 3vw, 17px);
    line-height: 1.55;
    margin: 0;
    text-wrap: pretty;
  }

  .ns-lproblem__fix-label {
    font-weight: 800;
    color: #D9A04B;
  }

  .ns-lproblem__fix-body {
    color: rgba(242, 244, 247, .85);
  }
</style>

<section class="ns-lproblem">
  <div class="ns-lproblem__inner">
    <div class="ns-lproblem__kicker">{{ section.settings.kicker | default: "THE PROBLEM" }}</div>
    <h2 class="ns-lproblem__heading">{{ section.settings.heading | default: "What mouth breathing does to you every single night" }}</h2>
    <div class="ns-lproblem__items">
      <div class="ns-lproblem__item">
        <span class="ns-lproblem__number">01</span>
        <div>
          <div class="ns-lproblem__item-title">{{ section.settings.item_1_title | default: "Dries your airway" }}</div>
          <div class="ns-lproblem__item-body">{{ section.settings.item_1_body | default: "Hours of open-mouth airflow strips moisture from your throat, tongue and gums. You wake up parched, breath rough, tongue like cardboard." }}</div>
        </div>
      </div>
      <div class="ns-lproblem__item">
        <span class="ns-lproblem__number">02</span>
        <div>
          <div class="ns-lproblem__item-title">{{ section.settings.item_2_title | default: "Triggers snoring" }}</div>
          <div class="ns-lproblem__item-body">{{ section.settings.item_2_body | default: "An open mouth can narrow the airway and set soft tissue vibrating. That's the noise that exiles you to the guest room." }}</div>
        </div>
      </div>
      <div class="ns-lproblem__item ns-lproblem__item--last">
        <span class="ns-lproblem__number">03</span>
        <div>
          <div class="ns-lproblem__item-title">{{ section.settings.item_3_title | default: "Fragments your sleep" }}</div>
          <div class="ns-lproblem__item-body">{{ section.settings.item_3_body | default: "Your nose filters, warms and humidifies every breath. Bypass it all night and you wake tired no matter how long you slept." }}</div>
        </div>
      </div>
    </div>
    <div class="ns-lproblem__fix">
      <p class="ns-lproblem__fix-text"><span class="ns-lproblem__fix-label">{{ section.settings.fix_label | default: "The fix:" }}</span> <span class="ns-lproblem__fix-body">{{ section.settings.fix_body | default: "Keep your lips sealed and let your nose do the job it was built for. One strip, three seconds, every night." }}</span></p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing Problem",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "THE PROBLEM"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What mouth breathing does to you every single night"
    },
    {
      "type": "text",
      "id": "item_1_title",
      "label": "Item 1 title",
      "default": "Dries your airway"
    },
    {
      "type": "textarea",
      "id": "item_1_body",
      "label": "Item 1 body",
      "default": "Hours of open-mouth airflow strips moisture from your throat, tongue and gums. You wake up parched, breath rough, tongue like cardboard."
    },
    {
      "type": "text",
      "id": "item_2_title",
      "label": "Item 2 title",
      "default": "Triggers snoring"
    },
    {
      "type": "textarea",
      "id": "item_2_body",
      "label": "Item 2 body",
      "default": "An open mouth can narrow the airway and set soft tissue vibrating. That's the noise that exiles you to the guest room."
    },
    {
      "type": "text",
      "id": "item_3_title",
      "label": "Item 3 title",
      "default": "Fragments your sleep"
    },
    {
      "type": "textarea",
      "id": "item_3_body",
      "label": "Item 3 body",
      "default": "Your nose filters, warms and humidifies every breath. Bypass it all night and you wake tired no matter how long you slept."
    },
    {
      "type": "text",
      "id": "fix_label",
      "label": "Fix label",
      "default": "The fix:"
    },
    {
      "type": "textarea",
      "id": "fix_body",
      "label": "Fix body",
      "default": "Keep your lips sealed and let your nose do the job it was built for. One strip, three seconds, every night."
    }
  ],
  "presets": [
    {
      "name": "Landing Problem"
    }
  ]
}
{% endschema %}
