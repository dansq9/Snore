{%- comment -%}
  Landing page — META10 promo bar + #buy guarantee/tier selector + minimal
  footer + sticky bottom CTA. The tier selector reads the store's Main product
  variants (Theme settings → Shop) so pricing stays live. "Add to cart" uses the
  theme's AJAX cart drawer (window.NsCart).
{%- endcomment -%}

{%- assign product = settings.featured_product -%}
{%- if product == blank -%}{%- assign product = collections.all.products.first -%}{%- endif -%}
{%- assign promo_code = section.settings.promo_code | default: 'META10' -%}

<div class="ns-lbuy__promobar">
  <span class="ns-lbuy__promobar-text">This page only: use code <span class="ns-lbuy__promobar-code">{{ promo_code }}</span> for 10% off your first order</span>
</div>

<section id="buy" class="ns-lbuy">
  <div class="ns-lbuy__inner">
    <div class="ns-lbuy__head">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#D9A04B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"></path><path d="M9 11.5l2 2 4-4"></path></svg>
      <h2 class="ns-lbuy__heading">{{ section.settings.heading | default: 'The NightSeals Guarantee' }}</h2>
    </div>
    <p class="ns-lbuy__body">We're confident NightSeals will change how you sleep. That's why we offer a <span class="ns-lbuy__body-strong">hassle-free, results-backed guarantee.</span> 30 nights. No questions asked.</p>

    {%- if product != blank and product.variants.size > 0 -%}
      <div class="ns-lbuy__tiers" id="ns-lbuy-tiers">
        {%- for variant in product.variants -%}
          <div class="ns-lbuy__tier{% if forloop.index == 2 %} is-active{% endif %}"
               data-variant-id="{{ variant.id }}"
               data-price="{{ variant.price | money }}">
            {%- if forloop.index == 2 -%}
              <span class="ns-lbuy__badge ns-lbuy__badge--popular">MOST POPULAR</span>
            {%- elsif forloop.index == 3 -%}
              <span class="ns-lbuy__badge ns-lbuy__badge--value">BEST VALUE</span>
            {%- endif -%}
            <div class="ns-lbuy__tier-left">
              <span class="ns-lbuy__radio"><span class="ns-lbuy__radio-dot"></span></span>
              <div>
                <div class="ns-lbuy__tier-label">{{ variant.title }}</div>
                {%- if variant.metafields.custom.per_night != blank -%}
                  <div class="ns-lbuy__tier-per">{{ variant.metafields.custom.per_night }} / night</div>
                {%- endif -%}
              </div>
            </div>
            <div class="ns-lbuy__tier-right">
              <div class="ns-lbuy__tier-price">{{ variant.price | money }}</div>
              {%- if variant.compare_at_price > variant.price -%}
                <div class="ns-lbuy__tier-compare">{{ variant.compare_at_price | money }}</div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- assign default_variant = product.variants[1] | default: product.variants.first -%}
      <button type="button" class="ns-lbuy__cta" id="ns-lbuy-add" data-variant-id="{{ default_variant.id }}">
        Add to cart - <span id="ns-lbuy-price">{{ default_variant.price | money }}</span>
      </button>
    {%- else -%}
      <a href="{% render 'shop-url' %}" class="ns-lbuy__cta ns-lbuy__cta--link">Shop NightSeals</a>
      <p class="ns-lbuy__note">Set your Main product (with 30/90/180-night variants) under Theme settings → Shop to enable the tier selector.</p>
    {%- endif -%}

    <div class="ns-lbuy__trust">30-night guarantee · Free shipping $50+ · Hypoallergenic</div>
  </div>
</section>

<div class="ns-lbuy__footer">
  <p class="ns-lbuy__disclaimer"><span class="ns-lbuy__disclaimer-strong">Medical Disclaimer:</span> NightSeals is not a medical device and is not intended to diagnose, treat, cure or prevent any disease, including sleep apnea. These statements have not been evaluated by the FDA. Consult your physician with any concerns. Do not use if you cannot breathe comfortably through your nose.</p>
  <div class="ns-lbuy__footer-links">
    <span>&copy; 2026 NightSeals</span>
    {%- if shop.terms_of_service.url != blank -%}<a href="{{ shop.terms_of_service.url }}">Terms</a>{%- else -%}<a href="/policies/terms-of-service">Terms</a>{%- endif -%}
    {%- if shop.privacy_policy.url != blank -%}<a href="{{ shop.privacy_policy.url }}">Privacy</a>{%- else -%}<a href="/policies/privacy-policy">Privacy</a>{%- endif -%}
    {%- if shop.shipping_policy.url != blank -%}<a href="{{ shop.shipping_policy.url }}">Shipping</a>{%- else -%}<a href="/policies/shipping-policy">Shipping</a>{%- endif -%}
    {%- if shop.refund_policy.url != blank -%}<a href="{{ shop.refund_policy.url }}">Refunds</a>{%- else -%}<a href="/policies/refund-policy">Refunds</a>{%- endif -%}
  </div>
</div>

<div class="ns-lbuy__sticky" id="ns-lbuy-sticky" hidden>
  <a href="#buy" class="ns-lbuy__sticky-btn">{{ section.settings.sticky_text | default: 'Try NightSeals - from $0.56/night' }}</a>
</div>

<style>
  .ns-lbuy__promobar { background: #D9A04B; padding: 12px clamp(14px,4vw,32px); text-align: center; }
  .ns-lbuy__promobar-text { font-size: 13px; font-weight: 700; color: #10182B; }
  .ns-lbuy__promobar-code { letter-spacing: .1em; font-weight: 800; }

  .ns-lbuy { background: #10182B; color: #F2F4F7; padding: clamp(40px,7vw,88px) clamp(14px,4vw,32px); }
  .ns-lbuy__inner { max-width: 520px; margin: 0 auto; text-align: center; }
  .ns-lbuy__head {
    display: flex; align-items: center; gap: 16px; justify-content: center;
    margin-bottom: clamp(20px,4vw,28px);
  }
  .ns-lbuy__heading { font-size: clamp(24px,5vw,38px); letter-spacing: -.02em; font-weight: 800; margin: 0; }
  .ns-lbuy__body {
    font-size: clamp(14px,3vw,16px); line-height: 1.55; color: rgba(242,244,247,.65);
    margin: 0 auto 28px; max-width: 480px; text-wrap: pretty;
  }
  .ns-lbuy__body-strong { font-weight: 800; color: #F2F4F7; }

  .ns-lbuy__tiers { display: flex; flex-direction: column; gap: 12px; text-align: left; margin-bottom: 24px; }
  .ns-lbuy__tier {
    position: relative; display: flex; align-items: center; justify-content: space-between; gap: 14px;
    padding: 16px 18px; border-radius: 14px; cursor: pointer;
    border: 2px solid rgba(242,244,247,.2); background: transparent;
    transition: border-color .2s, background .2s;
  }
  .ns-lbuy__tier.is-active { border-color: #D9A04B; background: rgba(217,160,75,.08); }
  .ns-lbuy__badge {
    position: absolute; top: -11px; left: 18px;
    font-size: 10px; letter-spacing: .1em; font-weight: 700; padding: 3px 10px; border-radius: 999px;
  }
  .ns-lbuy__badge--popular { background: #F2F4F7; color: #10182B; }
  .ns-lbuy__badge--value { background: #D9A04B; color: #10182B; }
  .ns-lbuy__tier-left { display: flex; align-items: center; gap: 12px; }
  .ns-lbuy__radio {
    width: 18px; height: 18px; border-radius: 50%; border: 2px solid rgba(242,244,247,.3);
    display: flex; align-items: center; justify-content: center; flex: none; transition: border-color .2s;
  }
  .ns-lbuy__tier.is-active .ns-lbuy__radio { border-color: #D9A04B; }
  .ns-lbuy__radio-dot { width: 9px; height: 9px; border-radius: 50%; background: transparent; transition: background .2s; }
  .ns-lbuy__tier.is-active .ns-lbuy__radio-dot { background: #D9A04B; }
  .ns-lbuy__tier-label { font-size: 15px; font-weight: 700; color: #F2F4F7; }
  .ns-lbuy__tier-per { font-size: 12px; color: rgba(242,244,247,.5); margin-top: 2px; }
  .ns-lbuy__tier-right { text-align: right; }
  .ns-lbuy__tier-price { font-size: 17px; font-weight: 800; color: #F2F4F7; }
  .ns-lbuy__tier-compare { font-size: 12px; color: rgba(242,244,247,.45); text-decoration: line-through; }

  .ns-lbuy__cta {
    display: block; width: 100%; background: #D9A04B; color: #10182B; text-align: center;
    padding: 17px 24px; border-radius: 999px; font-size: 16.5px; font-weight: 700;
    border: none; cursor: pointer; font-family: var(--font-primary); text-decoration: none;
    transition: background .2s;
  }
  .ns-lbuy__cta:hover { background: #E5B267; color: #10182B; }
  .ns-lbuy__cta--link { width: auto; display: inline-block; }
  .ns-lbuy__note { font-size: 12px; color: rgba(242,244,247,.5); margin: 14px 0 0; }
  .ns-lbuy__trust { margin-top: 14px; font-size: 12px; color: rgba(242,244,247,.45); }

  .ns-lbuy__footer { max-width: 860px; margin: 0 auto; padding: clamp(20px,4vw,40px) clamp(14px,4vw,32px); }
  .ns-lbuy__disclaimer { font-size: 11px; line-height: 1.65; color: #8A93A3; max-width: 720px; margin: 0; }
  .ns-lbuy__disclaimer-strong { font-weight: 700; color: #566072; }
  .ns-lbuy__footer-links {
    display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: 20px;
    font-size: 12px; color: #8A93A3;
  }
  .ns-lbuy__footer-links a { color: #8A93A3; text-decoration: underline; text-underline-offset: 2px; }
  .ns-lbuy__footer-links a:hover { color: #566072; }

  .ns-lbuy__sticky {
    position: fixed; bottom: 0; left: 50%; transform: translateX(-50%);
    width: 100%; max-width: 1200px; z-index: 90;
    padding: 10px clamp(16px,4vw,32px) 14px;
    background: linear-gradient(transparent, #F7F8FA 35%);
    pointer-events: none;
  }
  .ns-lbuy__sticky[hidden] { display: none; }
  .ns-lbuy__sticky-btn {
    display: block; background: #10182B; color: #F2F4F7; text-align: center;
    padding: 14px 20px; border-radius: 999px; font-size: clamp(13.5px,3.5vw,15.5px); font-weight: 700;
    pointer-events: auto; box-shadow: 0 8px 32px rgba(16,24,43,.3); white-space: nowrap; text-decoration: none;
  }
  .ns-lbuy__sticky-btn:hover { background: #26314D; color: #F2F4F7; }
</style>

<script>
  (function () {
    var tiers = document.querySelectorAll('#ns-lbuy-tiers .ns-lbuy__tier');
    var addBtn = document.getElementById('ns-lbuy-add');
    var priceEl = document.getElementById('ns-lbuy-price');

    tiers.forEach(function (tier) {
      tier.addEventListener('click', function () {
        tiers.forEach(function (t) { t.classList.remove('is-active'); });
        tier.classList.add('is-active');
        if (addBtn) addBtn.setAttribute('data-variant-id', tier.getAttribute('data-variant-id'));
        if (priceEl) priceEl.textContent = tier.getAttribute('data-price');
      });
    });

    if (addBtn) {
      addBtn.addEventListener('click', function () {
        var id = addBtn.getAttribute('data-variant-id');
        if (!id) return;
        if (window.NsCart && typeof window.NsCart.add === 'function') {
          window.NsCart.add(id, 1);
        } else {
          fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: [{ id: parseInt(id, 10), quantity: 1 }] })
          }).then(function () { window.location.href = '/cart'; });
        }
      });
    }

    /* Sticky CTA: show after scrolling past the hero, hide once #buy is in view. */
    var sticky = document.getElementById('ns-lbuy-sticky');
    var buy = document.getElementById('buy');
    if (sticky && buy) {
      var buyVisible = false;
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          buyVisible = entries[0].isIntersecting;
          update();
        }, { threshold: 0.15 }).observe(buy);
      }
      function update() {
        var scrolled = window.pageYOffset > 500;
        sticky.hidden = !(scrolled && !buyVisible);
      }
      window.addEventListener('scroll', update, { passive: true });
      update();
    }
  })();
</script>

{% schema %}
{
  "name": "Landing Buy",
  "settings": [
    { "type": "text", "id": "promo_code", "label": "Promo code", "default": "META10" },
    { "type": "text", "id": "heading", "label": "Guarantee heading", "default": "The NightSeals Guarantee" },
    { "type": "text", "id": "sticky_text", "label": "Sticky bar label", "default": "Try NightSeals - from $0.56/night" }
  ],
  "presets": [
    { "name": "Landing Buy" }
  ]
}
{% endschema %}
