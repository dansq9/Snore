{%- comment -%}
  Landing closer: the 30-night guarantee card (mirrors the PDP's
  ns-guarantee-cta) + the page's minimal footer (medical disclaimer +
  policy links). The CTA scrolls to the on-page offer module (#tiers) so
  buy-intent never leaves the advertorial.
{%- endcomment -%}

<section id="buy" class="ns-lbuy">
  <div class="ns-lbuy__card">
    <h2 class="ns-lbuy__heading">{{ section.settings.heading | default: 'Sleep on it for' }} <span class="ns-lbuy__highlight">{{ section.settings.highlight | default: '30 nights' }}</span></h2>
    <p class="ns-lbuy__desc">{{ section.settings.body | default: "If you're not sleeping quieter and waking up better, email us and we'll refund every cent. No return label, no questions, no hard feelings." }}</p>
    <a href="{{ section.settings.cta_url | default: '#tiers' }}" class="ns-lbuy__cta">{{ section.settings.cta_label | default: 'Try NightSeals risk-free' }}</a>
  </div>
</section>

<footer class="ns-lbuy__footer">
  <p class="ns-lbuy__disclaimer"><span class="ns-lbuy__disclaimer-strong">Medical Disclaimer:</span> NightSeals is not a medical device and is not intended to diagnose, treat, cure or prevent any disease, including sleep apnea. These statements have not been evaluated by the FDA. Consult your physician with any concerns. Do not use if you cannot breathe comfortably through your nose, have an active illness or infection, low blood pressure, or a heart or respiratory condition, or after consuming alcohol or sedatives. Discontinue use if you experience irritation, dryness, or any lip or skin abrasion. NightSeals is drug-free.</p>
  <div class="ns-lbuy__footer-links">
    <span>&copy; 2026 NightSeals</span>
    {%- if shop.terms_of_service.url != blank -%}<a href="{{ shop.terms_of_service.url }}">Terms</a>{%- else -%}<a href="/policies/terms-of-service">Terms</a>{%- endif -%}
    {%- if shop.privacy_policy.url != blank -%}<a href="{{ shop.privacy_policy.url }}">Privacy</a>{%- else -%}<a href="/policies/privacy-policy">Privacy</a>{%- endif -%}
    {%- if shop.shipping_policy.url != blank -%}<a href="{{ shop.shipping_policy.url }}">Shipping</a>{%- else -%}<a href="/policies/shipping-policy">Shipping</a>{%- endif -%}
    {%- if shop.refund_policy.url != blank -%}<a href="{{ shop.refund_policy.url }}">Refunds</a>{%- else -%}<a href="/policies/refund-policy">Refunds</a>{%- endif -%}
  </div>
</footer>

<style>
  .ns-lbuy { max-width: 1200px; margin: 0 auto; padding: clamp(24px,5vw,48px) 24px 0; }
  .ns-lbuy__card {
    background: #10182B;
    border-radius: 28px;
    padding: clamp(32px,6vw,72px) clamp(18px,5vw,48px);
    text-align: center;
  }
  .ns-lbuy__heading {
    font-size: clamp(26px,4.5vw,42px);
    line-height: 1.08;
    font-weight: 800;
    color: #F2F4F7;
    margin: 0 0 20px;
    letter-spacing: -.02em;
  }
  .ns-lbuy__highlight {
    background: #D9A04B;
    color: #10182B;
    padding: 0 7px 3px;
    border-radius: 6px;
    display: inline-block;
    transform: rotate(-2deg);
  }
  .ns-lbuy__desc {
    font-size: 16.5px;
    line-height: 1.6;
    color: rgba(242,244,247,.65);
    max-width: 520px;
    margin: 0 auto 28px;
    text-wrap: pretty;
  }
  .ns-lbuy__cta {
    display: inline-block;
    background: #D9A04B;
    color: #10182B;
    font-size: 15px;
    font-weight: 700;
    padding: 14px 28px;
    border-radius: 999px;
    text-decoration: none;
    transition: opacity .2s;
  }
  .ns-lbuy__cta:hover { opacity: .88; }

  /* Footer (disclaimer + policy links) */
  .ns-lbuy__footer { max-width: 860px; margin: 0 auto; padding: clamp(24px,4vw,40px) clamp(14px,4vw,32px); }
  .ns-lbuy__disclaimer { font-size: 11px; line-height: 1.65; color: #8A93A3; max-width: 720px; margin: 0; }
  .ns-lbuy__disclaimer-strong { font-weight: 700; color: #566072; }
  .ns-lbuy__footer-links {
    display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: 20px;
    font-size: 12px; color: #8A93A3;
  }
  .ns-lbuy__footer-links a { color: #8A93A3; text-decoration: underline; text-underline-offset: 2px; }
  .ns-lbuy__footer-links a:hover { color: #566072; }
</style>

{% schema %}
{
  "name": "Landing Buy",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading lead", "default": "Sleep on it for" },
    { "type": "text", "id": "highlight", "label": "Highlight (nights)", "default": "30 nights" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "If you're not sleeping quieter and waking up better, email us and we'll refund every cent. No return label, no questions, no hard feelings." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Try NightSeals risk-free" },
    { "type": "url", "id": "cta_url", "label": "CTA target", "info": "Defaults to the offer module (#tiers)." }
  ],
  "presets": [
    { "name": "Landing Buy" }
  ]
}
{% endschema %}
