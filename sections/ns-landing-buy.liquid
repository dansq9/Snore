{%- comment -%}
  Landing closer: a lightweight guarantee reassurance + one compact CTA that
  points back to the single offer module (#tiers, in ns-landing-shop). It does
  NOT repeat the price/offer card (that lives in the shop module and the launch
  offer), so it stays light and can't show a wrong pack. This section also owns
  the page's minimal footer (medical disclaimer + policy links).
{%- endcomment -%}

<section id="buy" class="ns-lbuy">
  <div class="ns-lbuy__inner">
    <div class="ns-lbuy__head">
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#D9A04B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"></path><path d="M9 11.5l2 2 4-4"></path></svg>
      <h2 class="ns-lbuy__heading">{{ section.settings.heading | default: 'The NightSeals Guarantee' }}</h2>
    </div>
    <p class="ns-lbuy__body">We're confident NightSeals will change how you sleep. That's why we offer a <span class="ns-lbuy__body-strong">hassle-free, money-back guarantee.</span> 30 nights. No questions asked.</p>

    <a href="{{ section.settings.cta_url | default: '#tiers' }}" class="ns-lbuy__cta">{{ section.settings.cta_label | default: 'Claim your 60-night offer →' }}</a>

    <div class="ns-lbuy__trust">30-night money-back guarantee · Drug-free</div>
  </div>
</section>

<footer class="ns-lbuy__footer">
  <p class="ns-lbuy__disclaimer"><span class="ns-lbuy__disclaimer-strong">Medical Disclaimer:</span> NightSeals is not a medical device and is not intended to diagnose, treat, cure or prevent any disease, including sleep apnea. These statements have not been evaluated by the FDA. Consult your physician with any concerns. Do not use if you cannot breathe comfortably through your nose, have an active illness or infection, low blood pressure, or a heart or respiratory condition, or after consuming alcohol or sedatives. Discontinue use if you experience irritation, dryness, or any lip or skin abrasion. NightSeals is drug-free.</p>
  <div class="ns-lbuy__footer-links">
    <span>&copy; 2026 NightSeals</span>
    {%- if shop.terms_of_service.url != blank -%}<a href="{{ shop.terms_of_service.url }}">Terms</a>{%- else -%}<a href="/policies/terms-of-service">Terms</a>{%- endif -%}
    {%- if shop.privacy_policy.url != blank -%}<a href="{{ shop.privacy_policy.url }}">Privacy</a>{%- else -%}<a href="/policies/privacy-policy">Privacy</a>{%- endif -%}
    {%- if shop.shipping_policy.url != blank -%}<a href="{{ shop.shipping_policy.url }}">Shipping</a>{%- else -%}<a href="/policies/shipping-policy">Shipping</a>{%- endif -%}
    {%- if shop.refund_policy.url != blank -%}<a href="{{ shop.refund_policy.url }}">Refunds</a>{%- else -%}<a href="/policies/refund-policy">Refunds</a>{%- endif -%}
  </div>
</footer>

<style>
  .ns-lbuy { background: #10182B; color: #F2F4F7; padding: clamp(32px,5vw,60px) clamp(14px,4vw,32px); border-top: 1px solid rgba(217,160,75,.35); }
  .ns-lbuy__inner { max-width: 520px; margin: 0 auto; text-align: center; }
  .ns-lbuy__head {
    display: flex; align-items: center; gap: 14px; justify-content: center;
    margin-bottom: clamp(16px,3vw,22px);
  }
  .ns-lbuy__heading { font-size: clamp(22px,4.4vw,32px); letter-spacing: -.02em; font-weight: 800; margin: 0; }
  .ns-lbuy__body {
    font-size: clamp(14px,3vw,15.5px); line-height: 1.55; color: rgba(242,244,247,.65);
    margin: 0 auto 24px; max-width: 460px; text-wrap: pretty;
  }
  .ns-lbuy__body-strong { font-weight: 800; color: #F2F4F7; }

  .ns-lbuy__cta {
    display: inline-block; background: #D9A04B; color: #10182B; text-align: center;
    padding: 15px 34px; border-radius: 999px; font-size: 16px; font-weight: 700;
    text-decoration: none; box-shadow: 0 8px 24px rgba(217,160,75,.25);
    transition: background .2s, box-shadow .2s;
  }
  .ns-lbuy__cta:hover { background: #E5B267; color: #10182B; box-shadow: 0 10px 28px rgba(217,160,75,.32); }
  .ns-lbuy__trust { margin-top: 14px; font-size: 12px; color: rgba(242,244,247,.45); }

  .ns-lbuy__footer { max-width: 860px; margin: 0 auto; padding: clamp(20px,4vw,40px) clamp(14px,4vw,32px); }
  .ns-lbuy__disclaimer { font-size: 11px; line-height: 1.65; color: #8A93A3; max-width: 720px; margin: 0; }
  .ns-lbuy__disclaimer-strong { font-weight: 700; color: #566072; }
  .ns-lbuy__footer-links {
    display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; margin-top: 20px;
    font-size: 12px; color: #8A93A3;
  }
  .ns-lbuy__footer-links a { color: #8A93A3; text-decoration: underline; text-underline-offset: 2px; }
  .ns-lbuy__footer-links a:hover { color: #566072; }
</style>

{% schema %}
{
  "name": "Landing Buy",
  "settings": [
    { "type": "text", "id": "heading", "label": "Guarantee heading", "default": "The NightSeals Guarantee" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Claim your 60-night offer →" },
    { "type": "url", "id": "cta_url", "label": "CTA target", "info": "Defaults to the offer module higher up the page (#tiers)." }
  ],
  "presets": [
    { "name": "Landing Buy" }
  ]
}
{% endschema %}
