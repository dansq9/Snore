<style>
  .ns-lexp__nights {
    max-width: 860px;
    margin: 0 auto;
    padding: clamp(28px, 5vw, 56px) clamp(14px, 4vw, 32px) clamp(40px, 7vw, 88px);
  }

  .ns-lexp__kicker {
    font-size: 11.5px;
    letter-spacing: .24em;
    font-weight: 800;
    color: #B27E33;
    margin-bottom: 14px;
  }

  .ns-lexp__heading {
    font-size: clamp(24px, 4.5vw, 36px);
    letter-spacing: -.02em;
    font-weight: 800;
    margin: 0 0 28px;
    text-wrap: pretty;
  }

  .ns-lexp__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: clamp(16px, 3vw, 24px);
  }

  .ns-lexp__card {
    background: #10182B;
    color: #F2F4F7;
    border-radius: 18px;
    padding: clamp(22px, 4vw, 28px);
  }

  .ns-lexp__card-night {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 12px;
    color: #D9A04B;
    margin-bottom: 10px;
  }

  .ns-lexp__card-title {
    font-size: 16px;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .ns-lexp__card-body {
    font-size: 13.5px;
    line-height: 1.55;
    color: rgba(242, 244, 247, .6);
    margin: 0;
  }

  .ns-lexp__offers {
    max-width: 860px;
    margin: 0 auto;
    padding: clamp(8px, 2vw, 24px) clamp(14px, 4vw, 32px) clamp(40px, 7vw, 88px);
  }

  .ns-lexp__offers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: clamp(16px, 3vw, 24px);
  }

  .ns-lexp__offer {
    background: #F2EDE3;
    border-radius: 24px;
    padding: clamp(28px, 5vw, 40px);
    display: flex;
    flex-direction: column;
    min-height: 360px;
  }

  .ns-lexp__offer--navy {
    background: #10182B;
    color: #F2F4F7;
  }

  .ns-lexp__offer-inner {
    flex: 1;
  }

  .ns-lexp__offer-title {
    font-size: clamp(24px, 4vw, 32px);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 14px;
  }

  .ns-lexp__offer-title-thin {
    font-weight: 400;
  }

  .ns-lexp__offer-body {
    font-size: 14.5px;
    line-height: 1.6;
    color: #566072;
    margin: 0 0 18px;
    text-wrap: pretty;
  }

  .ns-lexp__offer--navy .ns-lexp__offer-body {
    color: rgba(242, 244, 247, .65);
  }

  .ns-lexp__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .ns-lexp__pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(16, 24, 43, .06);
    padding: 5px 12px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 600;
    color: #566072;
  }

  .ns-lexp__pill-check {
    color: #B27E33;
    font-weight: 800;
  }

  .ns-lexp__offer-quote {
    font-family: 'Newsreader', serif;
    font-style: italic;
    font-size: 15px;
    line-height: 1.5;
    color: rgba(242, 244, 247, .5);
    margin: 0;
  }

  .ns-lexp__offer-cta-wrap {
    margin-top: clamp(20px, 4vw, 32px);
  }

  .ns-lexp__cta {
    display: inline-block;
    background: #10182B;
    color: #F2F4F7;
    padding: 14px 28px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: .02em;
  }

  .ns-lexp__cta:hover {
    background: #26314D;
    color: #F2F4F7;
  }

  .ns-lexp__cta--gold {
    background: #D9A04B;
    color: #10182B;
  }

  .ns-lexp__cta--gold:hover {
    background: #E5B267;
    color: #10182B;
  }

  /* Single consolidated mid-page offer band (replaces the old two-card grid). */
  .ns-lexp__band {
    background: #F2EDE3;
    border-radius: 24px;
    padding: clamp(28px, 5vw, 44px);
    display: flex;
    align-items: center;
    gap: clamp(22px, 5vw, 48px);
  }

  .ns-lexp__band-main {
    flex: 1;
    min-width: 0;
  }

  .ns-lexp__band-body {
    font-size: 14.5px;
    line-height: 1.6;
    color: #566072;
    margin: 0 0 18px;
    max-width: 54ch;
    text-wrap: pretty;
  }

  .ns-lexp__band-action {
    flex: none;
    text-align: center;
  }

  .ns-lexp__band-note {
    font-size: 12px;
    color: #8A93A3;
    margin-top: 10px;
  }

  @media (max-width: 640px) {
    .ns-lexp__band {
      flex-direction: column;
      align-items: flex-start;
    }

    .ns-lexp__band-action {
      width: 100%;
    }

    .ns-lexp__band-action .ns-lexp__cta {
      display: block;
    }
  }
</style>

<section class="ns-lexp__nights">
  <div class="ns-lexp__kicker">{{ section.settings.kicker | default: 'YOUR FIRST 30 NIGHTS' }}</div>
  <h2 class="ns-lexp__heading">{{ section.settings.heading | default: 'What to expect when you start' }}</h2>
  <div class="ns-lexp__grid">
    <div class="ns-lexp__card">
      <div class="ns-lexp__card-night">{{ section.settings.card_1_night | default: 'NIGHT 1-3' }}</div>
      <div class="ns-lexp__card-title">{{ section.settings.card_1_title | default: "You'll notice it's there" }}</div>
      <p class="ns-lexp__card-body">{{ section.settings.card_1_body | default: "That's normal. Most people are surprised how gentle it feels. Some wake up with less dry mouth as early as night one." }}</p>
    </div>
    <div class="ns-lexp__card">
      <div class="ns-lexp__card-night">{{ section.settings.card_2_night | default: 'NIGHT 7' }}</div>
      <div class="ns-lexp__card-title">{{ section.settings.card_2_title | default: 'A habit is forming' }}</div>
      <p class="ns-lexp__card-body">{{ section.settings.card_2_body | default: 'Nasal breathing starts to feel natural. Snoring noticeably reducing. Your partner may comment before you notice yourself.' }}</p>
    </div>
    <div class="ns-lexp__card">
      <div class="ns-lexp__card-night">{{ section.settings.card_3_night | default: 'NIGHT 21-30' }}</div>
      <div class="ns-lexp__card-title">{{ section.settings.card_3_title | default: 'A different baseline' }}</div>
      <p class="ns-lexp__card-body">{{ section.settings.card_3_body | default: 'Deeper sleep. Less brain fog. More energy in the morning. This is your sleep now, not a temporary fix.' }}</p>
    </div>
  </div>
</section>

<section class="ns-lexp__offers">
  <div class="ns-lexp__band">
    <div class="ns-lexp__band-main">
      <div class="ns-lexp__offer-title"><span class="ns-lexp__offer-title-thin">{{ section.settings.offer_lead | default: 'Tired of' }}</span> {{ section.settings.offer_head | default: 'waking up exhausted?' }}</div>
      <p class="ns-lexp__band-body">{{ section.settings.offer_body | default: 'Mouth breathing dries your airway, triggers snoring, and fragments your sleep. NightSeals keeps your lips sealed so your nose can do its job. One strip. Three seconds. Every night.' }}</p>
      <div class="ns-lexp__pills">
        <span class="ns-lexp__pill"><span class="ns-lexp__pill-check">✓</span>{{ section.settings.offer_pill_1 | default: 'Beard-proof' }}</span>
        <span class="ns-lexp__pill"><span class="ns-lexp__pill-check">✓</span>{{ section.settings.offer_pill_2 | default: 'Hypoallergenic' }}</span>
        <span class="ns-lexp__pill"><span class="ns-lexp__pill-check">✓</span>{{ section.settings.offer_pill_3 | default: 'No residue' }}</span>
      </div>
    </div>
    <div class="ns-lexp__band-action">
      <a href="#buy" class="ns-lexp__cta ns-lexp__cta--gold">{{ section.settings.offer_cta | default: 'Try NightSeals — from $0.56/night →' }}</a>
      <div class="ns-lexp__band-note">{{ section.settings.offer_note | default: '30-night money-back guarantee' }}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing Expectations",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "YOUR FIRST 30 NIGHTS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What to expect when you start" },
    { "type": "text", "id": "card_1_night", "label": "Card 1 night", "default": "NIGHT 1-3" },
    { "type": "text", "id": "card_1_title", "label": "Card 1 title", "default": "You'll notice it's there" },
    { "type": "textarea", "id": "card_1_body", "label": "Card 1 body", "default": "That's normal. Most people are surprised how gentle it feels. Some wake up with less dry mouth as early as night one." },
    { "type": "text", "id": "card_2_night", "label": "Card 2 night", "default": "NIGHT 7" },
    { "type": "text", "id": "card_2_title", "label": "Card 2 title", "default": "A habit is forming" },
    { "type": "textarea", "id": "card_2_body", "label": "Card 2 body", "default": "Nasal breathing starts to feel natural. Snoring noticeably reducing. Your partner may comment before you notice yourself." },
    { "type": "text", "id": "card_3_night", "label": "Card 3 night", "default": "NIGHT 21-30" },
    { "type": "text", "id": "card_3_title", "label": "Card 3 title", "default": "A different baseline" },
    { "type": "textarea", "id": "card_3_body", "label": "Card 3 body", "default": "Deeper sleep. Less brain fog. More energy in the morning. This is your sleep now, not a temporary fix." },
    { "type": "text", "id": "offer_lead", "label": "Offer title lead (light)", "default": "Tired of" },
    { "type": "text", "id": "offer_head", "label": "Offer title (bold)", "default": "waking up exhausted?" },
    { "type": "textarea", "id": "offer_body", "label": "Offer body", "default": "Mouth breathing dries your airway, triggers snoring, and fragments your sleep. NightSeals keeps your lips sealed so your nose can do its job. One strip. Three seconds. Every night." },
    { "type": "text", "id": "offer_pill_1", "label": "Offer pill 1", "default": "Beard-proof" },
    { "type": "text", "id": "offer_pill_2", "label": "Offer pill 2", "default": "Hypoallergenic" },
    { "type": "text", "id": "offer_pill_3", "label": "Offer pill 3", "default": "No residue" },
    { "type": "text", "id": "offer_cta", "label": "Offer CTA label", "default": "Try NightSeals — from $0.56/night →" },
    { "type": "text", "id": "offer_note", "label": "Offer note", "default": "30-night money-back guarantee" }
  ],
  "presets": [
    { "name": "Landing Expectations" }
  ]
}
{% endschema %}
