  .nsq-info-bullets { display: flex; flex-direction: column; gap: 9px; font-size: 14px; font-weight: 600; }
  .nsq-bullet { display: flex; gap: 10px; align-items: center; }
  .nsq-bullet-dot { flex: none; width: 5px; height: 5px; border-radius: 50%; background: #D9A04B; }

  /* Analyzing */
  .nsq-spinner { position: relative; width: 76px; height: 76px; margin: 0 auto 24px; }
  .nsq-spinner-ring { position: absolute; inset: 0; border-radius: 50%; border: 3px solid rgba(217,160,75,.18); border-top-color: #D9A04B; animation: nsq-spin 1s linear infinite; }
  .nsq-spinner-icon { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
  .nsq-analyzing-h2 { font-size: clamp(21px,6vw,27px); letter-spacing: -.02em; font-weight: 800; margin: 0 0 26px; }
  .nsq-analyze-list { display: flex; flex-direction: column; max-width: 360px; margin: 0 auto; text-align: left; background: #FFFFFF; border: 1px solid rgba(16,24,43,.1); border-radius: 20px; padding: 8px 20px; box-shadow: 0 10px 24px -16px rgba(16,24,43,.18); }
  .nsq-arow { display: flex; align-items: center; gap: 13px; padding: 13px 0; border-bottom: 1px solid rgba(16,24,43,.07); }
  .nsq-arow--last { border-bottom: none; }
  .nsq-acircle { flex: none; width: 26px; height: 26px; border-radius: 50%; border: 2px solid rgba(16,24,43,.2); display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 800; color: transparent; background: transparent; transition: all .3s ease; }
  .nsq-arow.is-done .nsq-acircle { background: #D9A04B; border-color: #D9A04B; color: #10182B; }
  .nsq-alabel { font-size: 14.5px; font-weight: 700; opacity: .35; transition: opacity .3s ease; }
  .nsq-arow.is-done .nsq-alabel { opacity: 1; }

  /* Results 1 */
  .nsq-results-head { text-align: center; margin-bottom: 22px; padding-top: 6px; }
