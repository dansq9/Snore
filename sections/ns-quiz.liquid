  .nsq-results-h2 { font-size: clamp(24px,6.5vw,32px); letter-spacing: -.025em; font-weight: 800; margin: 0; text-wrap: pretty; }
  .nsq-card { background: #FFFFFF; border: 1px solid rgba(16,24,43,.1); border-radius: 24px; padding: clamp(20px,5vw,30px); margin-bottom: 20px; box-shadow: 0 20px 40px -24px rgba(16,24,43,.3); }
  .nsq-level-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 14px; flex-wrap: wrap; }
  .nsq-level-title { font-size: 14.5px; font-weight: 800; margin-bottom: 3px; }
  .nsq-level-sub { font-size: 12px; color: #8A93A3; font-weight: 600; }
  .nsq-level-pill { font-size: 12px; font-weight: 800; letter-spacing: .08em; color: #FFFFFF; background: #3E9E6E; border-radius: 999px; padding: 7px 16px; flex: none; }
  .nsq-meter { position: relative; height: 12px; border-radius: 999px; background: linear-gradient(90deg,#3E9E6E,#B4A83E,#C98A3B,#C4523E); margin: 18px 0 8px; }
  .nsq-meter-tick { position: absolute; top: 0; bottom: 0; width: 2px; background: rgba(255,255,255,.55); }
  .nsq-meter-marker { position: absolute; top: 50%; transform: translate(-50%,-50%); width: 22px; height: 22px; border-radius: 50%; background: #FFFFFF; border: 5px solid #3E9E6E; box-shadow: 0 2px 8px rgba(16,24,43,.35); transition: left .8s cubic-bezier(.2,.8,.2,1); }
  .nsq-meter-labels { display: flex; font-size: 9.5px; letter-spacing: .12em; font-weight: 800; color: #8A93A3; margin-bottom: 22px; }
  .nsq-meter-labels span { width: 25%; text-align: center; }
  .nsq-verdict { background: rgba(217,160,75,.07); border: 1.5px solid rgba(217,160,75,.45); border-radius: 18px; padding: clamp(14px,4vw,18px); }
  .nsq-verdict-head { display: flex; align-items: center; gap: 9px; margin-bottom: 8px; }
  .nsq-verdict-dot { width: 9px; height: 9px; border-radius: 50%; background: #3E9E6E; flex: none; }
  .nsq-verdict-title { font-size: 15.5px; font-weight: 800; }
  .nsq-verdict-body { font-size: 13.5px; line-height: 1.55; color: #566072; margin: 0 0 16px; }
  .nsq-subcards { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,150px),1fr)); gap: 10px; }
  .nsq-subcard { background: #FFFFFF; border: 1px solid rgba(16,24,43,.08); border-radius: 14px; padding: 13px 14px; }
  .nsq-subcard-head { display: flex; align-items: center; gap: 6px; margin-bottom: 5px; }
  .nsq-subcard-label { font-size: 9.5px; letter-spacing: .14em; font-weight: 800; color: #8A93A3; }
  .nsq-subcard-value { font-size: 13.5px; font-weight: 800; line-height: 1.3; }
  .nsq-results-foot { margin-top: 12px; font-size: 12px; font-weight: 600; color: #8A93A3; }

  /* Results 2 */
  .nsq-sol-topbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; min-height: 24px; }
  .nsq-sol-head { text-align: center; margin-bottom: 14px; }
  .nsq-sol-sub { font-family: 'Newsreader', serif; font-style: italic; font-size: 16px; line-height: 1.5; color: #566072; margin: 0 auto; max-width: 400px; }
  .nsq-chips { display: flex; justify-content: center; gap: 8px; flex-wrap: wrap; margin-bottom: 18px; }
  .nsq-chip { font-size: 12px; font-weight: 700; color: #10182B; background: #FFFFFF; border: 1px solid rgba(16,24,43,.14); border-radius: 999px; padding: 7px 14px; }

  .nsq-product { background: #FFFFFF; border: 1px solid rgba(16,24,43,.1); border-radius: 24px; overflow: hidden; margin-bottom: 16px; box-shadow: 0 20px 40px -24px rgba(16,24,43,.3); }
  .nsq-product-media { background: linear-gradient(180deg,#EAEDF2,#F7F8FA); padding: 26px 20px 0; text-align: center; }
  .nsq-pouch-img { width: min(210px,55vw); height: auto; display: block; margin: 0 auto; filter: drop-shadow(0 18px 22px rgba(16,24,43,.3)); }
  .nsq-product-body { padding: 22px clamp(16px,4.5vw,26px) 24px; }
  .nsq-product-titlerow { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 4px; flex-wrap: wrap; }
  .nsq-product-title { font-size: 18px; font-weight: 800; letter-spacing: -.01em; }
  .nsq-product-price { font-size: 13px; font-weight: 800; color: #B27E33; flex: none; }
  .nsq-product-price-unit { color: #8A93A3; font-weight: 700; }
  .nsq-product-rating { font-size: 12px; color: #8A93A3; font-weight: 600; margin-bottom: 12px; }

  .nsq-offer-head { text-align: center; margin-bottom: 14px; }
  .nsq-offer-eyebrow { font-size: 11px; letter-spacing: .18em; font-weight: 800; color: #B27E33; margin-bottom: 8px; }
  .nsq-offer-title { font-size: clamp(20px,5.5vw,26px); font-weight: 800; letter-spacing: -.02em; margin: 0 0 6px; }
  .nsq-offer-sub { font-size: 14px; line-height: 1.5; color: #566072; margin: 0; text-wrap: pretty; }
  .nsq-offer-price { display: flex; align-items: baseline; flex-wrap: wrap; gap: 10px; margin: 2px 0 2px; }
  .nsq-offer-now { font-size: 30px; font-weight: 800; color: #10182B; letter-spacing: -.02em; }
  .nsq-offer-was { font-size: 16px; color: #8A93A3; text-decoration: line-through; }
  .nsq-offer-badge { font-size: 11px; font-weight: 800; letter-spacing: .06em; color: #2E7D4F; background: rgba(46,125,79,.12); padding: 3px 9px; border-radius: 999px; align-self: center; }
  .nsq-offer-pn { font-size: 12.5px; color: #8A93A3; font-weight: 700; margin-bottom: 14px; }
  .nsq-fixlist { display: flex; flex-direction: column; gap: 10px; margin-bottom: 20px; }
  .nsq-fix { display: flex; gap: 11px; align-items: flex-start; }
  .nsq-fix-check { flex: none; width: 20px; height: 20px; border-radius: 50%; background: rgba(217,160,75,.14); border: 1px solid rgba(217,160,75,.4); color: #B27E33; font-size: 11px; font-weight: 800; display: flex; align-items: center; justify-content: center; margin-top: 1px; }
  .nsq-fix-text { font-size: 14px; font-weight: 600; line-height: 1.45; color: #10182B; }
  .nsq-promo { border: 1.5px dashed #D9A04B; background: rgba(217,160,75,.07); border-radius: 16px; padding: 14px 16px; display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 18px; flex-wrap: wrap; }
  .nsq-promo-eyebrow { font-size: 10px; letter-spacing: .18em; font-weight: 800; color: #8A93A3; margin-bottom: 3px; }
  .nsq-promo-copy { font-size: 13.5px; font-weight: 700; color: #10182B; }
  .nsq-promo-code { font-family: ui-monospace, Menlo, monospace; font-size: 15px; font-weight: 700; letter-spacing: .1em; color: #B27E33; background: #FFFFFF; border: 1px solid rgba(217,160,75,.5); border-radius: 10px; padding: 8px 14px; flex: none; }
  .nsq-product-cta { display: block; text-align: center; background: #D9A04B; color: #10182B; padding: 17px 20px; border-radius: 999px; font-size: 16px; font-weight: 800; animation: nsq-pulse 3s ease-in-out infinite; box-shadow: 0 10px 24px -8px rgba(217,160,75,.5); text-decoration: none; transition: background .2s ease; }
  .nsq-product-cta:hover { background: #E5B267; color: #10182B; }
  .nsq-product-guarantee { margin-top: 12px; text-align: center; font-size: 12px; font-weight: 600; color: #8A93A3; line-height: 1.5; }
  .nsq-retake { background: none; border: none; font-family: inherit; font-size: 12.5px; font-weight: 700; color: #8A93A3; cursor: pointer; text-decoration: underline; }
  .nsq-retake:hover { color: #10182B; }
</style>

<script src="{{ 'ns-quiz.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Sleep Quiz",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "offer_product", "label": "Exclusive offer product", "info": "The limited-time offer shown at the end of the quiz (e.g. the 60-night $30 product). Its price, compare-at, image and rating drive the offer card, and 'Claim your offer' adds it to the cart. Falls back to the store's Main product." },
    { "type": "text", "id": "offer_title", "label": "Offer title", "default": "Your exclusive 60-night offer" },
    { "type": "textarea", "id": "offer_sub", "label": "Offer subtitle", "default": "We've set aside a full 60-night supply at our best price, with a 30-night money-back guarantee." },
    { "type": "text", "id": "offer_cta", "label": "Offer button", "default": "Claim your offer →" },
    { "type": "text", "id": "review_name", "label": "Intro review name", "default": "Mark T." },
    { "type": "textarea", "id": "review_quote", "label": "Intro review quote", "default": "I was skeptical, but after one night I slept straight through to 6am for the first time in years. My wife says the snoring is completely gone." }
  ],
  "presets": [
    { "name": "Sleep Quiz" }
  ]
}
{% endschema %}
