  .nsq-info-body { font-size: 15px; line-height: 1.6; color: rgba(242,244,247,.68); margin: 0 0 18px; }
  .nsq-info-body strong { color: #F2F4F7; font-weight: 700; }
  .nsq-info-box { background: rgba(242,244,247,.06); border: 1px solid rgba(242,244,247,.12); border-radius: 18px; padding: 16px 18px; }
