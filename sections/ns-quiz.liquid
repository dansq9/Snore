  .nsq-opt.is-selected { border-color: #D9A04B; background: #FDF8F0; box-shadow: 0 8px 18px -8px rgba(217,160,75,.45); }
  .nsq-opt-chip { flex: none; width: 30px; height: 30px; border-radius: 9px; background: rgba(217,160,75,.12); border: 1px solid rgba(217,160,75,.35); color: #B27E33; font-size: 13px; font-weight: 800; display: flex; align-items: center; justify-content: center; }
  .nsq-q-note { margin-top: 18px; display: flex; gap: 12px; background: rgba(217,160,75,.08); border: 1px solid rgba(217,160,75,.35); border-radius: 16px; padding: 15px 16px; }
  .nsq-q-note-text { font-size: 13px; line-height: 1.55; color: #566072; }
  .nsq-q-note-lead { font-weight: 800; color: #B27E33; }

  /* Navy interstitial cards */
  .nsq-navycard { background: #10182B; color: #F2F4F7; border-radius: 26px; padding: clamp(24px,6vw,36px); box-shadow: 0 24px 48px -20px rgba(16,24,43,.5); }
  .nsq-navycard-h2 { font-size: clamp(22px,6vw,29px); line-height: 1.12; letter-spacing: -.025em; font-weight: 800; margin: 0 0 16px; text-wrap: pretty; }
  .nsq-navycard-serif { font-family: 'Newsreader', serif; font-style: italic; font-size: 15px; line-height: 1.5; color: rgba(242,244,247,.6); margin: 14px 0 0; }
  .nsq-mechlist { display: flex; flex-direction: column; }
  .nsq-mechrow { display: flex; gap: 14px; padding: 13px 0; border-bottom: 1px solid rgba(242,244,247,.1); }
  .nsq-mechrow--last { border-bottom: none; }
  .nsq-mechnum { font-family: ui-monospace, Menlo, monospace; font-size: 12px; color: #D9A04B; font-weight: 700; flex: none; padding-top: 2px; }
  .nsq-mechtext { font-size: 14.5px; line-height: 1.55; color: rgba(242,244,247,.75); }
