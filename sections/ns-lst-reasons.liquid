{%- comment -%}
  ns-lst-reasons — the editorial body of the listicle: an intro paragraph
  then a run of numbered "reason" steps. Each step stacks header -> image ->
  text, with a divider before every step. Optional "video" tiles sit in the
  same flow. Modelled on the Hostage Tape "5 reasons" article; all copy lives
  in blocks so it's fully editable.
{%- endcomment -%}

{%- liquid
  assign ns_offer = section.settings.offer_product
  if ns_offer == blank
    assign ns_offer = collections.all.products.first
  endif
  assign ns_v = ns_offer.selected_or_first_available_variant
-%}

<section class="ns-lstr">
  <div class="ns-lstr__inner">
    {%- if section.settings.intro != blank -%}
      <p class="ns-lstr__intro">{{ section.settings.intro }}</p>
    {%- endif -%}

    {%- if section.settings.intro_image != blank -%}
      <div class="ns-lstr__media ns-lstr__intro-media">
        {{ section.settings.intro_image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: '' }}
      </div>
    {%- elsif request.design_mode -%}
      {%- comment -%} Show the empty slot only in the theme editor, never on the live page. {%- endcomment -%}
      <div class="ns-lstr__media ns-lstr__intro-media">
        <div class="ns-lstr__ph">{{ section.settings.intro_image_placeholder | default: 'Add an image' }}</div>
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'reason' -%}
          <article class="ns-lstr__item" {{ block.shopify_attributes }}>
            {%- if block.settings.number != blank -%}<span class="ns-lstr__num">{{ block.settings.number }}</span>{%- endif -%}
            <h2 class="ns-lstr__title">{{ block.settings.title | default: 'Reason headline' }}</h2>
            <div class="ns-lstr__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', alt: block.settings.title }}
              {%- else -%}
                <div class="ns-lstr__ph">{{ block.settings.placeholder | default: 'Add an image' }}</div>
              {%- endif -%}
            </div>
            <p class="ns-lstr__text">{{ block.settings.body }}</p>
          </article>

        {%- when 'video' -%}
          <div class="ns-lstr__video" {{ block.shopify_attributes }}>
            {%- if block.settings.video != blank -%}
              {{ block.settings.video | video_tag: image_size: '900x', controls: true, playsinline: true, preload: 'metadata' }}
            {%- else -%}
              <div class="ns-lstr__video-thumb">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.caption }}
                {%- else -%}
                  <div class="ns-lstr__ph ns-lstr__ph--video">{{ block.settings.caption | default: 'Video' }}</div>
                {%- endif -%}
                <span class="ns-lstr__play" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
              </div>
            {%- endif -%}
            {%- if block.settings.caption != blank -%}<p class="ns-lstr__video-cap">{{ block.settings.caption }}</p>{%- endif -%}
          </div>

        {%- when 'cta' -%}
          {%- if ns_v != blank and ns_v.id -%}
            <div class="ns-lstr__cta-block" {{ block.shopify_attributes }}>
              <a href="#tiers" class="ns-lstr__cta" data-ns-buy-now data-variant-id="{{ ns_v.id }}">
                <span class="ns-lstr__cta-label">{{ block.settings.label | default: 'Try NightSeals risk-free' }}</span>
                <span class="ns-lstr__cta-price">{{ ns_v.price | money }}{%- if ns_v.compare_at_price > ns_v.price -%}<s>{{ ns_v.compare_at_price | money }}</s>{%- endif -%}</span>
              </a>
              {%- if block.settings.note != blank -%}<p class="ns-lstr__cta-note">{{ block.settings.note }}</p>{%- endif -%}
            </div>
          {%- elsif request.design_mode -%}
            <div class="ns-lstr__cta-block" {{ block.shopify_attributes }}>
              <p class="ns-lstr__cta-note">Set an Offer product on this section to show the inline buy button.</p>
            </div>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}

    {%- if section.settings.footnote != blank -%}
      <p class="ns-lstr__footnote">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

<style>
  .ns-lstr { background: #FFFFFF; padding: clamp(20px,5vw,40px) clamp(16px,5vw,32px); }
  .ns-lstr__inner { max-width: 680px; margin: 0 auto; }

  .ns-lstr__intro {
    font-size: clamp(15px,2.5vw,17.5px);
    line-height: 1.6;
    color: #10182B;
    font-weight: 500;
    margin: 0 auto clamp(20px,4vw,32px);
    max-width: 60ch;
    text-align: center;
    text-wrap: balance;
  }

  /* Each step: header -> image -> text, with a divider before it. */
  .ns-lstr__item {
    padding: clamp(28px,6vw,44px) 0;
    border-top: 1px solid rgba(16,24,43,.12);
  }

  .ns-lstr__num {
    display: inline-block;
    font-size: 12px; font-weight: 800; letter-spacing: .14em;
    color: #B27E33; text-transform: uppercase; margin-bottom: 10px;
  }
  .ns-lstr__title {
    font-size: clamp(21px,3.6vw,28px);
    line-height: 1.18;
    letter-spacing: -.02em;
    font-weight: 800;
    color: #10182B;
    margin: 0 0 clamp(16px,3vw,20px);
    text-wrap: balance;
  }

  .ns-lstr__media { border-radius: 16px; overflow: hidden; background: #EAEDF2; margin: 0 0 clamp(16px,3vw,20px); }
  .ns-lstr__media img { width: 100%; height: auto; display: block; }
  /* Intro image sits between the centered intro and the first step, with a bit
     more breathing room before Reason 1's divider. */
  .ns-lstr__intro-media { margin-bottom: clamp(24px,5vw,36px); }
  .ns-lstr__ph {
    aspect-ratio: 4 / 3;
    display: flex; align-items: center; justify-content: center;
    color: #8A93A3; font-size: 13px; text-align: center; padding: 16px;
  }

  .ns-lstr__text {
    font-size: clamp(15px,2.4vw,16.5px);
    line-height: 1.6;
    color: #566072;
    margin: 0;
    text-wrap: pretty;
  }

  /* Video tile sits in the same flow, with its own divider before it. */
  .ns-lstr__video { padding: clamp(28px,6vw,44px) 0; border-top: 1px solid rgba(16,24,43,.12); }
  .ns-lstr__video-thumb {
    position: relative; border-radius: 16px; overflow: hidden;
    background: #10182B; aspect-ratio: 16 / 10;
  }
  .ns-lstr__video-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ns-lstr__ph--video { aspect-ratio: auto; height: 100%; color: rgba(242,244,247,.6); }
  .ns-lstr__video video { width: 100%; height: auto; border-radius: 16px; display: block; }
  .ns-lstr__play {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
    width: 62px; height: 62px; border-radius: 50%;
    background: rgba(255,255,255,.92); color: #10182B;
    display: flex; align-items: center; justify-content: center;
  }
  .ns-lstr__play svg { width: 26px; height: 26px; margin-left: 3px; }
  .ns-lstr__video-cap { font-size: 13px; font-weight: 600; color: #8A93A3; margin: 10px 0 0; text-align: center; }

  /* Inline buy button — breaks the article rhythm so every scroll depth has a way to buy. */
  .ns-lstr__cta-block { padding: clamp(22px,4vw,30px) 0; text-align: center; }
  .ns-lstr__cta {
    display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap;
    max-width: 460px; margin: 0 auto;
    background: #D9A04B; color: #10182B;
    font-size: clamp(15px,2.4vw,16.5px); font-weight: 800; letter-spacing: -.01em;
    padding: 15px 28px; border-radius: 999px; text-decoration: none;
    box-shadow: 0 10px 26px rgba(217,160,75,.28);
    transition: background .2s, box-shadow .2s;
  }
  .ns-lstr__cta:hover { background: #E5B267; box-shadow: 0 12px 30px rgba(217,160,75,.34); }
  .ns-lstr__cta-price { font-weight: 700; }
  .ns-lstr__cta-price s { opacity: .55; font-weight: 600; margin-left: 6px; }
  .ns-lstr__cta-note { font-size: 12.5px; color: #8A93A3; margin: 11px 0 0; }

  .ns-lstr__footnote { font-size: 11.5px; color: #8A93A3; margin: clamp(24px,5vw,36px) 0 0; line-height: 1.5; border-top: 1px solid rgba(16,24,43,.12); padding-top: clamp(20px,4vw,28px); }
</style>

{% schema %}
{
  "name": "Listicle Reasons",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "offer_product", "label": "Offer product (for inline buy buttons)", "info": "The product the inline buy buttons check out. Falls back to the first product." },
    { "type": "textarea", "id": "intro", "label": "Intro paragraph", "default": "Millions of people quietly wreck their sleep every night without knowing it. Tonight, your mouth will fall open. You won't feel it happen, but tomorrow you will. Here are the reasons it keeps happening, and the simple thing that stops it." },
    { "type": "image_picker", "id": "intro_image", "label": "Intro image (below the intro paragraph)" },
    { "type": "text", "id": "intro_image_placeholder", "label": "Intro image placeholder text", "default": "Add an image" },
    { "type": "textarea", "id": "footnote", "label": "Footnote", "default": "*Based on a survey of NightSeals users. Individual results may vary. NightSeals is a general wellness product and is not intended to diagnose, treat, cure or prevent any disease." }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        { "type": "text", "id": "number", "label": "Number / kicker", "default": "Reason 1" },
        { "type": "text", "id": "title", "label": "Heading", "default": "Reason headline" },
        { "type": "textarea", "id": "body", "label": "Body" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "placeholder", "label": "Image placeholder text", "default": "Add an image" }
      ]
    },
    {
      "type": "video",
      "name": "Video tile",
      "settings": [
        { "type": "video", "id": "video", "label": "Video (optional)" },
        { "type": "image_picker", "id": "image", "label": "Thumbnail (if no video)" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Watch: How to apply NightSeals" }
      ]
    },
    {
      "type": "cta",
      "name": "Inline buy button",
      "settings": [
        { "type": "text", "id": "label", "label": "Button label", "default": "Try NightSeals risk-free" },
        { "type": "text", "id": "note", "label": "Note under button", "default": "60-night supply · 30-night money-back guarantee" }
      ]
    }
  ],
  "presets": [
    { "name": "Listicle Reasons" }
  ]
}
{% endschema %}
