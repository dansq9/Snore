<style>
.ns-contact{max-width:640px;margin:0 auto;padding:clamp(40px,7vw,72px) clamp(16px,4vw,32px) clamp(64px,10vw,112px)}
.ns-contact__kicker{font-size:11.5px;letter-spacing:.24em;font-weight:800;color:#D9A04B;margin:0 0 12px}
.ns-contact__h1{font-size:clamp(28px,5vw,42px);font-weight:800;letter-spacing:-.02em;line-height:1.12;margin:0 0 14px;color:#10182B}
.ns-contact__intro{font-size:16px;line-height:1.7;color:#566072;margin:0 0 32px}
.ns-contact__intro p{margin:0 0 14px}
.ns-contact__intro a{color:#B27E33;text-decoration:underline;text-underline-offset:2px}
.ns-contact__field{margin-bottom:18px}
.ns-contact__row{display:flex;gap:14px;flex-wrap:wrap}
.ns-contact__row .ns-contact__field{flex:1;min-width:180px}
.ns-contact__label{display:block;font-size:13px;font-weight:700;color:#10182B;margin-bottom:8px}
.ns-contact__optional{color:#8A93A3;font-weight:500}
.ns-contact__input,.ns-contact__textarea{width:100%;padding:14px 18px;border:1px solid rgba(16,24,43,.15);border-radius:12px;font-size:15px;font-family:inherit;background:#fff;box-sizing:border-box}
.ns-contact__textarea{min-height:150px;resize:vertical;line-height:1.6}
.ns-contact__input:focus,.ns-contact__textarea:focus{outline:none;border-color:#B27E33}
.ns-contact__submit{background:#10182B;color:#F7F8FA;padding:14px 32px;border-radius:999px;font-size:15px;font-weight:700;border:none;cursor:pointer;font-family:inherit;margin-top:4px}
.ns-contact__submit:hover{background:#26314D}
.ns-contact__errors{background:rgba(194,86,78,.08);border:1px solid rgba(194,86,78,.25);border-radius:12px;padding:12px 16px;margin-bottom:24px;font-size:14px;color:#C2564E}
.ns-contact__errors ul{margin:0;padding-left:18px}
.ns-contact__success{background:rgba(217,160,75,.1);border:1px solid rgba(217,160,75,.35);border-radius:14px;padding:18px 22px;margin-bottom:24px;font-size:15px;color:#10182B;line-height:1.55}
.ns-contact__success strong{font-weight:800}
</style>

<section class="ns-contact">
  <p class="ns-contact__kicker">{{ section.settings.kicker | default: 'CONTACT' }}</p>
  <h1 class="ns-contact__h1">{{ page.title | default: 'Get in touch' }}</h1>

  {% if page.content != blank %}
    <div class="ns-contact__intro rte">{{ page.content }}</div>
  {% else %}
    <p class="ns-contact__intro">Questions about your order or our products? Send us a message and we'll get back to you within one business day.</p>
  {% endif %}

  {% form 'contact' %}
    {% if form.posted_successfully? %}
      <div class="ns-contact__success"><strong>Thanks for reaching out.</strong> Your message has been sent. We'll be in touch soon.</div>
    {% endif %}
    {% if form.errors %}
      <div class="ns-contact__errors">{{ form.errors | default_errors }}</div>
    {% endif %}
    <div class="ns-contact__row">
      <div class="ns-contact__field">
        <label class="ns-contact__label" for="ContactName">Name</label>
        <input type="text" name="contact[name]" id="ContactName" class="ns-contact__input" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" autocomplete="name">
      </div>
      <div class="ns-contact__field">
        <label class="ns-contact__label" for="ContactEmail">Email</label>
        <input type="email" name="contact[email]" id="ContactEmail" class="ns-contact__input" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" autocomplete="email" required>
      </div>
    </div>
    <div class="ns-contact__field">
      <label class="ns-contact__label" for="ContactPhone">Phone <span class="ns-contact__optional">(optional)</span></label>
      <input type="tel" name="contact[phone]" id="ContactPhone" class="ns-contact__input" value="{{ form.phone }}" autocomplete="tel">
    </div>
    <div class="ns-contact__field">
      <label class="ns-contact__label" for="ContactBody">Message</label>
      <textarea name="contact[body]" id="ContactBody" class="ns-contact__textarea" required>{{ form.body }}</textarea>
    </div>
    <button type="submit" class="ns-contact__submit">Send message</button>
  {% endform %}
</section>

{% schema %}
{
  "name": "Contact",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "CONTACT" }
  ]
}
{% endschema %}
