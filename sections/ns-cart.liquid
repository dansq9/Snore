<style>
.ns-cart-page{max-width:800px;margin:0 auto;padding:clamp(40px,7vw,72px) clamp(16px,4vw,32px) clamp(64px,10vw,112px)}
.ns-cart-page__h1{font-size:clamp(28px,5vw,40px);font-weight:800;letter-spacing:-.02em;margin:0 0 32px;color:#10182B}
.ns-cart-page__empty{font-size:16px;color:#566072;margin:0 0 24px}
.ns-cart-page__btn{display:inline-block;background:#10182B;color:#F7F8FA;padding:14px 28px;border-radius:999px;font-size:15px;font-weight:700;text-decoration:none}
.ns-cart-page__btn:hover{background:#26314D}
.ns-cart-page__item{display:flex;gap:20px;padding:24px 0;border-bottom:1px solid rgba(16,24,43,.08)}
.ns-cart-page__img{width:100px;height:100px;border-radius:14px;background:#EAEDF2;overflow:hidden;flex:none}
.ns-cart-page__img img{width:100%;height:100%;object-fit:cover}
.ns-cart-page__details{flex:1}
.ns-cart-page__title{font-size:16px;font-weight:700;margin:0 0 4px}
.ns-cart-page__variant{font-size:14px;color:#566072}
.ns-cart-page__price{font-size:16px;font-weight:700;margin-top:8px}
.ns-cart-page__totals{padding:24px 0;text-align:right}
.ns-cart-page__total-line{font-size:18px;font-weight:800;margin:8px 0}
.ns-cart-page__checkout{display:inline-block;background:#10182B;color:#F7F8FA;padding:16px 36px;border-radius:999px;font-size:16px;font-weight:700;text-decoration:none;margin-top:16px}
.ns-cart-page__checkout:hover{background:#26314D}
</style>

<section class="ns-cart-page">
  <h1 class="ns-cart-page__h1">Your cart</h1>

  {% if cart.item_count == 0 %}
    <p class="ns-cart-page__empty">Your cart is empty.</p>
    <a href="/collections/all" class="ns-cart-page__btn">Continue shopping</a>
  {% else %}
    {% for item in cart.items %}
      <div class="ns-cart-page__item">
        <div class="ns-cart-page__img">
          {% if item.image %}
            {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy' }}
          {% endif %}
        </div>
        <div class="ns-cart-page__details">
          <div class="ns-cart-page__title">{{ item.product.title }}</div>
          <div class="ns-cart-page__variant">{{ item.variant.title }} &times; {{ item.quantity }}</div>
          <div class="ns-cart-page__price">{{ item.final_line_price | money }}</div>
        </div>
      </div>
    {% endfor %}

    <div class="ns-cart-page__totals">
      <div class="ns-cart-page__total-line">Total: {{ cart.total_price | money }}</div>
      <a href="/checkout" class="ns-cart-page__checkout">Checkout</a>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Cart Page"
}
{% endschema %}
