{%- comment -%}
  Dedicated /cart page — mirrors the slide-out cart drawer design as a
  full page. Reuses the drawer's component styles (.ns-cart-item,
  .ns-cart-shipping, .ns-cart-drawer__* — loaded globally via the drawer
  snippet) so the two carts look identical. Quantity/remove update live
  through the Shopify AJAX + Section Rendering API, with a full-reload
  fallback. Server-rendered in Liquid so it also works on first paint.
{%- endcomment -%}

{%- assign free_ship_threshold = 5000 -%}
{%- assign remaining = free_ship_threshold | minus: cart.total_price -%}
{%- assign ship_pct = cart.total_price | times: 100 | divided_by: free_ship_threshold -%}
{%- if ship_pct > 100 -%}{%- assign ship_pct = 100 -%}{%- endif -%}

{%- assign total_savings = 0 -%}
{%- for item in cart.items -%}
  {%- if item.variant.compare_at_price and item.variant.compare_at_price > item.variant.price -%}
    {%- assign line_compare = item.variant.compare_at_price | times: item.quantity -%}
    {%- assign line_sav = line_compare | minus: item.final_line_price -%}
    {%- assign total_savings = total_savings | plus: line_sav -%}
  {%- endif -%}
{%- endfor -%}

{%- comment -%} ── Upsell: highest supply tier in cart → next tier up ── {%- endcomment -%}
{%- assign up_product = settings.featured_product -%}
{%- if up_product == blank -%}{%- assign up_product = collections.all.products.first -%}{%- endif -%}
{%- assign up_best_price = 0 -%}
{%- assign up_best_line = 0 -%}
{%- assign up_best_qty = 1 -%}
{%- assign up_best_variant = null -%}
{%- if up_product -%}
  {%- for item in cart.items -%}
    {%- if item.product.id == up_product.id and item.variant.price > up_best_price -%}
      {%- assign up_best_price = item.variant.price -%}
      {%- assign up_best_line = forloop.index -%}
      {%- assign up_best_qty = item.quantity -%}
      {%- assign up_best_variant = item.variant -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
{%- assign up_next = null -%}
{%- if up_best_price > 0 -%}
  {%- for variant in up_product.variants -%}
    {%- if variant.price > up_best_price -%}
      {%- if up_next == null or variant.price < up_next.price -%}
        {%- assign up_next = variant -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

<section class="ns-cartpage" data-section-id="{{ section.id }}">
  <div class="ns-cartpage__inner" id="ns-cartpage-inner">
    {%- if cart.item_count == 0 -%}
      <div class="ns-cartpage__empty">
        <div class="ns-cart-drawer__empty-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5.5 8h13l-1.2 12H6.7L5.5 8z"/>
            <path d="M9 8V6.5a3 3 0 0 1 6 0V8"/>
          </svg>
        </div>
        <h1 class="ns-cart-drawer__empty-title">Your cart is empty</h1>
        <p class="ns-cart-drawer__empty-subtitle">Better sleep is three seconds a night away.</p>
        <a href="{% render 'shop-url' %}" class="ns-btn-primary">Shop mouth tape</a>
      </div>
    {%- else -%}
      <a href="{% render 'shop-url' %}" class="ns-cartpage__back">&larr; Continue shopping</a>
      <div class="ns-cartpage__head">
        <h1 class="ns-cartpage__title">Your cart</h1>
        <span class="ns-cart-drawer__count">{{ cart.item_count }}</span>
      </div>

      <div class="ns-cartpage__grid">
        {%- comment -%} ── Left: items ── {%- endcomment -%}
        <div class="ns-cartpage__main">
          <div class="ns-cartpage__shipping">
            <p class="ns-cart-shipping__text">
              {%- if remaining > 0 -%}
                You&rsquo;re {{ remaining | money }} away from free U.S. shipping
              {%- else -%}
                <span class="ns-cart-shipping__check">&#10003;</span> You&rsquo;ve unlocked free U.S. shipping
              {%- endif -%}
            </p>
            <div class="ns-cart-shipping__bar">
              <div class="ns-cart-shipping__fill" style="width:{{ ship_pct }}%"></div>
            </div>
          </div>

          <div class="ns-cartpage__items">
            {%- for item in cart.items -%}
              <div class="ns-cart-item ns-cartpage__item">
                <a href="{{ item.url }}" class="ns-cartpage__item-imglink">
                  {%- if item.image -%}
                    {{ item.image | image_url: width: 200 | image_tag: loading: 'lazy', class: 'ns-cart-item__img', alt: item.product.title }}
                  {%- else -%}
                    <span class="ns-cart-item__img" aria-hidden="true"></span>
                  {%- endif -%}
                </a>
                <div class="ns-cart-item__info">
                  <a href="{{ item.url }}" class="ns-cart-item__title">{{ item.product.title }}</a>
                  {%- unless item.variant.title contains 'Default' -%}
                    <div class="ns-cart-item__variant">{{ item.variant.title }}</div>
                  {%- endunless -%}

                  <div class="ns-cart-item__price-row">
                    <span>{{ item.final_line_price | money }}</span>
                    {%- if item.variant.compare_at_price and item.variant.compare_at_price > item.variant.price -%}
                      {%- assign lc = item.variant.compare_at_price | times: item.quantity -%}
                      <span class="ns-cart-item__compare-price">{{ lc | money }}</span>
                      <span class="ns-cart-item__savings">Save {{ lc | minus: item.final_line_price | money }}</span>
                    {%- endif -%}
                  </div>

                  <div class="ns-cartpage__controls">
                    <div class="ns-cart-item__qty">
                      <button class="ns-cart-item__qty-btn" type="button" data-cartpage-qty data-line="{{ forloop.index }}" data-qty="{{ item.quantity | minus: 1 }}" aria-label="Decrease quantity">&minus;</button>
                      <div class="ns-cart-item__qty-val">{{ item.quantity }}</div>
                      <button class="ns-cart-item__qty-btn" type="button" data-cartpage-qty data-line="{{ forloop.index }}" data-qty="{{ item.quantity | plus: 1 }}" aria-label="Increase quantity">+</button>
                    </div>
                    <button class="ns-cart-item__remove" type="button" data-cartpage-remove data-line="{{ forloop.index }}">Remove</button>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>

          {%- comment -%} Upsell — nudge to the next supply tier {%- endcomment -%}
          {%- if up_next -%}
            {%- assign up_cur_nights = up_best_variant.title | split: ' ' | first | plus: 0 -%}
            {%- assign up_next_nights = up_next.title | split: ' ' | first | plus: 0 -%}
            {%- assign up_cur_pn = 0 -%}
            {%- assign up_next_pn = 0 -%}
            {%- if up_cur_nights > 0 -%}{%- assign up_cur_pn = up_best_variant.price | times: 1.0 | divided_by: up_cur_nights | round -%}{%- endif -%}
            {%- if up_next_nights > 0 -%}{%- assign up_next_pn = up_next.price | times: 1.0 | divided_by: up_next_nights | round -%}{%- endif -%}
            <div class="ns-cart-drawer__upsell ns-cartpage__upsell">
              <div class="ns-cart-upsell__card">
                <div class="ns-cart-upsell__body">
                  <span class="ns-cart-upsell__eyebrow">&uarr; Upgrade &amp; save</span>
                  <span class="ns-cart-upsell__label">{{ up_next.title }}</span>
                  {%- if up_cur_pn > 0 and up_next_pn > 0 and up_next_pn < up_cur_pn -%}
                    <span class="ns-cart-upsell__sub">Just {{ up_next_pn | money }}/night &middot; save {{ up_cur_pn | minus: up_next_pn | money }}/night</span>
                  {%- else -%}
                    <span class="ns-cart-upsell__sub">More nights, better value</span>
                  {%- endif -%}
                </div>
                <button type="button" class="ns-cart-upsell__btn" data-cartpage-upgrade data-from-line="{{ up_best_line }}" data-to-id="{{ up_next.id }}" data-qty="{{ up_best_qty }}">Upgrade</button>
              </div>
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} ── Right: summary ── {%- endcomment -%}
        <aside class="ns-cartpage__summary">
          <div class="ns-cartpage__summary-card">
            {%- if total_savings > 0 -%}
              <div class="ns-cartpage__save-row">
                <span>You save</span>
                <span class="ns-cartpage__save-value">{{ total_savings | money }}</span>
              </div>
            {%- endif -%}
            <div class="ns-cart-drawer__subtotal-row">
              <span class="ns-cart-drawer__subtotal-label">Subtotal</span>
              <span class="ns-cart-drawer__subtotal-value">{{ cart.total_price | money }}</span>
            </div>
            <p class="ns-cartpage__tax-note">Shipping &amp; taxes calculated at checkout.</p>

            {%- comment -%} Promo code — sets Shopify's discount cookie for checkout {%- endcomment -%}
            <form class="ns-promo" data-promo-form>
              <button type="button" class="ns-promo__toggle" data-promo-toggle aria-expanded="false">Have a promo code?</button>
              <div class="ns-promo__fields" data-promo-fields hidden>
                <input type="text" class="ns-promo__input" name="discount" placeholder="Promo code" autocomplete="off" autocapitalize="characters" spellcheck="false" aria-label="Promo code">
                <button type="submit" class="ns-promo__apply">Apply</button>
              </div>
              <p class="ns-promo__msg" data-promo-msg hidden></p>
            </form>

            <a href="/checkout" class="ns-cart-drawer__checkout-btn">Checkout</a>
            <p class="ns-cart-drawer__guarantee">30-day money-back guarantee</p>
          </div>
        </aside>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .ns-cartpage {
    max-width: 1080px;
    margin: 0 auto;
    padding: clamp(32px,6vw,64px) clamp(16px,4vw,32px) clamp(56px,9vw,96px);
  }

  .ns-cartpage__head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 clamp(24px,4vw,36px);
  }

  .ns-cartpage__title {
    font-size: clamp(28px,5vw,40px);
    font-weight: 800;
    letter-spacing: -.02em;
    color: #10182B;
    margin: 0;
  }

  .ns-cartpage__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(28px,4vw,44px);
    align-items: start;
  }
  @media (min-width: 861px) {
    .ns-cartpage__grid {
      grid-template-columns: 1.6fr 1fr;
    }
  }

  /* Shipping bar spacing (bar styles reused from the drawer) */
  .ns-cartpage__shipping {
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(16,24,43,.08);
  }

  .ns-cartpage__items {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* Larger thumbnail + roomier row than the compact drawer */
  .ns-cartpage__item {
    gap: 18px;
    padding-bottom: 20px;
  }
  .ns-cartpage__item .ns-cart-item__img {
    width: clamp(88px,14vw,104px);
    height: clamp(88px,14vw,104px);
    display: block;
  }
  .ns-cartpage__item-imglink { flex: none; }
  .ns-cartpage__item .ns-cart-item__title {
    font-size: 15.5px;
    color: #10182B;
    text-decoration: none;
  }
  .ns-cartpage__item .ns-cart-item__title:hover { color: #B27E33; }
  .ns-cartpage__item .ns-cart-item__price-row { margin-top: 2px; }

  .ns-cartpage__controls {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 10px;
  }
  .ns-cartpage__controls .ns-cart-item__qty { margin-top: 0; }
  .ns-cartpage__controls .ns-cart-item__remove { margin-top: 0; }

  .ns-cartpage__back {
    display: inline-block;
    margin: 0 0 18px;
    font-size: 14px;
    font-weight: 600;
    color: #566072;
    text-decoration: none;
  }
  .ns-cartpage__back:hover { color: #B27E33; }

  /* Summary card */
  .ns-cartpage__summary-card {
    background: #fff;
    border: 1px solid rgba(16,24,43,.08);
    border-radius: 18px;
    padding: clamp(22px,3vw,28px);
  }
  @media (min-width: 861px) {
    .ns-cartpage__summary { position: sticky; top: 88px; }
  }

  .ns-cartpage__save-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
    font-weight: 700;
    color: #B27E33;
    margin-bottom: 12px;
  }
  .ns-cartpage__save-value { font-weight: 800; }

  .ns-cartpage__tax-note {
    font-size: 12.5px;
    color: #8A93A3;
    margin: 0 0 16px;
  }

  .ns-cartpage__summary-card .ns-cart-drawer__checkout-btn { padding: 16px; font-size: 16px; }
  .ns-cartpage__summary-card .ns-cart-drawer__guarantee { margin: 12px 0 10px; }

  /* Empty state */
  .ns-cartpage__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(32px,6vw,72px) 20px;
  }
  .ns-cartpage__empty .ns-cart-drawer__empty-title { font-size: clamp(22px,4vw,28px); }

  /* Dim controls while a change is in flight */
  .ns-cartpage.is-loading { opacity: .55; pointer-events: none; }
</style>

<script>
  (function () {
    if (window.__nsCartPageBound) return;
    window.__nsCartPageBound = true;

    function getRoot() { return document.querySelector('.ns-cartpage'); }
    var inFlight = false;

    function route(p) {
      var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
      if (root.charAt(root.length - 1) !== '/') root += '/';
      return root + p;
    }

    function begin() {
      var root = getRoot();
      if (!root || inFlight) return null;
      inFlight = true;
      root.classList.add('is-loading');
      return root.getAttribute('data-section-id');
    }

    function finish() {
      inFlight = false;
      var r = getRoot();
      if (r) r.classList.remove('is-loading');
    }

    /* Replace the cart's inner HTML from a Section Rendering API response. */
    function swap(data, sectionId) {
      var html = data && data.sections && data.sections[sectionId];
      if (!html) { window.location.reload(); return; }
      var doc = new DOMParser().parseFromString(html, 'text/html');
      var fresh = doc.getElementById('ns-cartpage-inner');
      var current = document.getElementById('ns-cartpage-inner');
      if (fresh && current) { current.innerHTML = fresh.innerHTML; }
      else { window.location.reload(); return; }
      /* Keep the header badge + slide-out drawer in sync */
      if (window.NsCart && typeof window.NsCart.render === 'function') window.NsCart.render();
    }

    function change(line, quantity) {
      var sectionId = begin();
      if (sectionId == null) return;
      fetch(route('cart/change.js'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({
          line: parseInt(line, 10),
          quantity: parseInt(quantity, 10),
          sections: sectionId,
          sections_url: window.location.pathname
        })
      })
        .then(function (r) { return r.json(); })
        .then(function (data) { swap(data, sectionId); })
        .catch(function () { window.location.reload(); })
        .finally(finish);
    }

    /* Upgrade to the next tier: add the new variant, then drop the old line. */
    function upgrade(fromLine, toId, qty) {
      var sectionId = begin();
      if (sectionId == null) return;
      fetch(route('cart/add.js'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: [{ id: parseInt(toId, 10), quantity: parseInt(qty, 10) || 1 }] })
      })
        .then(function (r) { return r.json(); })
        .then(function () {
          return fetch(route('cart/change.js'), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({
              line: parseInt(fromLine, 10),
              quantity: 0,
              sections: sectionId,
              sections_url: window.location.pathname
            })
          });
        })
        .then(function (r) { return r.json(); })
        .then(function (data) { swap(data, sectionId); })
        .catch(function () { window.location.reload(); })
        .finally(finish);
    }

    document.addEventListener('click', function (e) {
      var qtyBtn = e.target.closest('[data-cartpage-qty]');
      if (qtyBtn) { change(qtyBtn.getAttribute('data-line'), qtyBtn.getAttribute('data-qty')); return; }
      var rmBtn = e.target.closest('[data-cartpage-remove]');
      if (rmBtn) { change(rmBtn.getAttribute('data-line'), 0); return; }
      var upBtn = e.target.closest('[data-cartpage-upgrade]');
      if (upBtn) {
        upBtn.disabled = true;
        upgrade(upBtn.getAttribute('data-from-line'), upBtn.getAttribute('data-to-id'), upBtn.getAttribute('data-qty'));
        return;
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Cart Page",
  "settings": []
}
{% endschema %}
