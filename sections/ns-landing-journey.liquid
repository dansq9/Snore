<style>
  .ns-ljourney {
    padding: clamp(36px, 6vw, 72px) clamp(14px, 4vw, 32px);
  }

  .ns-ljourney__inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .ns-ljourney__heading {
    font-size: clamp(22px, 4.5vw, 34px);
    letter-spacing: -.02em;
    font-weight: 800;
    margin: 0 0 clamp(28px, 5vw, 44px);
  }

  .ns-ljourney__diagram {
    display: grid;
    grid-template-columns: 1fr 80px 1fr;
    align-items: center;
    gap: 0;
    max-width: 760px;
    margin: 0 auto;
  }

  .ns-ljourney__node {
    text-align: center;
  }

  .ns-ljourney__icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 14px;
  }

  .ns-ljourney__icon--dark {
    background: #10182B;
  }

  .ns-ljourney__icon--gold {
    background: #D9A04B;
  }

  .ns-ljourney__node-title {
    font-size: clamp(18px, 3.5vw, 22px);
    font-weight: 800;
    margin-bottom: 6px;
  }

  .ns-ljourney__node-body {
    font-size: clamp(13.5px, 2.8vw, 15px);
    line-height: 1.55;
    color: #566072;
    margin: 0;
    text-wrap: pretty;
  }

  .ns-ljourney__connector {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-bottom: 60px;
  }

  .ns-ljourney__connector-line {
    width: 100%;
    border-top: 2px dashed rgba(16, 24, 43, .2);
  }

  .ns-ljourney__cta {
    display: inline-block;
    background: #10182B;
    color: #F2F4F7;
    padding: 14px 28px;
    border-radius: 999px;
    font-size: 14.5px;
    font-weight: 700;
    margin-top: clamp(28px, 5vw, 40px);
    text-decoration: none;
  }

  .ns-ljourney__cta:hover {
    background: #26314D;
    color: #F2F4F7;
  }

  .ns-ljourney__band {
    position: relative;
    min-height: min(440px, 90vw);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .ns-ljourney__band-img {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    z-index: 0;
  }

  .ns-ljourney__band-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(to right, rgba(16, 24, 43, .85) 0%, rgba(16, 24, 43, .4) 60%, transparent 100%);
    z-index: 1;
  }

  .ns-ljourney__band-content {
    position: relative;
    z-index: 2;
    max-width: 860px;
    margin: 0 auto;
    padding: clamp(40px, 7vw, 64px) clamp(14px, 4vw, 32px);
    width: 100%;
  }

  .ns-ljourney__band-inner {
    max-width: 400px;
  }

  .ns-ljourney__band-heading {
    font-size: clamp(24px, 4.5vw, 36px);
    font-weight: 800;
    color: #F2F4F7;
    line-height: 1.1;
    margin-bottom: 12px;
    text-wrap: pretty;
  }

  .ns-ljourney__band-sub {
    font-size: clamp(14px, 2.8vw, 16px);
    line-height: 1.55;
    color: rgba(242, 244, 247, .7);
    margin: 0;
    text-wrap: pretty;
  }

  @media (max-width: 700px) {
    .ns-ljourney__diagram {
      grid-template-columns: 1fr;
    }

    .ns-ljourney__connector {
      display: none;
    }
  }
</style>

<section class="ns-ljourney">
  <div class="ns-ljourney__inner">
    <h2 class="ns-ljourney__heading">{{ section.settings.heading | default: "Why fix how you breathe at night?" }}</h2>
    <div class="ns-ljourney__diagram">
      <div class="ns-ljourney__node">
        <div class="ns-ljourney__icon ns-ljourney__icon--dark">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D9A04B" stroke-width="1.8"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        </div>
        <div class="ns-ljourney__node-title">{{ section.settings.node_1_title | default: "Better sleep tonight" }}</div>
        <p class="ns-ljourney__node-body">{{ section.settings.node_1_body | default: "One strip, one change. Your nose takes over and your body finally gets the deep rest it's been missing." }}</p>
      </div>
      <div class="ns-ljourney__connector">
        <div class="ns-ljourney__connector-line"></div>
      </div>
      <div class="ns-ljourney__node">
        <div class="ns-ljourney__icon ns-ljourney__icon--gold">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#10182B" stroke-width="1.8"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
        </div>
        <div class="ns-ljourney__node-title">{{ section.settings.node_2_title | default: "Better mornings ahead" }}</div>
        <p class="ns-ljourney__node-body">{{ section.settings.node_2_body | default: "No dry mouth. No brain fog. No dragging yourself to the coffee machine. Just clarity and energy." }}</p>
      </div>
    </div>
    <a href="#buy" class="ns-ljourney__cta">{{ section.settings.cta_label | default: "Get started" }}</a>
  </div>
</section>

<section class="ns-ljourney__band">
  {%- if section.settings.fullbleed_image != blank -%}
    <img class="ns-ljourney__band-img" src="{{ section.settings.fullbleed_image | image_url: width: 1600 }}" alt="" width="1600" height="900" loading="lazy">
  {%- else -%}
    <img class="ns-ljourney__band-img" src="{{ 'nightseals-lifestyle.png' | asset_url }}" alt="" width="1600" height="900" loading="lazy">
  {%- endif -%}
  <div class="ns-ljourney__band-overlay"></div>
  <div class="ns-ljourney__band-content">
    <div class="ns-ljourney__band-inner">
      <div class="ns-ljourney__band-heading">{{ section.settings.fullbleed_heading | default: "Good sleep changes everything that comes after it" }}</div>
      <p class="ns-ljourney__band-sub">{{ section.settings.fullbleed_sub | default: "Better focus. More patience. Actual energy. It starts with how you breathe at night." }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Landing Journey",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Diagram heading",
      "default": "Why fix how you breathe at night?"
    },
    {
      "type": "text",
      "id": "node_1_title",
      "label": "Node 1 title",
      "default": "Better sleep tonight"
    },
    {
      "type": "textarea",
      "id": "node_1_body",
      "label": "Node 1 body",
      "default": "One strip, one change. Your nose takes over and your body finally gets the deep rest it's been missing."
    },
    {
      "type": "text",
      "id": "node_2_title",
      "label": "Node 2 title",
      "default": "Better mornings ahead"
    },
    {
      "type": "textarea",
      "id": "node_2_body",
      "label": "Node 2 body",
      "default": "No dry mouth. No brain fog. No dragging yourself to the coffee machine. Just clarity and energy."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Get started"
    },
    {
      "type": "image_picker",
      "id": "fullbleed_image",
      "label": "Full-bleed band image"
    },
    {
      "type": "text",
      "id": "fullbleed_heading",
      "label": "Band heading",
      "default": "Good sleep changes everything that comes after it"
    },
    {
      "type": "textarea",
      "id": "fullbleed_sub",
      "label": "Band subtext",
      "default": "Better focus. More patience. Actual energy. It starts with how you breathe at night."
    }
  ],
  "presets": [
    {
      "name": "Landing Journey"
    }
  ]
}
{% endschema %}
