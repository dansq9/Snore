<style>
.ns-pw{max-width:500px;margin:0 auto;padding:clamp(80px,15vw,160px) clamp(16px,4vw,32px);text-align:center}
.ns-pw__wordmark{font-weight:800;font-size:20px;letter-spacing:.16em;margin-bottom:32px;color:#10182B}
.ns-pw__h1{font-size:clamp(24px,4vw,36px);font-weight:800;letter-spacing:-.02em;margin:0 0 14px;color:#10182B}
.ns-pw__desc{font-size:16px;color:#566072;line-height:1.6;margin:0 0 32px}
.ns-pw__form{display:flex;gap:12px;max-width:400px;margin:0 auto}
.ns-pw__input{flex:1;padding:14px 18px;border:1px solid rgba(16,24,43,.15);border-radius:12px;font-size:15px;font-family:inherit;background:#fff}
.ns-pw__input:focus{outline:none;border-color:#B27E33}
.ns-pw__submit{background:#10182B;color:#F7F8FA;padding:14px 24px;border-radius:12px;font-size:15px;font-weight:700;border:none;cursor:pointer;font-family:inherit}
.ns-pw__submit:hover{background:#26314D}
</style>

<section class="ns-pw">
  <div class="ns-pw__wordmark">NIGHTSEALS</div>
  <h1 class="ns-pw__h1">Opening soon</h1>
  <p class="ns-pw__desc">We're getting things ready. Enter the password to access the store.</p>
  {% form 'storefront_password' %}
    <div class="ns-pw__form">
      <input type="password" name="password" placeholder="Password" class="ns-pw__input">
      <button type="submit" class="ns-pw__submit">Enter</button>
    </div>
    {% if form.errors %}
      <p style="color:#C2564E;font-size:14px;margin-top:12px">{{ form.errors | default_errors }}</p>
    {% endif %}
  {% endform %}
</section>

{% schema %}
{
  "name": "Password Page"
}
{% endschema %}
