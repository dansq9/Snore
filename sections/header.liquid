<header class="ns-header" role="banner">
  <nav class="ns-header__inner" aria-label="Main navigation">
    {%- comment -%} Left column {%- endcomment -%}
    <div class="ns-header__left">
      <button class="ns-hamburger ns-mobile-only" aria-label="Open menu" type="button" style="display:none">
        <svg width="22" height="16" viewBox="0 0 22 16" fill="none" aria-hidden="true">
          <line x1="1" y1="1" x2="21" y2="1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <line x1="1" y1="8" x2="21" y2="8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          <line x1="1" y1="15" x2="21" y2="15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    {%- comment -%} Center column — Wordmark {%- endcomment -%}
    <div class="ns-header__center">
      <a href="/" class="ns-header__wordmark">NIGHTSEALS</a>
    </div>

    {%- comment -%} Right column {%- endcomment -%}
    <div class="ns-header__right">
      <div class="ns-header__nav ns-desktop-only">
        <a href="/#how-it-works" class="ns-header__link">How it works</a>
        <a href="/#reviews" class="ns-header__link">Reviews</a>
        <a href="/#faq" class="ns-header__link">FAQ</a>
      </div>

      <a href="{% render 'shop-url' %}" class="ns-header__shop-btn ns-desktop-only">Shop</a>

      <button class="ns-header__cart-btn ns-mobile-only" aria-label="Open cart" type="button" onclick="if(window.NightSeals&&NightSeals.Cart)NightSeals.Cart.open()" style="display:none">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5.5 8h13l-1.2 12H6.7L5.5 8z"/>
          <path d="M9 8V6.5a3 3 0 0 1 6 0V8"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="ns-header__cart-badge">{{ cart.item_count }}</span>
        {%- endif -%}
      </button>
    </div>
  </nav>

  {%- comment -%} Mobile menu {%- endcomment -%}
  <div class="ns-mobile-menu" style="display:none">
    <a href="/#how-it-works" class="ns-mobile-menu__link">How it works</a>
    <a href="/#reviews" class="ns-mobile-menu__link">Reviews</a>
    <a href="/#faq" class="ns-mobile-menu__link">FAQ</a>
    <a href="{% render 'shop-url' %}" class="ns-mobile-menu__link ns-mobile-menu__link--shop">Shop mouth tape &rarr;</a>
  </div>
</header>

<style>
  .ns-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(247,248,250,.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(16,24,43,.08);
  }

  .ns-header__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(16px,4vw,32px);
    height: 64px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
  }

  .ns-header__left {
    display: flex;
    align-items: center;
  }

  .ns-hamburger {
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    color: var(--navy);
    align-items: center;
    justify-content: center;
  }

  .ns-header__center {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ns-header__wordmark {
    font-weight: 800;
    font-size: 16px;
    letter-spacing: .14em;
    color: var(--navy);
    text-decoration: none;
  }
  .ns-header__wordmark:hover {
    color: var(--navy);
  }

  .ns-header__right {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 12px;
  }

  .ns-header__nav {
    align-items: center;
    gap: 28px;
  }

  .ns-header__link {
    font-size: 14px;
    font-weight: 500;
    color: var(--navy);
    text-decoration: none;
    transition: color .15s;
  }
  .ns-header__link:hover {
    color: var(--dark-amber);
  }

  .ns-header__shop-btn {
    background: #10182B;
    color: #F7F8FA;
    padding: 12px 22px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    margin-left: 16px;
    transition: background .15s;
    align-items: center;
    justify-content: center;
  }
  .ns-header__shop-btn:hover {
    background: #26314D;
    color: #F7F8FA;
  }

  .ns-header__cart-btn {
    position: relative;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    color: var(--navy);
    align-items: center;
    justify-content: center;
  }

  .ns-header__cart-badge {
    position: absolute;
    top: -2px;
    right: -6px;
    background: var(--amber);
    color: var(--navy);
    font-size: 10px;
    font-weight: 800;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  /* Mobile menu */
  .ns-mobile-menu {
    flex-direction: column;
    border-top: 1px solid rgba(16,24,43,.08);
    background: rgba(247,248,250,.98);
    padding: 12px clamp(16px,4vw,32px) 20px;
  }

  .ns-mobile-menu__link {
    display: block;
    padding: 14px 0;
    font-size: 16px;
    font-weight: 500;
    color: var(--navy);
    text-decoration: none;
    border-bottom: 1px solid rgba(16,24,43,.06);
  }
  .ns-mobile-menu__link:last-child {
    border-bottom: none;
  }
  .ns-mobile-menu__link:hover {
    color: var(--dark-amber);
  }

  .ns-mobile-menu__link--shop {
    color: var(--amber);
    font-weight: 700;
    border-bottom: none;
    margin-top: 4px;
  }
  .ns-mobile-menu__link--shop:hover {
    color: var(--amber-hover);
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var btn = document.querySelector('.ns-hamburger');
  var menu = document.querySelector('.ns-mobile-menu');
  if (btn && menu) {
    var svgOpen = btn.innerHTML;
    var svgClose = '<svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true"><line x1="3" y1="3" x2="19" y2="19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><line x1="19" y1="3" x2="3" y2="19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';
    btn.addEventListener('click', function() {
      var open = menu.style.display === 'flex';
      menu.style.display = open ? 'none' : 'flex';
      btn.innerHTML = open ? svgOpen : svgClose;
    });
  }
});
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "paragraph",
      "content": "The Shop button links to your Main product, set under Theme settings → Shop."
    }
  ]
}
{% endschema %}
