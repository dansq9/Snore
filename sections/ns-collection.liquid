<style>
.ns-coll{max-width:1200px;margin:0 auto;padding:clamp(40px,7vw,72px) clamp(16px,4vw,32px) clamp(64px,10vw,112px)}
.ns-coll__h1{font-size:clamp(28px,5vw,40px);font-weight:800;letter-spacing:-.02em;margin:0 0 32px;color:#10182B}
.ns-coll__grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:24px}
.ns-coll__card{background:#fff;border:1px solid rgba(16,24,43,.08);border-radius:18px;overflow:hidden;text-decoration:none;color:#10182B}
.ns-coll__card:hover{box-shadow:0 10px 30px rgba(16,24,43,.08)}
.ns-coll__img{aspect-ratio:1;background:#EAEDF2;overflow:hidden}
.ns-coll__img img{width:100%;height:100%;object-fit:cover}
.ns-coll__info{padding:18px 20px}
.ns-coll__name{font-size:16px;font-weight:700;margin:0 0 6px}
.ns-coll__price{font-size:15px;color:#566072}
.ns-coll__empty{font-size:16px;color:#566072}
</style>

<section class="ns-coll">
  <h1 class="ns-coll__h1">{{ collection.title }}</h1>

  {% if collection.products.size > 0 %}
    <div class="ns-coll__grid">
      {% for product in collection.products %}
        <a href="{{ product.url }}" class="ns-coll__card">
          <div class="ns-coll__img">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy' }}
            {% endif %}
          </div>
          <div class="ns-coll__info">
            <div class="ns-coll__name">{{ product.title }}</div>
            <div class="ns-coll__price">{{ product.price | money }}</div>
          </div>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <p class="ns-coll__empty">No products in this collection yet.</p>
  {% endif %}
</section>

{% schema %}
{
  "name": "Collection Page"
}
{% endschema %}
