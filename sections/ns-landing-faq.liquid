<style>
  .ns-lfaq {
    max-width: 860px;
    margin: 0 auto;
    padding: clamp(8px, 2vw, 24px) clamp(14px, 4vw, 32px) clamp(40px, 7vw, 72px);
  }

  .ns-lfaq__kicker {
    font-size: 11.5px;
    letter-spacing: .24em;
    font-weight: 800;
    color: #B27E33;
    margin-bottom: 14px;
  }

  .ns-lfaq__item {
    border-bottom: 1px solid rgba(16, 24, 43, .12);
  }

  .ns-lfaq__item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: clamp(16px, 3vw, 22px) 4px;
    cursor: pointer;
    list-style: none;
  }

  .ns-lfaq__item summary::-webkit-details-marker {
    display: none;
  }

  .ns-lfaq__item summary::marker {
    content: '';
  }

  .ns-lfaq__item summary::after {
    content: '+';
    font-size: 20px;
    color: #B27E33;
    font-weight: 500;
    flex: none;
    line-height: 1;
  }

  .ns-lfaq__item[open] summary::after {
    content: '\2212';
  }

  .ns-lfaq__q {
    font-size: clamp(15px, 3vw, 16.5px);
    font-weight: 600;
    flex: 1;
  }

  .ns-lfaq__a {
    font-size: 14.5px;
    line-height: 1.65;
    color: #566072;
    margin: -6px 0 0;
    padding: 0 40px 22px 4px;
    text-wrap: pretty;
  }

  .ns-lfaq__trust {
    background: #10182B;
    padding: clamp(32px, 5vw, 56px) clamp(14px, 4vw, 32px);
  }

  .ns-lfaq__trust-inner {
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-around;
    gap: clamp(24px, 4vw, 40px);
  }

  .ns-lfaq__trust-item {
    text-align: center;
    flex: 1;
    min-width: 120px;
  }

  .ns-lfaq__trust-icon {
    margin-bottom: 10px;
  }

  .ns-lfaq__trust-label {
    font-size: 13.5px;
    font-weight: 700;
    color: #F2F4F7;
  }
</style>

<section class="ns-lfaq">
  <div class="ns-lfaq__kicker">{{ section.settings.kicker | default: 'COMMON QUESTIONS' }}</div>
  <div class="ns-lfaq__list">
    <details class="ns-lfaq__item">
      <summary><span class="ns-lfaq__q">{{ section.settings.faq_1_q | default: 'Is mouth taping safe?' }}</span></summary>
      <p class="ns-lfaq__a">{{ section.settings.faq_1_a | default: "For healthy adults who can breathe comfortably through their nose, yes. NightSeals uses a gentle, hypoallergenic adhesive and peels off easily. It's not for children, and it's not a treatment for sleep apnea. If you suspect you have it, talk to your doctor first." }}</p>
    </details>
    <details class="ns-lfaq__item">
      <summary><span class="ns-lfaq__q">{{ section.settings.faq_2_q | default: 'What if my nose gets congested?' }}</span></summary>
      <p class="ns-lfaq__a">{{ section.settings.faq_2_a | default: 'Skip that night. Tape is for nights you can breathe freely through your nose. Many sleepers pair NightSeals with a hot shower or nasal rinse before bed during allergy season.' }}</p>
    </details>
    <details class="ns-lfaq__item">
      <summary><span class="ns-lfaq__q">{{ section.settings.faq_3_q | default: 'Will it rip off my beard?' }}</span></summary>
      <p class="ns-lfaq__a">{{ section.settings.faq_3_a | default: 'No. The adhesive is engineered to hold overnight but release cleanly, even through a full beard. No residue, no wax-strip moments.' }}</p>
    </details>
    <details class="ns-lfaq__item">
      <summary><span class="ns-lfaq__q">{{ section.settings.faq_5_q | default: "What's the return policy?" }}</span></summary>
      <p class="ns-lfaq__a">{{ section.settings.faq_5_a | default: "Try it for 30 nights. If you're not sleeping quieter and waking up better, email us and we'll refund every cent. No return label, no questions. This is not medical advice." }}</p>
    </details>
  </div>
</section>

{%- comment -%}
  Trust bar removed: 30-night guarantee / ships 3-5 / hypoallergenic / better
  sleep duplicated the product-hero trust line and the buy-section trust line,
  and added another navy block right before the navy buy closer.
{%- endcomment -%}

{% schema %}
{
  "name": "Landing FAQ",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "COMMON QUESTIONS" },
    { "type": "text", "id": "faq_1_q", "label": "FAQ 1 question", "default": "Is mouth taping safe?" },
    { "type": "textarea", "id": "faq_1_a", "label": "FAQ 1 answer", "default": "For healthy adults who can breathe comfortably through their nose, yes. NightSeals uses a gentle, hypoallergenic adhesive and peels off easily. It's not for children, and it's not a treatment for sleep apnea. If you suspect you have it, talk to your doctor first." },
    { "type": "text", "id": "faq_2_q", "label": "FAQ 2 question", "default": "What if my nose gets congested?" },
    { "type": "textarea", "id": "faq_2_a", "label": "FAQ 2 answer", "default": "Skip that night. Tape is for nights you can breathe freely through your nose. Many sleepers pair NightSeals with a hot shower or nasal rinse before bed during allergy season." },
    { "type": "text", "id": "faq_3_q", "label": "FAQ 3 question", "default": "Will it rip off my beard?" },
    { "type": "textarea", "id": "faq_3_a", "label": "FAQ 3 answer", "default": "No. The adhesive is engineered to hold overnight but release cleanly, even through a full beard. No residue, no wax-strip moments." },
    { "type": "text", "id": "faq_4_q", "label": "FAQ 4 question", "default": "Can I open my mouth if I need to?" },
    { "type": "textarea", "id": "faq_4_a", "label": "FAQ 4 answer", "default": "Yes. It's a reminder, not a lock. A gentle yawn or deliberate effort parts your lips easily. It just prevents the unconscious falling-open while you sleep." },
    { "type": "text", "id": "faq_5_q", "label": "FAQ 5 question", "default": "What's the return policy?" },
    { "type": "textarea", "id": "faq_5_a", "label": "FAQ 5 answer", "default": "Try it for 30 nights. If you're not sleeping quieter and waking up better, email us and we'll refund every cent. No return label, no questions. This is not medical advice." },
    { "type": "text", "id": "trust_1_label", "label": "Trust item 1 label", "default": "30-Night Guarantee" },
    { "type": "text", "id": "trust_2_label", "label": "Trust item 2 label", "default": "Ships in 3-5 Days" },
    { "type": "text", "id": "trust_3_label", "label": "Trust item 3 label", "default": "Hypoallergenic" },
    { "type": "text", "id": "trust_4_label", "label": "Trust item 4 label", "default": "Better Sleep" }
  ],
  "presets": [
    { "name": "Landing FAQ" }
  ]
}
{% endschema %}
