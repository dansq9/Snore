<style>
  .ns-pdp {
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(28px, 5vw, 48px) 24px;
  }

  .ns-pdp__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    column-gap: clamp(32px, 5vw, 56px);
    row-gap: clamp(16px, 4vw, 28px);
  }

  /* ── Left column: Gallery ── */

  .ns-pdp__gallery {
    position: relative;
  }

  @media (min-width: 801px) {
    .ns-pdp__gallery {
      position: sticky;
      top: 96px;
      align-self: start;
    }
  }

  .ns-pdp__main-img {
    height: min(460px, 100vw);
    border-radius: 22px;
    overflow: hidden;
    background: #EAEDF2;
  }

  .ns-pdp__main-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ns-pdp__img-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #8A93A3;
    font-size: 14px;
  }

  .ns-pdp__thumbs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: 14px;
  }

  .ns-pdp__thumb {
    height: min(120px, 28vw);
    border-radius: 14px;
    overflow: hidden;
    background: #EAEDF2;
    border: 2px solid transparent;
    padding: 0;
    width: 100%;
    cursor: pointer;
    display: block;
    transition: border-color .15s;
  }

  .ns-pdp__thumb--active {
    border-color: #10182B;
  }

  .ns-pdp__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ns-pdp__thumb-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #8A93A3;
    font-size: 12px;
  }

  .ns-pdp__brand {
    margin-top: 18px;
  }

  .ns-pdp__wordmark {
    font-weight: 800;
    font-size: clamp(20px, 2.6vw, 26px);
    letter-spacing: .18em;
    color: #10182B;
    margin: 0;
  }

  .ns-pdp__stars-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
  }

  .ns-pdp__stars-icons {
    color: #D9A04B;
    font-size: 16px;
    letter-spacing: 2px;
  }

  .ns-pdp__stars-link {
    font-size: 13.5px;
    font-weight: 600;
    color: #566072;
    text-decoration: none;
  }

  .ns-pdp__stars-link:hover {
    text-decoration: underline;
  }

  .ns-pdp__price-line {
    font-size: 14px;
    color: #8A93A3;
    margin-top: 4px;
  }

  /* ── Right column: Buy box ── */

  .ns-pdp__buybox {
    display: flex;
    flex-direction: column;
  }

  .ns-pdp__description {
    font-size: clamp(20px, 2.2vw, 24px);
    font-weight: 700;
    line-height: 1.35;
    color: #10182B;
    margin: 0;
  }

  .ns-pdp__highlight {
    background: #10182B;
    color: #F7F8FA;
    padding: 1px 8px 3px;
    border-radius: 4px;
    display: inline-block;
  }

  /* Benefit pills */

  .ns-pdp__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 22px 0;
  }

  .ns-pdp__pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border-radius: 999px;
    background: #fff;
    border: 1.5px solid rgba(16, 24, 43, .13);
    font-size: 13px;
    font-weight: 600;
    color: #10182B;
  }

  .ns-pdp__pill-check {
    color: #B27E33;
    font-weight: 800;
  }

  /* Tier selector */

  .ns-pdp__tier-label {
    font-size: 12px;
    letter-spacing: .16em;
    font-weight: 700;
    color: #8A93A3;
    text-transform: uppercase;
    margin: 0 0 14px;
  }

  .ns-pdp__tiers {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ns-pdp__tier {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 20px;
    border-radius: 16px;
    cursor: pointer;
    border: 2px solid rgba(16, 24, 43, .15);
    background: transparent;
    transition: border .2s, box-shadow .2s;
  }

  .ns-pdp__tier--active {
    border-color: #B27E33;
    background: #fff;
    box-shadow: 0 10px 30px rgba(16, 24, 43, .10);
  }

  .ns-pdp__tier-badge {
    position: absolute;
    top: -11px;
    left: 20px;
    font-size: 10.5px;
    letter-spacing: .12em;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 999px;
    text-transform: uppercase;
    color: #fff;
  }

  .ns-pdp__tier-badge--popular {
    background: #10182B;
  }

  .ns-pdp__tier-badge--value {
    background: #D9A04B;
    color: #10182B;
  }

  .ns-pdp__tier-left {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .ns-pdp__radio {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 2px solid rgba(16, 24, 43, .25);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color .2s;
  }

  .ns-pdp__tier--active .ns-pdp__radio {
    border-color: #B27E33;
  }

  .ns-pdp__radio-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #B27E33;
    opacity: 0;
    transition: opacity .2s;
  }

  .ns-pdp__tier--active .ns-pdp__radio-dot {
    opacity: 1;
  }

  .ns-pdp__tier-title {
    font-size: 16.5px;
    font-weight: 700;
    color: #10182B;
    margin: 0;
  }

  .ns-pdp__tier-per-night {
    font-size: 13px;
    color: #8A93A3;
    margin: 2px 0 0;
  }

  .ns-pdp__tier-right {
    text-align: right;
  }

  .ns-pdp__tier-save {
    font-size: 10px;
    letter-spacing: .08em;
    font-weight: 700;
    color: #B27E33;
    text-transform: uppercase;
    margin-bottom: 2px;
  }

  .ns-pdp__tier-price {
    font-size: 19px;
    font-weight: 800;
    color: #10182B;
  }

  .ns-pdp__tier-compare {
    font-size: 13.5px;
    color: #8A93A3;
    text-decoration: line-through;
  }

  /* Subscribe & Save */

  .ns-pdp__purchase-label {
    font-size: 12px;
    letter-spacing: .16em;
    font-weight: 700;
    color: #8A93A3;
    text-transform: uppercase;
    margin: 22px 0 14px;
  }

  .ns-pdp__purchase-toggle {
    border: 2px solid rgba(16, 24, 43, .12);
    border-radius: 16px;
    overflow: hidden;
    margin-top: 0;
  }

  .ns-pdp__purchase-option {
    padding: 14px 18px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ns-pdp__purchase-option:first-child {
    border-bottom: 1.5px solid rgba(16, 24, 43, .10);
  }

  .ns-pdp__purchase-radio {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid rgba(16, 24, 43, .25);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color .2s;
  }

  .ns-pdp__purchase-radio--active {
    border-color: #B27E33;
  }

  .ns-pdp__purchase-radio-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #B27E33;
    opacity: 0;
    transition: opacity .2s;
  }

  .ns-pdp__purchase-radio--active .ns-pdp__purchase-radio-dot {
    opacity: 1;
  }

  .ns-pdp__purchase-text {
    font-size: 14.5px;
    font-weight: 600;
    color: #10182B;
  }

  .ns-pdp__sub-badge {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: .08em;
    background: #D9A04B;
    color: #fff;
    padding: 2px 8px;
    border-radius: 999px;
    margin-left: 8px;
    text-transform: uppercase;
    display: inline-block;
    vertical-align: middle;
  }

  .ns-pdp__sub-desc {
    font-size: 12.5px;
    color: #8A93A3;
    padding: 0 18px 14px 48px;
    display: none;
  }

  .ns-pdp__sub-desc--visible {
    display: block;
  }

  /* Dual CTA buttons */

  .ns-pdp__ctas {
    display: grid;
    /* Primary gets a little more room so "Buy now · $XX.XX" stays on one line. */
    grid-template-columns: 1.4fr 1fr;
    gap: 10px;
    margin-top: 22px;
  }

  .ns-pdp__btn-buy {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: #10182B;
    color: #F7F8FA;
    font-size: clamp(12.5px, 3.2vw, 15px);
    font-weight: 700;
    padding: 15px 14px;
    border-radius: 999px;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity .2s;
  }

  .ns-pdp__btn-buy:hover {
    opacity: 0.88;
  }

  .ns-pdp__btn-buy-sep {
    opacity: 0.45;
  }

  .ns-pdp__btn-buy-price {
    color: #E8B25E;
    font-weight: 800;
  }

  .ns-pdp__btn-cart {
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: #10182B;
    font-size: clamp(12.5px, 3.2vw, 15px);
    font-weight: 700;
    padding: 15px 14px;
    border-radius: 999px;
    border: 2px solid rgba(16, 24, 43, .18);
    cursor: pointer;
    white-space: nowrap;
    transition: opacity .2s;
  }

  .ns-pdp__btn-cart:hover {
    opacity: 0.88;
  }

  /* Trust line */

  .ns-pdp__trust {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 10px;
    margin-top: 16px;
    font-size: 12.5px;
    color: #8A93A3;
    font-weight: 500;
  }

  /* Each phrase stays intact; the dot rides with it as a trailing separator so
     a wrapped line never begins (or ends) with an orphaned dot. */
  .ns-pdp__trust-item {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }

  .ns-pdp__trust-item:not(:last-child)::after {
    content: "";
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #D9A04B;
    margin-left: 10px;
    flex: none;
  }

  /* Accordions */

  .ns-pdp__accordions {
    margin-top: 32px;
    border-top: 1.5px solid rgba(16, 24, 43, .10);
  }

  .ns-pdp__accordion {
    border-bottom: 1.5px solid rgba(16, 24, 43, .10);
  }

  .ns-pdp__accordion summary {
    padding: 18px 0;
    font-size: 15px;
    font-weight: 700;
    color: #10182B;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
  }

  .ns-pdp__accordion summary::-webkit-details-marker {
    display: none;
  }

  .ns-pdp__accordion summary::marker {
    display: none;
    content: '';
  }

  .ns-pdp__accordion summary::after {
    content: '+';
    font-size: 20px;
    font-weight: 600;
    color: #B27E33;
    transition: transform .2s;
    flex-shrink: 0;
    margin-left: 12px;
  }

  .ns-pdp__accordion[open] summary::after {
    content: '\2212';
  }

  .ns-pdp__accordion-body {
    padding: 0 0 18px;
    font-size: 14px;
    line-height: 1.65;
    color: #566072;
  }

  /* Hidden form */

  .ns-pdp__form {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }
</style>

<section class="ns-pdp">
  <div class="ns-pdp__grid">

    <!-- ── Left column: Gallery ── -->
    <div class="ns-pdp__gallery">
      {%- if product != blank and product.images.size > 0 -%}
        {%- comment -%} Real product gallery — main image + clickable thumbnails {%- endcomment -%}
        <div class="ns-pdp__main-img">
          <img id="ns-pdp-main-img"
               src="{{ product.featured_image | image_url: width: 1200 }}"
               alt="{{ product.featured_image.alt | escape | default: product.title }}"
               width="1200" height="1200" loading="eager">
        </div>
        {%- if product.images.size > 1 -%}
          <div class="ns-pdp__thumbs">
            {%- for image in product.images limit: 4 -%}
              <button type="button" class="ns-pdp__thumb{% if image == product.featured_image %} ns-pdp__thumb--active{% endif %}" data-pdp-thumb data-full="{{ image | image_url: width: 1200 }}" aria-label="Show image {{ forloop.index }}">
                {{ image | image_url: width: 400 | image_tag: loading: 'lazy', alt: image.alt }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- else -%}
        {%- comment -%} No product images yet — bundled pouch renders (+ any theme-editor images) {%- endcomment -%}
        {%- assign fb_main = section.settings.main_image -%}
        {%- if fb_main != blank -%}{%- assign fb_main_url = fb_main | image_url: width: 1200 -%}{%- else -%}{%- assign fb_main_url = 'nightseals-pouch.png' | asset_url -%}{%- endif -%}
        {%- if section.settings.thumb_1 != blank -%}{%- assign fb_thumb2_url = section.settings.thumb_1 | image_url: width: 1200 -%}{%- else -%}{%- assign fb_thumb2_url = 'nightseals-pouch-nobg.png' | asset_url -%}{%- endif -%}
        <div class="ns-pdp__main-img">
          <img id="ns-pdp-main-img" src="{{ fb_main_url }}" alt="{{ product.title | default: 'NightSeals' }}" width="1200" height="1200" loading="eager">
        </div>
        <div class="ns-pdp__thumbs">
          <button type="button" class="ns-pdp__thumb ns-pdp__thumb--active" data-pdp-thumb data-full="{{ fb_main_url }}" aria-label="Show image 1">
            <img src="{{ fb_main_url }}" alt="" width="400" height="400" loading="lazy">
          </button>
          <button type="button" class="ns-pdp__thumb" data-pdp-thumb data-full="{{ fb_thumb2_url }}" aria-label="Show image 2">
            <img src="{{ fb_thumb2_url }}" alt="" width="400" height="400" loading="lazy">
          </button>
          {%- if section.settings.thumb_2 != blank -%}
            <button type="button" class="ns-pdp__thumb" data-pdp-thumb data-full="{{ section.settings.thumb_2 | image_url: width: 1200 }}" aria-label="Show image 3">
              {{ section.settings.thumb_2 | image_url: width: 400 | image_tag: loading: 'lazy' }}
            </button>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="ns-pdp__brand">
        <p class="ns-pdp__wordmark">NIGHTSEALS</p>
        <div class="ns-pdp__stars-row">
          <span class="ns-pdp__stars-icons">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          <a href="#reviews" class="ns-pdp__stars-link">4.8 &middot; 2,341 reviews</a>
        </div>
        <p class="ns-pdp__price-line">From $24.95 &middot; as low as $0.56 a night</p>
      </div>
    </div>

    <!-- ── Right column: Buy box ── -->
    <div class="ns-pdp__buybox">

      <!-- Hidden product form -->
      {%- if product != blank -%}
      {%- assign ns_default_variant = product.variants[1] | default: product.selected_or_first_available_variant -%}
      <div class="ns-pdp__form">
        {% form 'product', product, id: 'product-form' %}
          <input type="hidden" name="id" value="{{ ns_default_variant.id }}" id="ns-variant-input">
        {% endform %}
      </div>
      {%- endif -%}

      <!-- Description -->
      <p class="ns-pdp__description">
        Gentle, <span class="ns-pdp__highlight">beard-proof</span> strips that keep your lips sealed overnight, so your nose does the breathing.
      </p>

      <!-- Benefit pills -->
      <div class="ns-pdp__pills">
        <span class="ns-pdp__pill"><span class="ns-pdp__pill-check">&#10003;</span> May reduce snoring</span>
        <span class="ns-pdp__pill"><span class="ns-pdp__pill-check">&#10003;</span> No dry mouth</span>
        <span class="ns-pdp__pill"><span class="ns-pdp__pill-check">&#10003;</span> Beard-proof hold</span>
        <span class="ns-pdp__pill"><span class="ns-pdp__pill-check">&#10003;</span> 3 seconds a night</span>
      </div>

      <!-- Tier selector -->
      <p class="ns-pdp__tier-label" id="tiers">CHOOSE YOUR SUPPLY</p>
      {%- if product == blank or product.variants.size == 0 -%}
        <div class="ns-pdp__tiers">
          <div class="ns-pdp__tier ns-pdp__tier--active">
            <div class="ns-pdp__tier-left">
              <div>
                <p class="ns-pdp__tier-title">Add a product to see supply options</p>
                <p class="ns-pdp__tier-per-night">Create the NightSeals product with 30/90/180-night variants in Shopify admin.</p>
              </div>
            </div>
          </div>
        </div>
      {%- else -%}
      <div class="ns-pdp__tiers">
        {% for variant in product.variants %}
          {%- assign sp_alloc = variant.selling_plan_allocations.first -%}
          {%- comment -%} Per-night = variant price ÷ nights (parsed from the title, e.g. "90 Nights"); metafield wins if set {%- endcomment -%}
          {%- assign nights_count = variant.title | split: ' ' | first | plus: 0 -%}
          {%- assign per_night_label = '' -%}
          {%- if variant.metafields.custom.per_night != blank -%}
            {%- assign per_night_label = variant.metafields.custom.per_night | append: ' / night' -%}
          {%- elsif nights_count > 0 -%}
            {%- assign per_night_cents = variant.price | times: 1.0 | divided_by: nights_count | round -%}
            {%- assign per_night_label = per_night_cents | money | append: ' / night' -%}
          {%- endif -%}
          {%- assign sub_per_night_label = '' -%}
          {%- if sp_alloc and nights_count > 0 -%}
            {%- assign sub_per_night_cents = sp_alloc.price | times: 1.0 | divided_by: nights_count | round -%}
            {%- assign sub_per_night_label = sub_per_night_cents | money | append: ' / night' -%}
          {%- endif -%}
          <div
            class="ns-pdp__tier{% if variant.id == ns_default_variant.id %} ns-pdp__tier--active{% endif %}"
            data-variant-id="{{ variant.id }}"
            data-variant-price="{{ variant.price | money }}"
            data-per-night="{{ per_night_label }}"
            {%- if nights_count > 0 %} data-nights="{{ nights_count }}"{% endif -%}
            {%- if sp_alloc %} data-sub-plan="{{ sp_alloc.selling_plan_id }}" data-sub-price="{{ sp_alloc.price | money }}" data-sub-per-night="{{ sub_per_night_label }}"{% endif -%}
          >
            {%- if forloop.index == 2 -%}
              <span class="ns-pdp__tier-badge ns-pdp__tier-badge--popular">MOST POPULAR</span>
            {%- elsif forloop.index == 3 -%}
              <span class="ns-pdp__tier-badge ns-pdp__tier-badge--value">BEST VALUE</span>
            {%- endif -%}

            <div class="ns-pdp__tier-left">
              <div class="ns-pdp__radio">
                <span class="ns-pdp__radio-dot"></span>
              </div>
              <div>
                <p class="ns-pdp__tier-title">{{ variant.title }}</p>
                <p class="ns-pdp__tier-per-night">{{ per_night_label }}</p>
              </div>
            </div>

            <div class="ns-pdp__tier-right">
              {%- if variant.compare_at_price > variant.price -%}
                {%- assign savings = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price -%}
                <div class="ns-pdp__tier-save">SAVE {{ savings }}%</div>
              {%- endif -%}
              <div class="ns-pdp__tier-price">{{ variant.price | money }}</div>
              {%- if variant.compare_at_price > variant.price -%}
                <div class="ns-pdp__tier-compare">{{ variant.compare_at_price | money }}</div>
              {%- endif -%}
            </div>
          </div>
        {% endfor %}
      </div>
      {%- endif -%}

      <!-- Subscribe & Save toggle — only when the product has selling plans (Recharge/Loop) -->
      {%- if product.selling_plan_groups.size > 0 -%}
      <p class="ns-pdp__purchase-label">PURCHASE TYPE</p>
      <div class="ns-pdp__purchase-toggle">
        <div class="ns-pdp__purchase-option" data-purchase="onetime">
          <div class="ns-pdp__purchase-radio ns-pdp__purchase-radio--active">
            <span class="ns-pdp__purchase-radio-dot"></span>
          </div>
          <span class="ns-pdp__purchase-text">One-time purchase</span>
        </div>
        <div class="ns-pdp__purchase-option" data-purchase="subscribe">
          <div class="ns-pdp__purchase-radio">
            <span class="ns-pdp__purchase-radio-dot"></span>
          </div>
          <span class="ns-pdp__purchase-text">Subscribe &amp; Save<span class="ns-pdp__sub-badge">SAVE MORE</span></span>
        </div>
        <div class="ns-pdp__sub-desc" id="ns-sub-desc">
          A fresh pouch delivered on your schedule. Skip, pause or cancel anytime.
        </div>
      </div>
      {%- endif -%}

      <!-- Dual CTA buttons -->
      <div class="ns-pdp__ctas">
        <button type="button" class="ns-pdp__btn-buy" id="ns-buy-now">
          <span class="ns-pdp__btn-buy-label">Buy now</span>
          {%- if ns_default_variant -%}
            <span class="ns-pdp__btn-buy-sep" aria-hidden="true">&middot;</span>
            <span class="ns-pdp__btn-buy-price">{{ ns_default_variant.price | money }}</span>
          {%- endif -%}
        </button>
        <button type="button" class="ns-pdp__btn-cart" data-add-to-cart>
          Add to cart
        </button>
      </div>

      <!-- Trust line -->
      <div class="ns-pdp__trust">
        <span class="ns-pdp__trust-item">100% money-back</span>
        <span class="ns-pdp__trust-item">Free shipping $50+</span>
        <span class="ns-pdp__trust-item">Ships in 3-5 days</span>
      </div>

      <!-- Product accordions -->
      <div class="ns-pdp__accordions">
        <details class="ns-pdp__accordion">
          <summary>How to apply</summary>
          <div class="ns-pdp__accordion-body">
            Peel the backing strip apart to expose the adhesive. Place onto dry, lightly pursed lips and press to secure. Sleep comfortably &mdash; the flexible design stays put all night. In the morning, lift a corner and peel gently sideways.
          </div>
        </details>

        <details class="ns-pdp__accordion">
          <summary>Materials &amp; safety</summary>
          <div class="ns-pdp__accordion-body">
            Soft, breathable, latex-free fabric with a hypoallergenic, skin-safe acrylic adhesive. For adults who can breathe comfortably through their nose. Skip nights when you're congested or have had a heavy night out.
          </div>
        </details>

        <details class="ns-pdp__accordion">
          <summary>Shipping &amp; returns</summary>
          <div class="ns-pdp__accordion-body">
            Orders ship within 24-48 hours from U.S. warehouses, free over $50. Try it for 30 nights. If it's not for you, email us for a full refund. No return label needed.
          </div>
        </details>

        <details class="ns-pdp__accordion">
          <summary>Disclaimer</summary>
          <div class="ns-pdp__accordion-body">
            NightSeals is not a medical device and is not intended to diagnose, treat, cure, or prevent any disease or health condition. Do not use if you have difficulty breathing through your nose, severe heart or breathing problems, or after consuming alcohol or sedatives. Remove immediately if you feel discomfort. Consult a healthcare professional before starting any new breathing practice.
          </div>
        </details>
      </div>

    </div>
  </div>
</section>

<script>
  (function () {
    var tiers = document.querySelectorAll('.ns-pdp__tier');
    var variantInput = document.getElementById('ns-variant-input');
    var buyBtn = document.getElementById('ns-buy-now');
    var purchaseOptions = document.querySelectorAll('.ns-pdp__purchase-option');
    var subDesc = document.getElementById('ns-sub-desc');
    var isSubscribe = false;

    function activeTier() { return document.querySelector('.ns-pdp__tier--active'); }

    /* Price for a tier respecting the current purchase type */
    function tierPrice(tier) {
      if (!tier) return '';
      var sub = tier.getAttribute('data-sub-price');
      return (isSubscribe && sub) ? sub : tier.getAttribute('data-variant-price');
    }

    function tierPerNight(tier) {
      if (!tier) return '';
      var sub = tier.getAttribute('data-sub-per-night');
      var one = tier.getAttribute('data-per-night');
      return (isSubscribe && sub) ? sub : (one || '');
    }

    /* Reflect one-time / subscribe pricing across the tier cards + CTA */
    function refresh() {
      tiers.forEach(function (tier) {
        var el = tier.querySelector('.ns-pdp__tier-price');
        if (el) el.textContent = tierPrice(tier);
        var pn = tier.querySelector('.ns-pdp__tier-per-night');
        if (pn) pn.textContent = tierPerNight(tier);
      });
      if (buyBtn) {
        var buyLabel = buyBtn.querySelector('.ns-pdp__btn-buy-label');
        var buyPrice = buyBtn.querySelector('.ns-pdp__btn-buy-price');
        if (buyLabel) buyLabel.textContent = isSubscribe ? 'Subscribe' : 'Buy now';
        if (buyPrice) buyPrice.textContent = tierPrice(activeTier());
      }
      /* Let the floating buy bar mirror the current selection */
      document.dispatchEvent(new CustomEvent('ns:selection'));
    }

    /* ── Tier card selection ── */
    tiers.forEach(function (tier) {
      tier.addEventListener('click', function () {
        tiers.forEach(function (t) { t.classList.remove('ns-pdp__tier--active'); });
        tier.classList.add('ns-pdp__tier--active');
        if (variantInput) variantInput.value = tier.getAttribute('data-variant-id');
        refresh();
      });
    });

    /* ── One-time / Subscribe toggle ── */
    purchaseOptions.forEach(function (option) {
      option.addEventListener('click', function () {
        purchaseOptions.forEach(function (opt) {
          opt.querySelector('.ns-pdp__purchase-radio').classList.remove('ns-pdp__purchase-radio--active');
        });
        option.querySelector('.ns-pdp__purchase-radio').classList.add('ns-pdp__purchase-radio--active');
        isSubscribe = option.getAttribute('data-purchase') === 'subscribe';
        if (subDesc) subDesc.classList.toggle('ns-pdp__sub-desc--visible', isSubscribe);
        refresh();
      });
    });

    /* ── Gallery thumbnails ── */
    var thumbs = document.querySelectorAll('[data-pdp-thumb]');
    var mainImg = document.getElementById('ns-pdp-main-img');
    thumbs.forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        var full = thumb.getAttribute('data-full');
        if (full && mainImg) mainImg.src = full;
        thumbs.forEach(function (t) { t.classList.remove('ns-pdp__thumb--active'); });
        thumb.classList.add('ns-pdp__thumb--active');
      });
    });

    /* Build the add payload — includes the selling plan when subscribing */
    function currentItem() {
      var id = variantInput ? variantInput.value : null;
      if (!id) return null;
      var item = { id: parseInt(id, 10), quantity: 1 };
      var tier = activeTier();
      var plan = tier && tier.getAttribute('data-sub-plan');
      if (isSubscribe && plan) item.selling_plan = parseInt(plan, 10);
      return item;
    }

    /* ── Add to cart — opens the drawer (and fires confetti) via NsCart ── */
    var cartBtn = document.querySelector('[data-add-to-cart]');
    if (cartBtn) {
      cartBtn.addEventListener('click', function () {
        var item = currentItem();
        if (!item) return;
        if (window.NsCart && typeof window.NsCart.add === 'function') {
          window.NsCart.add(item.id, 1, item.selling_plan).catch(function () {});
        } else {
          fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: [item] })
          })
            .then(function () { window.location.href = '/cart'; })
            .catch(function () { window.location.href = '/cart'; });
        }
      });
    }

    /* ── Buy now — checkout with ONLY this item. Clears an existing cart
          first (so nothing already in the cart rides along), then adds this
          selection and goes straight to checkout. ── */
    if (buyBtn) {
      buyBtn.addEventListener('click', function () {
        var item = currentItem();
        if (!item) return;
        buyBtn.disabled = true;

        function fail(err) {
          console.error('[NightSeals] Buy now could not start checkout:', err);
          buyBtn.disabled = false;
        }

        function addAndCheckout() {
          return fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ items: [item] })
          })
            .then(function (res) {
              return res.json().then(function (data) {
                if (!res.ok) { throw new Error((data && (data.description || data.message)) || 'Add to cart failed'); }
                return data;
              });
            })
            .then(function () {
              /* If you land on /cart after this log, /checkout is being
                 redirected by the store (checkout not enabled), not the theme. */
              console.info('[NightSeals] Item in cart — redirecting to /checkout');
              window.location.href = '/checkout';
            });
        }

        /* Only clear when there's actually something to clear */
        fetch('/cart.js', { headers: { 'Accept': 'application/json' } })
          .then(function (r) { return r.json(); })
          .then(function (cart) {
            if (cart && cart.item_count > 0) {
              return fetch('/cart/clear.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
              }).then(function () { return addAndCheckout(); });
            }
            return addAndCheckout();
          })
          .catch(fail);
      });
    }
  })();
</script>

