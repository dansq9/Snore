  "name": "Reviews Carousel",
  "tag": "section",
  "settings": [],
  "blocks": [
    {
      "type": "image_review",
      "name": "Image Review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Review image"
