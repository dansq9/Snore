{%- comment -%}
  ns-lst-herocard — the dark "product card" that opens the listicle, modelled
  on Hostage Tape's hero: a social-proof banner, the product shot with a
  badge, four benefit icons flanking it, and a per-night value line. Neutral,
  non-fabricated social proof (no borrowed endorsements) by default.
{%- endcomment -%}

<section class="ns-lstcard">
  <div class="ns-lstcard__card">
    <div class="ns-lstcard__banner">{{ section.settings.banner | default: 'Loved by thousands of sleepers' }}</div>

    <div class="ns-lstcard__stage">
      <div class="ns-lstcard__col">
        <div class="ns-lstcard__benefit">
          <span class="ns-lstcard__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg></span>
          <span class="ns-lstcard__benefit-label">{{ section.settings.benefit_1 | default: 'Quiet Nights' }}</span>
        </div>
        <div class="ns-lstcard__benefit">
          <span class="ns-lstcard__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></span>
          <span class="ns-lstcard__benefit-label">{{ section.settings.benefit_3 | default: 'All-Day Energy' }}</span>
        </div>
      </div>

      <div class="ns-lstcard__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 700 | image_tag: loading: 'eager', alt: 'NightSeals' }}
        {%- else -%}
          <img src="{{ 'nightseals-pouch-nobg.png' | asset_url }}" alt="NightSeals" width="700" height="700" loading="eager">
        {%- endif -%}
        {%- if section.settings.badge != blank -%}
          <span class="ns-lstcard__badge"><span class="ns-lstcard__badge-check" aria-hidden="true">&#10003;</span>{{ section.settings.badge }}</span>
        {%- endif -%}
      </div>

      <div class="ns-lstcard__col">
        <div class="ns-lstcard__benefit">
          <span class="ns-lstcard__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></span>
          <span class="ns-lstcard__benefit-label">{{ section.settings.benefit_2 | default: 'Wake Up Ready' }}</span>
        </div>
        <div class="ns-lstcard__benefit">
          <span class="ns-lstcard__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></span>
          <span class="ns-lstcard__benefit-label">{{ section.settings.benefit_4 | default: 'Beard-Friendly' }}</span>
        </div>
      </div>
    </div>

    <p class="ns-lstcard__value">{{ section.settings.value_line | default: 'Just $0.50 per night for quieter sleep' }}</p>
  </div>
</section>

<style>
  .ns-lstcard { background: #FFFFFF; padding: clamp(20px,5vw,36px) clamp(16px,5vw,32px); }
  .ns-lstcard__card {
    max-width: 680px;
    margin: 0 auto;
    background: radial-gradient(120% 90% at 50% 0%, #1B2547 0%, #10182B 60%, #0A0F1E 100%);
    border-radius: 24px;
    padding: clamp(18px,4vw,28px) clamp(16px,4vw,28px) clamp(22px,5vw,32px);
    color: #F7F8FA;
    text-align: center;
  }
  .ns-lstcard__banner {
    background: #D9A04B;
    color: #10182B;
    font-weight: 800;
    font-size: clamp(15px,2.6vw,20px);
    letter-spacing: .01em;
    border-radius: 12px;
    padding: 12px 16px;
    margin-bottom: clamp(16px,4vw,24px);
  }
  .ns-lstcard__stage {
    display: grid;
    grid-template-columns: auto minmax(0,1fr) auto;
    align-items: center;
    gap: clamp(6px,2vw,18px);
  }
  .ns-lstcard__col { display: flex; flex-direction: column; gap: clamp(20px,5vw,44px); }
  .ns-lstcard__benefit { display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .ns-lstcard__icon {
    width: clamp(44px,12vw,58px); height: clamp(44px,12vw,58px);
    border-radius: 50%;
    background: rgba(217,160,75,.14);
    color: #E5B267;
    display: flex; align-items: center; justify-content: center;
  }
  .ns-lstcard__icon svg { width: 46%; height: 46%; }
  .ns-lstcard__benefit-label { font-size: clamp(12px,2.4vw,15px); font-weight: 700; line-height: 1.2; }

  .ns-lstcard__media { position: relative; }
  .ns-lstcard__media img { width: 100%; height: auto; display: block; }
  .ns-lstcard__badge {
    position: absolute; top: 4%; right: 0;
    display: inline-flex; align-items: center; gap: 5px;
    background: rgba(10,15,30,.72);
    border: 1px solid rgba(242,244,247,.18);
    border-radius: 999px;
    padding: 6px 12px;
    font-size: clamp(10px,2vw,12px);
    font-weight: 800;
    letter-spacing: .04em;
    text-transform: uppercase;
    backdrop-filter: blur(4px);
  }
  .ns-lstcard__badge-check { color: #E5B267; }

  .ns-lstcard__value {
    margin: clamp(16px,4vw,24px) 0 0;
    font-size: clamp(14px,2.6vw,18px);
    color: rgba(242,244,247,.75);
    font-weight: 500;
  }

  @media (max-width: 520px) {
    .ns-lstcard__stage { gap: 4px; }
    .ns-lstcard__col { gap: 22px; }
  }
</style>

{% schema %}
{
  "name": "Listicle Hero Card",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "banner", "label": "Social-proof banner", "default": "Loved by thousands of sleepers", "info": "Keep this truthful — avoid borrowed endorsements you can't substantiate." },
    { "type": "image_picker", "id": "image", "label": "Product image (transparent background)" },
    { "type": "text", "id": "badge", "label": "Image badge", "default": "Thousands sold", "info": "Small pill on the product shot. Clear to hide." },
    { "type": "text", "id": "benefit_1", "label": "Benefit 1 (top-left)", "default": "Quiet Nights" },
    { "type": "text", "id": "benefit_2", "label": "Benefit 2 (top-right)", "default": "Wake Up Ready" },
    { "type": "text", "id": "benefit_3", "label": "Benefit 3 (bottom-left)", "default": "All-Day Energy" },
    { "type": "text", "id": "benefit_4", "label": "Benefit 4 (bottom-right)", "default": "Beard-Friendly" },
    { "type": "text", "id": "value_line", "label": "Value line", "default": "Just $0.50 per night for quieter sleep" }
  ],
  "presets": [
    { "name": "Listicle Hero Card" }
  ]
}
{% endschema %}
